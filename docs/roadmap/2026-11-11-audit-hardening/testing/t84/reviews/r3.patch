+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\Schema;
+
+// T-84: estado de la exportación completa de datos (ZIP) de cada usuario. `in_progress` vale 1 solo mientras la exportación está en
+// cola o en curso y NULL en el resto de estados: el índice único (user_id, in_progress) garantiza una sola en curso por usuario aunque
+// lleguen dos peticiones a la vez (los NULL no chocan entre sí, en MySQL ni en SQLite). `heartbeat_at` es la marca de vida que escribe el job
+// mientras trabaja: el atasco se mide sobre ella. `include_media` es la elección del usuario (con o sin los ficheros de media).
+return new class extends Migration
+{
+    public function up(): void
+    {
+        Schema::create('full_exports', function (Blueprint $table) {
+            $table->id();
+            $table->foreignId('user_id')->constrained()->cascadeOnDelete();
+            $table->string('status', 16)->default('pending');
+            $table->boolean('in_progress')->nullable();
+            $table->boolean('include_media')->default(true);
+            $table->string('path')->nullable();
+            $table->unsignedBigInteger('size')->nullable();
+            $table->unsignedInteger('file_count')->nullable();
+            $table->string('error', 500)->nullable();
+            $table->timestamp('started_at')->nullable();
+            $table->timestamp('heartbeat_at')->nullable();
+            $table->timestamp('completed_at')->nullable();
+            $table->timestamp('expires_at')->nullable();
+            $table->timestamps();
+
+            $table->unique(['user_id', 'in_progress']);
+            $table->index(['status', 'expires_at']);
+        });
+    }
+
+    public function down(): void
+    {
+        Schema::dropIfExists('full_exports');
+    }
+};
diff --git a/deploy/systemd/scheduler-exports.service b/deploy/systemd/scheduler-exports.service
new file mode 100644
index 0000000..b99ad1f
--- /dev/null
+++ b/deploy/systemd/scheduler-exports.service
@@ -0,0 +1,41 @@
+# Worker de la cola `exports` (exportación completa de datos en ZIP, T-84). Un job puede tardar hasta EXPORTS_TIMEOUT (3600 s).
+# Usa la conexion de cola propia `exports` (config/queue.php, retry_after 3700 s > --timeout): NO hay que tocar DB_QUEUE_RETRY_AFTER, que sigue en 180 s para
+# publish/poll. --timeout (3600) debe ser >= EXPORTS_TIMEOUT del job (ver docs/modulos/despliegue.md).
+# deploy.sh lo reinicia con --no-block: el reinicio espera a que termine la exportacion en curso (TimeoutStopSec) sin bloquear el despliegue.
+# Instalacion igual que scheduler-worker@: copiar, sustituir USUARIO/DOMINIO/PHP_BIN, `systemctl daemon-reload` y `enable --now scheduler-exports`.
+[Unit]
+Description=Social Scheduler exports queue worker
+After=network.target mysql.service mariadb.service
+StartLimitIntervalSec=0
+
+[Service]
+Type=simple
+User=USUARIO
+Group=USUARIO
+WorkingDirectory=/home/USUARIO/web/DOMINIO/app
+Environment=PHP_BIN=php
+# Un solo job a la vez (los ZIP grandes saturan disco y CPU). --tries=1: un fallo deja la exportacion en error y el usuario la repite.
+ExecStart=/usr/bin/env ${PHP_BIN} artisan queue:work exports --queue=exports --sleep=3 --tries=1 --timeout=3600 --max-time=7200 --max-jobs=20
+Restart=always
+RestartSec=5
+# Deja terminar el job en curso: debe ser > --timeout (3600 s).
+TimeoutStopSec=3700
+KillSignal=SIGTERM
+StandardOutput=journal
+StandardError=journal
+SyslogIdentifier=scheduler-exports
+
+NoNewPrivileges=true
+PrivateTmp=true
+ProtectSystem=strict
+ProtectHome=read-only
+# El ZIP se arma en storage/app/exports-tmp y se publica en storage/app/private/full-exports.
+ReadWritePaths=/home/USUARIO/web/DOMINIO/app/storage /home/USUARIO/web/DOMINIO/app/bootstrap/cache
+ProtectKernelTunables=true
+ProtectKernelModules=true
+ProtectControlGroups=true
+RestrictSUIDSGID=true
+LockPersonality=true
+
+[Install]
+WantedBy=multi-user.target
diff --git a/docs/usuario/exportar.md b/docs/usuario/exportar.md
