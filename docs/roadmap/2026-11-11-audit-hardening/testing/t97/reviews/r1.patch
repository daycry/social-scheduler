diff --git a/tests/frontend/theme-contrast.test.mjs b/tests/frontend/theme-contrast.test.mjs
new file mode 100644
index 0000000..9d46dba
--- /dev/null
+++ b/tests/frontend/theme-contrast.test.mjs
@@ -0,0 +1,84 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { test } from 'node:test';
+
+const css = readFileSync(new URL('../../resources/css/app.css', import.meta.url), 'utf8');
+const surfaces = ['canvas', 'surface', 'surface-raised', 'surface-hover', 'accent-soft'];
+const pairs = [
+    ...surfaces.flatMap((background) =>
+        [
+            'foreground',
+            'foreground-strong',
+            'foreground-secondary',
+            'foreground-muted',
+            'foreground-subtle',
+            'accent',
+            'accent-strong',
+            'danger',
+        ].map((foreground) => [foreground, background, 4.5]),
+    ),
+    ...['canvas', 'surface', 'surface-raised', 'surface-hover', 'accent-soft'].flatMap((background) =>
+        ['control-border', 'focus'].map((foreground) => [foreground, background, 3]),
+    ),
+    ...['accent-fill', 'accent-hover', 'accent-active'].map((background) => ['on-accent', background, 4.5]),
+    ...['danger-fill', 'danger-hover', 'danger-active', 'danger-badge'].map((background) => [
+        'on-danger',
+        background,
+        4.5,
+    ]),
+    ...['success', 'danger', 'warning', 'info'].map((status) => [`${status}-ink`, `${status}-soft`, 4.5]),
+    ...['warning-soft', 'info-soft'].map((background) => ['accent', background, 4.5]),
+    ...['canvas', 'surface', 'surface-raised'].flatMap((background) =>
+        ['accent-fill', 'danger-fill', 'check'].map((foreground) => [foreground, background, 3]),
+    ),
+    ['chrome-strong', 'check', 3], // Marca blanca del plugin forms.
+    ['accent-strong', 'accent-marker', 4.5],
+    ...['chrome', 'chrome-panel', 'chrome-hover'].flatMap((background) =>
+        ['chrome-text', 'chrome-muted', 'chrome-strong', 'chrome-accent'].map((foreground) => [
+            foreground,
+            background,
+            4.5,
+        ]),
+    ),
+    ['chrome-border', 'chrome', 3],
+    ['chrome-active', 'chrome-hover', 3],
+    ['chrome-strong', 'chrome-avatar-start', 4.5],
+    ['chrome-strong', 'chrome-avatar-end', 4.5],
+    ['focus', 'chrome', 3],
+    ['focus', 'chrome-panel', 3],
+    ['focus', 'chrome-hover', 3],
+];
+
+function luminance(rgb) {
+    const [red, green, blue] = rgb.map((channel) => {
+        const srgb = channel / 255;
+        return srgb <= 0.04045 ? srgb / 12.92 : ((srgb + 0.055) / 1.055) ** 2.4;
+    });
+    return 0.2126 * red + 0.7152 * green + 0.0722 * blue;
+}
+
+for (const [theme, selector] of [
+    ['light', ':root'],
+    ['dark', ':root.dark'],
+]) {
+    test(`semantic tokens meet WCAG AA in ${theme}`, () => {
+        const block = css.match(new RegExp(`${selector.replace('.', '\\.')}\\s*\\{([^}]+)\\}`));
+        assert.ok(block, `Missing ${selector} theme tokens`);
+        const tokens = Object.fromEntries(
+            [...block[1].matchAll(/--color-([\w-]+):\s*(\d+) (\d+) (\d+);/g)].map(([, name, ...rgb]) => [
+                name,
+                rgb.map(Number),
+            ]),
+        );
+
+        for (const [foreground, background, minimum] of pairs) {
+            assert.ok(tokens[foreground], `Missing --color-${foreground} in ${theme}`);
+            assert.ok(tokens[background], `Missing --color-${background} in ${theme}`);
+            const [darker, lighter] = [luminance(tokens[foreground]), luminance(tokens[background])].sort(
+                (a, b) => a - b,
+            );
+            const ratio = (lighter + 0.05) / (darker + 0.05);
+            assert.ok(ratio >= minimum, `${foreground} / ${background}: ${ratio.toFixed(2)} < ${minimum} in ${theme}`);
+        }
+    });
+}
diff --git a/tests/frontend/use-theme.test.mjs b/tests/frontend/use-theme.test.mjs
new file mode 100644
index 0000000..56ef560
--- /dev/null
+++ b/tests/frontend/use-theme.test.mjs
@@ -0,0 +1,125 @@
+import assert from 'node:assert/strict';
+import { existsSync, readFileSync } from 'node:fs';
+import { test } from 'node:test';
+import { runInNewContext } from 'node:vm';
+import { effectScope, ref } from 'vue';
+
+const moduleUrl = new URL('../../resources/js/Composables/useTheme.js', import.meta.url);
+const blade = readFileSync(new URL('../../resources/views/app.blade.php', import.meta.url), 'utf8');
+
+function browser({ account, stored, dark = false, blocked = false } = {}) {
+    const media = new EventTarget();
+    media.matches = dark;
+    const classes = new Set();
+    const meta = { content: '#0f172a', dataset: { light: '#0f172a', dark: '#0a1020' } };
+    const root = {
+        dataset: account ? { accountTheme: account } : {},
+        style: {},
+        classList: { toggle: (name, enabled) => (enabled ? classes.add(name) : classes.delete(name)) },
+    };
+    let saved = stored;
+    const window = {
+        document: { documentElement: root, querySelector: () => meta },
+        matchMedia(query) {
+            assert.equal(query, '(prefers-color-scheme: dark)');
+            return media;
+        },
+        get localStorage() {
+            if (blocked) throw new Error('Storage denied');
+            return {
+                getItem(key) {
+                    assert.equal(key, 'ss.theme');
+                    return saved;
+                },
+                setItem(key, value) {
+                    assert.equal(key, 'ss.theme');
+                    saved = value;
+                },
+            };
+        },
+    };
+
+    return {
+        window,
+        changeSystem(matches) {
+            media.matches = matches;
+            media.dispatchEvent(new Event('change'));
+        },
+        assertTheme(scheme) {
+            assert.equal(classes.has('dark'), scheme === 'dark');
+            assert.equal(root.style.colorScheme, scheme);
+            assert.equal(meta.content, meta.dataset[scheme]);
+        },
+        saved: () => saved,
+    };
+}
+
+async function startTheme(t, account, client) {
+    assert.ok(existsSync(moduleUrl), 'The application has no theme composable yet');
+    const { useTheme } = await import(moduleUrl);
+    const scope = effectScope();
+    t.after(() => scope.stop());
+    return { theme: scope.run(() => useTheme(() => account.value, client.window)), stop: () => scope.stop() };
+}
+
+test('account selection overrides guest storage and follows system changes only in system mode', async (t) => {
+    const account = ref('system');
+    const client = browser({ stored: 'dark' });
+    const { theme, stop } = await startTheme(t, account, client);
+    client.assertTheme('light');
+    client.changeSystem(true);
+    client.assertTheme('dark');
+    account.value = 'light';
+    client.assertTheme('light');
+    client.changeSystem(false);
+    client.changeSystem(true);
+    client.assertTheme('light');
+    account.value = 'dark';
+    client.changeSystem(false);
+    client.assertTheme('dark');
+    theme.setGuestPreference('light');
+    assert.equal(client.saved(), 'dark');
+    account.value = 'system';
+    client.assertTheme('light');
+    stop();
+    client.changeSystem(true);
+    client.assertTheme('light');
+});
+
+test('guest selection survives navigation and blocked storage keeps the current session usable', async (t) => {
+    const account = ref(null);
+    const available = browser({ stored: 'dark' });
+    const { theme } = await startTheme(t, account, available);
+    available.assertTheme('dark');
+    theme.setGuestPreference('light');
+    available.assertTheme('light');
+    assert.equal(available.saved(), 'light');
+    account.value = 'dark';
+    available.assertTheme('dark');
+    account.value = null;
+    available.assertTheme('light');
+
+    const denied = browser({ blocked: true, dark: true });
+    const { theme: fallback } = await startTheme(t, account, denied);
+    denied.assertTheme('dark');
+    fallback.setGuestPreference('light');
+    denied.assertTheme('light');
+});
+
+test('the nonce-bearing bootstrap applies the first theme before Vite loads', () => {
+    const script = blade.match(/<script nonce="\{\{ Vite::cspNonce\(\) \}\}">([\s\S]+?)<\/script>/);
+    assert.ok(script, 'No synchronous theme is applied in the root Blade template');
+    assert.ok(script.index < blade.indexOf('@vite('));
+    for (const [options, scheme] of [
+        [{ account: 'light', stored: 'dark', dark: true }, 'light'],
+        [{ account: 'dark', blocked: true }, 'dark'],
+        [{ account: 'system', stored: 'dark' }, 'light'],
+        [{ stored: 'dark' }, 'dark'],
+        [{ stored: 'sepia', dark: true }, 'dark'],
+        [{ blocked: true }, 'light'],
+    ]) {
+        const client = browser(options);
+        runInNewContext(script[1], { window: client.window, document: client.window.document });
+        client.assertTheme(scheme);
+    }
+});
