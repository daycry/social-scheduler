# Copia a spike/.env (ignorado por git) y rellena. NUNCA subas credenciales.
# Base HTTPS publica que apunta a este PC (tunel) o al VPS. Sin barra final.
SPIKE_BASE_URL=https://spike.example.com
# Puerto local del servidor de callback: php -S 127.0.0.1:8080 spike/<probe>.php
SPIKE_LOCAL_PORT=8080

# ---- Meta ----
META_APP_ID=
META_APP_SECRET=
# Debe coincidir EXACTO con el URI registrado en Facebook Login > Settings
META_REDIRECT_URI=https://spike.example.com/meta/callback
META_GRAPH_VERSION=v23.0
# URLs publicas HTTPS de media de prueba (jpg, mp4 vertical 9:16)
META_TEST_IMAGE_URL=
META_TEST_VIDEO_URL=

# ---- TikTok ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://spike.example.com/tiktok/callback
# Ruta local de un mp4 (FILE_UPLOAD) y URLs publicas bajo el prefijo verificado (PULL_FROM_URL)
TIKTOK_TEST_VIDEO_FILE=
TIKTOK_TEST_VIDEO_URL=
TIKTOK_TEST_PHOTO_URL=

# ---- YouTube / Google ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://spike.example.com/google/callback
# Rutas locales de un mp4 de prueba y de un short vertical <= 3 min
YOUTUBE_TEST_VIDEO_FILE=
YOUTUBE_TEST_SHORT_FILE=
