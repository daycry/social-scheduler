index 0000000..5a3a7df
--- /dev/null
+++ b/resources/js/Components/CommandPalette.vue
@@ -0,0 +1,274 @@
+<script setup>
+import BaseDialog from '@/Components/BaseDialog.vue';
+import Icon from '@/Components/Icon.vue';
+import InfoNote from '@/Components/InfoNote.vue';
+import NetworkIcon from '@/Components/NetworkIcon.vue';
+import {
+    MIN_LENGTH,
+    PAGE_LIMIT,
+    createRemoteSearch,
+    fetchResults,
+    filterPages,
+    groupEntries,
+    isPaletteShortcut,
+    nextIndex,
+    pageCommands,
+} from '@/lib/commandPalette';
+import { router } from '@inertiajs/vue3';
+import { computed, nextTick, onBeforeUnmount, onMounted, ref, watch } from 'vue';
+
+/**
+ * Paleta de comandos (T-85, F-11): botón de la cabecera + diálogo común (`BaseDialog`: foco atrapado, Esc cierra y el foco vuelve a quien la
+ * abrió) con el patrón combobox/listbox de ARIA. Las páginas y acciones salen de `navigation.js` (el mismo menú, con sus permisos y condiciones)
+ * y se filtran al instante; el contenido del usuario llega del servidor (`search`) con debounce y cancelación, ya acotado a lo que puede ver.
+ * Todo se pinta como texto con `{{ }}`: nada de HTML del servidor.
+ *
+ * Atajo: Ctrl+K (Cmd+K en macOS) en cualquier pantalla. Ningún editor de la app usa esa combinación (el estudio usa Z, S, A, C, V y D;
+ * el compositor es un `textarea` normal), así que no se pisa nada; cede si otro diálogo modal ya está abierto o si quien lo gestiona
+ * antes ya ha hecho `preventDefault`.
+ */
+const props = defineProps({
+    context: { type: /** @type {import('vue').PropType<import('@/navigation').NavigationContext>} */ (Object), required: true },
+});
+
+const LISTBOX_ID = 'command-palette-listbox';
+const optionId = (/** @type {number} */ index) => `command-palette-option-${index}`;
+
+const open = ref(false);
+const query = ref('');
+const active = ref(0);
+const mac = ref(false);
+const trigger = ref(/** @type {HTMLButtonElement | null} */ (null));
+const returnTo = ref(/** @type {HTMLButtonElement | null} */ (null));
+const remote = ref(/** @type {import('@/lib/commandPalette').RemoteState} */ ({ status: 'idle', query: '', results: [], error: '' }));
+
+const search = createRemoteSearch({ request: fetchResults, onChange: (state) => (remote.value = state) });
+const pages = computed(() => (open.value ? pageCommands(props.context) : []));
+const groups = computed(() => groupEntries(filterPages(pages.value, query.value, PAGE_LIMIT), remote.value.results));
+const flat = computed(() => groups.value.flatMap((group) => group.entries));
+const typed = computed(() => query.value.trim().length);
+const shortcut = computed(() => (mac.value ? '⌘K' : 'Ctrl K'));
+
+/** Mensaje para el lector de pantalla (región `aria-live` educada); lo visible va aparte, en la propia lista. */
+const announcement = computed(() => {
+    const { status, error } = remote.value;
+    if (status === 'error') return error;
+    if (status === 'loading') return 'Buscando…';
+    if (status === 'ready') return flat.value.length ? `${flat.value.length} resultados.` : `Sin resultados para «${remote.value.query}».`;
+    return typed.value > 0 && typed.value < MIN_LENGTH ? `Escribe al menos ${MIN_LENGTH} caracteres para buscar en tu contenido.` : '';
+});
+
+watch(query, (text) => search.update(text));
+watch(
+    () => flat.value.map((entry) => entry.key).join('|'),
+    () => (active.value = 0),
+);
+watch(active, async (index) => {
+    await nextTick();
+    document.getElementById(optionId(index))?.scrollIntoView({ block: 'nearest' });
+});
+
+/** @param {HTMLButtonElement | null} from botón que la abre (para devolverle el foco); sin él, el foco vuelve a donde estaba */
+function openPalette(from) {
+    returnTo.value = from;
+    open.value = true;
+}
+
+function close() {
+    open.value = false;
+    query.value = '';
+}
+
+/** @param {import('@/lib/commandPalette').PaletteEntry} entry */
+function choose(entry) {
+    close();
+    if (entry.external) window.open(entry.url, '_blank', 'noopener');
+    else router.visit(entry.url);
+}
+
+/** @param {KeyboardEvent} event */
+function onInputKeydown(event) {
+    if (event.isComposing) return;
+    if (event.key === 'Enter') {
+        const entry = flat.value[active.value];
+        if (entry) {
+            event.preventDefault();
+            choose(entry);
+        }
+        return;
+    }
+    const next = nextIndex(active.value, event.key, flat.value.length);
+    if (next >= 0) {
+        event.preventDefault();
+        active.value = next;
+    }
+}
+
+/** @param {KeyboardEvent} event */
+function onShortcut(event) {
+    if (!isPaletteShortcut(event, mac.value)) return;
+    if (open.value) return event.preventDefault();
+    if (document.querySelector('dialog[open]')) return;
+    event.preventDefault();
+    openPalette(null);
+}
+
+onMounted(() => {
+    mac.value = /Mac|iPhone|iPad/.test(navigator.platform);
+    window.addEventListener('keydown', onShortcut);
+});
+onBeforeUnmount(() => {
+    window.removeEventListener('keydown', onShortcut);
+    search.close();
+});
+</script>
+
+<template>
+    <button
+        ref="trigger"
+        type="button"
+        class="flex shrink-0 items-center gap-2 rounded-lg p-2 text-slate-300 hover:bg-white/10 hover:text-white sm:border sm:border-white/15 sm:bg-white/5 sm:px-2.5 sm:py-1.5"
+        aria-label="Buscar en la aplicación"
+        aria-haspopup="dialog"
+        aria-keyshortcuts="Control+K Meta+K"
+        data-testid="command-palette-trigger"
+        @click="openPalette(trigger)"
+    >
+        <Icon name="search" class="h-5 w-5" />
+        <span class="hidden text-sm sm:inline">Buscar</span>
+        <kbd
+            class="hidden rounded border border-white/20 px-1.5 text-[11px] text-slate-300 lg:inline"
+            aria-hidden="true"
+            >{{
+            shortcut
+            }}</kbd
+        >
+    </button>
+
+    <BaseDialog
+        v-if="open"
+        open
+        close-on-backdrop
+        :return-focus-to="returnTo"
+        class="dialog-panel max-w-2xl max-sm:my-0 max-sm:h-dvh max-sm:max-h-none max-sm:w-screen max-sm:max-w-none max-sm:rounded-none sm:mt-20"
+        aria-labelledby="command-palette-title"
+        @close="close"
+    >
+        <div class="flex h-full min-w-0 flex-col" data-testid="command-palette">
+            <h2 id="command-palette-title" class="sr-only">Buscar</h2>
+            <div class="flex items-center gap-2 border-b border-slate-200 px-3 py-2">
+                <Icon name="search" class="h-5 w-5 shrink-0 text-slate-500" />
+                <label for="command-palette-input" class="sr-only"
+                    >Buscar páginas, publicaciones, marcas, archivos y más</label
+                >
+                <input
+                    id="command-palette-input"
+                    v-model="query"
+                    data-dialog-initial-focus
+                    type="text"
+                    role="combobox"
+                    aria-autocomplete="list"
+                    aria-haspopup="listbox"
+                    :aria-expanded="flat.length > 0"
+                    :aria-controls="flat.length > 0 ? LISTBOX_ID : undefined"
+                    :aria-activedescendant="flat.length > 0 ? optionId(active) : undefined"
+                    aria-describedby="command-palette-hint"
+                    :maxlength="100"
+                    autocomplete="off"
+                    autocapitalize="off"
+                    spellcheck="false"
+                    enterkeyhint="go"
+                    placeholder="Buscar…"
+                    class="min-h-11 min-w-0 flex-1 rounded-md border-0 bg-transparent px-1 text-base text-slate-900 placeholder:text-slate-500 focus:ring-2 focus:ring-inset focus:ring-indigo-500 focus:ring-offset-0 sm:text-sm"
+                    data-testid="command-palette-input"
+                    @keydown="onInputKeydown"
+                />
+                <button
+                    type="button"
+                    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100"
+                    aria-label="Cerrar la búsqueda"
+                    data-testid="command-palette-close"
+                    @click="close"
+                >
+                    <Icon name="x" class="h-5 w-5" />
+                </button>
+            </div>
+
+            <p id="command-palette-hint" class="px-4 pt-2 text-xs text-slate-600">
+                Las páginas se filtran al momento; publicaciones, marcas, archivos y diseños se buscan desde
+                {{ MIN_LENGTH }} letras.
+            </p>
+
+            <div class="min-h-0 flex-1 overflow-y-auto pb-2 sm:max-h-[min(26rem,60dvh)]">
+                <div v-if="flat.length > 0" :id="LISTBOX_ID" role="listbox" aria-label="Resultados">
+                    <div
+                        v-for="group in groups"
+                        :key="group.type"
+                        role="group"
+                        :aria-labelledby="`command-palette-group-${group.type}`"
+                    >
+                        <div
+                            :id="`command-palette-group-${group.type}`"
+                            role="presentation"
+                            class="px-4 pb-1 pt-3 text-xs font-semibold uppercase tracking-wide text-slate-500"
+                            >{{ group.label }}</div
+                        >
+                        <div
+                            v-for="entry in group.entries"
+                            :id="optionId(entry.index)"
+                            :key="entry.key"
+                            role="option"
+                            :aria-selected="entry.index === active"
+                            class="flex min-h-11 cursor-pointer items-center gap-3 border-s-2 px-4 py-2"
+                            :class="entry.index === active ? 'border-indigo-600 bg-indigo-50' : 'border-transparent'"
+                            data-testid="command-palette-option"
+                            @click="choose(entry)"
+                            @mousemove="active = entry.index"
+                        >
+                            <NetworkIcon v-if="entry.network !== undefined" :network="entry.network" size="sm" />
+                            <Icon v-else :name="entry.icon ?? 'grid'" class="h-5 w-5 shrink-0 text-slate-500" />
+                            <span class="min-w-0 flex-1">
+                                <span class="block truncate text-sm font-medium text-slate-900">{{ entry.title }}</span>
+                                <span v-if="entry.meta" class="block truncate text-xs text-slate-600">{{
+                                    entry.meta
+                                }}</span>
+                            </span>
+                            <span v-if="entry.external" class="sr-only">(se abre en otra pestaña)</span>
+                        </div>
+                    </div>
+                </div>
+
+                <p
+                    v-if="remote.status === 'loading'"
+                    class="px-4 py-3 text-sm text-slate-600"
+                    data-testid="command-palette-loading"
+                    >Buscando en tu contenido…</p
+                >
+                <div v-else-if="remote.status === 'error'" class="px-4 pt-3" data-testid="command-palette-error">
+                    <InfoNote>{{ remote.error }}</InfoNote>
+                </div>
+                <div
+                    v-else-if="remote.status === 'ready' && remote.results.length === 0"
+                    class="px-4 pt-3"
+                    data-testid="command-palette-empty"
+                >
+                    <InfoNote
+                        >No hay publicaciones, marcas, archivos ni diseños tuyos que coincidan con «{{ remote.query
+                        }}».</InfoNote
+                    >
+                </div>
+            </div>
+
+            <p
+                aria-live="polite"
+                role="status"
+                class="sr-only"
+                data-testid="command-palette-status"
+                >{{ announcement }}</p
+            >
+            <p class="hidden border-t border-slate-200 px-4 py-2 text-xs text-slate-600 sm:block">
+                ↑ ↓ para moverte · Intro para abrir · Esc para cerrar
+            </p>
+        </div>
+    </BaseDialog>
+</template>
diff --git a/resources/js/lib/commandPalette.js b/resources/js/lib/commandPalette.js
new file mode 100644
index 0000000..cfda426
--- /dev/null
+++ b/resources/js/lib/commandPalette.js
@@ -0,0 +1,258 @@
+import { ACCOUNT_MODULE, sideItems, visibleModules } from '../navigation.js';
+import { HttpError, requestJson } from './http.js';
+
+/**
+ * Lógica pura de la paleta de comandos (T-85): páginas y acciones sacadas de `navigation.js` (la fuente única del menú), filtrado sin tildes,
+ * agrupación, movimiento por teclado y la búsqueda remota con debounce que descarta las respuestas fuera de orden.
+ */
+
+/**
+ * @typedef {import('../navigation.js').NavigationContext} NavigationContext
+ * @typedef {{type: string, id: number, title: string, brand: string | null, date: string | null, status: string | null, url: string, external: boolean}} SearchResult
+ * @typedef {{key: string, type: string, title: string, meta: string, url: string, external: boolean, icon?: string, network?: string}} PaletteEntry
+ * @typedef {PaletteEntry & {index: number}} IndexedEntry
+ * @typedef {{type: string, label: string, entries: IndexedEntry[]}} PaletteGroup
+ * @typedef {{status: 'idle' | 'loading' | 'ready' | 'error', query: string, results: SearchResult[], error: string}} RemoteState
+ */
+
+export const MIN_LENGTH = 2;
+export const MAX_LENGTH = 100;
+export const DEBOUNCE_MS = 250;
+export const PAGE_LIMIT = 8;
+
+const PAGE_TYPE = 'page';
+
+/** Encabezado de cada grupo, en el orden en que se muestran. */
+export const GROUP_LABELS = /** @type {const} */ ({
+    page: 'Páginas y acciones',
+    post: 'Publicaciones',
+    brand: 'Marcas',
+    design: 'Diseños',
+    media: 'Archivos',
+    campaign: 'Campañas',
+    template: 'Plantillas',
+    site: 'Sitios',
+    smartlink: 'Smart links',
+});
+
+/** Icono de cada tipo de resultado del servidor. */
+export const TYPE_ICONS = /** @type {Record<string, string>} */ ({
+    post: 'doc',
+    brand: 'tag',
+    design: 'palette',
+    media: 'folder',
+    campaign: 'megaphone',
+    template: 'bookmark',
+    site: 'grid',
+    smartlink: 'link',
+});
+
+/** Minúsculas y sin tildes, para comparar «Campañas» con «campanas». @param {string} text */
+export function fold(text) {
+    return text.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();
+}
+
+/**
+ * Páginas y acciones de la app tal y como las muestra el menú: mismas condiciones (`when`), mismos permisos y mismos enlaces, porque se
+ * resuelven con `sideItems` de `navigation.js`. Sin entradas repetidas (varias secciones enlazan la misma pantalla con el mismo nombre).
+ * @param {NavigationContext} context
+ * @returns {PaletteEntry[]}
+ */
+export function pageCommands(context) {
+    /** @type {Map<string, PaletteEntry>} */
+    const entries = new Map();
+    for (const module of [...visibleModules(context), ACCOUNT_MODULE]) {
+        for (const item of sideItems(module, context)) {
+            const key = `${module.key}:${item.key}`;
+            const url = item.href;
+            if (entries.has(`${url}|${item.label}`)) continue;
+            entries.set(`${url}|${item.label}`, {
+                key: `page-${key}`,
+                type: PAGE_TYPE,
+                title: item.label,
+                meta: module.label,
+                url,
+                external: false,
+                ...(item.network !== undefined ? { network: item.network } : { icon: item.icon }),
+            });
+        }
+    }
+    return [...entries.values()];
+}
+
+/**
+ * Filtra las páginas por todas las palabras de la consulta (sin tildes ni mayúsculas); primero las que empiezan por ella y luego las que la
+ * contienen en el título. Sin consulta devuelve las primeras.
+ * @param {PaletteEntry[]} pages
+ * @param {string} query
+ * @param {number} [limit]
+ */
+export function filterPages(pages, query, limit = PAGE_LIMIT) {
+    const words = fold(query).split(/\s+/).filter(Boolean);
+    if (words.length === 0) return pages.slice(0, limit);
+    return pages
+        .map((page, order) => {
+            const title = fold(page.title);
+            const haystack = `${title} ${fold(page.meta)}`;
+            const rank = title.startsWith(words[0]) ? 0 : title.includes(words[0]) ? 1 : 2;
+            return { page, order, rank, match: words.every((word) => haystack.includes(word)) };
+        })
+        .filter((candidate) => candidate.match)
+        .sort((a, b) => a.rank - b.rank || a.order - b.order)
+        .slice(0, limit)
+        .map((candidate) => candidate.page);
+}
+
+/**
+ * Fecha local de la marca (`2026-11-19 20:30` o `2026-11-19`) en texto legible. El servidor ya la dio en la zona de la marca: aquí no se
+ * convierte nada, solo se escribe.
+ * @param {string | null} value
+ */
+export function formatLocalDate(value) {
+    const match = /^(\d{4})-(\d{2})-(\d{2})(?: (\d{2}):(\d{2}))?$/.exec(value ?? '');
+    if (!match) return '';
+    const [, year, month, day, hours, minutes] = match;
+    const date = new Date(Number(year), Number(month) - 1, Number(day), Number(hours ?? 0), Number(minutes ?? 0));
+    return new Intl.DateTimeFormat('es', { dateStyle: 'medium', ...(hours === undefined ? {} : { timeStyle: 'short' }) }).format(date);
+}
+
+/**
+ * @param {SearchResult} result
+ * @returns {PaletteEntry}
+ */
+export function resultEntry(result) {
+    return {
+        key: `${result.type}-${result.id}`,
+        type: result.type,
+        title: result.title,
+        meta: [result.brand, formatLocalDate(result.date), result.status].filter(Boolean).join(' · '),
+        url: result.url,
+        external: result.external,
+        icon: TYPE_ICONS[result.type] ?? 'grid',
+    };
+}
+
+/**
+ * Páginas primero y luego el contenido del usuario, agrupado por tipo en el orden de `GROUP_LABELS`, con un índice continuo para el teclado.
+ * @param {PaletteEntry[]} pages
+ * @param {SearchResult[]} results
+ * @returns {PaletteGroup[]}
+ */
+export function groupEntries(pages, results) {
+    const entries = [...pages, ...results.map(resultEntry)];
+    let index = 0;
+    return Object.entries(GROUP_LABELS)
+        .map(([type, label]) => ({
+            type,
+            label,
+            entries: entries.filter((entry) => entry.type === type).map((entry) => ({ ...entry, index: index++ })),
+        }))
+        .filter((group) => group.entries.length > 0);
+}
+
+/**
+ * Opción activa tras una tecla de navegación (con vuelta al otro extremo en las flechas). `-1` si la tecla no mueve nada.
+ * @param {number} current
+ * @param {string} key
+ * @param {number} count
+ */
+export function nextIndex(current, key, count) {
+    if (count === 0) return -1;
+    if (key === 'ArrowDown') return (current + 1) % count;
+    if (key === 'ArrowUp') return (current - 1 + count) % count;
+    if (key === 'Home') return 0;
+    if (key === 'End') return count - 1;
+    return -1;
+}
+
+/**
+ * ¿Es la combinación de la paleta? Ctrl+K, o Cmd+K en macOS (allí Ctrl+K es «borrar hasta el final de la línea» en los campos de texto).
+ * @param {Pick<KeyboardEvent, 'key' | 'ctrlKey' | 'metaKey' | 'altKey' | 'shiftKey' | 'repeat' | 'isComposing' | 'defaultPrevented'>} event
+ * @param {boolean} mac
+ */
+export function isPaletteShortcut(event, mac) {
+    if (event.defaultPrevented || event.repeat || event.isComposing || event.altKey || event.shiftKey) return false;
+    return (mac ? event.metaKey && !event.ctrlKey : event.ctrlKey && !event.metaKey) && event.key.toLowerCase() === 'k';
+}
+
+/** @param {unknown} error */
+function searchErrorMessage(error) {
+    if (error instanceof HttpError && error.status === 429) return 'Demasiadas búsquedas seguidas. Espera un momento.';
+    return 'No se pudo buscar. Inténtalo de nuevo.';
+}
+
+/**
+ * Petición real al servidor.
+ * @param {string} query
+ * @param {AbortSignal} signal
+ * @returns {Promise<SearchResult[]>}
+ */
+export async function fetchResults(query, signal) {
+    const data = /** @type {{results: SearchResult[]}} */ (await requestJson('GET', route('search', { q: query }, false), { signal }));
+    return data.results;
+}
+
+/**
+ * Búsqueda remota con debounce. Cada cambio de texto cancela el temporizador y la petición anterior (AbortController) y avanza una secuencia:
+ * una respuesta que llega tras otra más reciente (o tras cerrar) se descarta aunque el transporte no respete la cancelación.
+ * @param {{request: (query: string, signal: AbortSignal) => Promise<SearchResult[]>, onChange: (state: RemoteState) => void, delay?: number, setTimer?: typeof setTimeout, clearTimer?: typeof clearTimeout}} options
+ */
+export function createRemoteSearch({ request, onChange, delay = DEBOUNCE_MS, setTimer = setTimeout, clearTimer = clearTimeout }) {
+    /** @type {ReturnType<typeof setTimeout> | null} */
+    let timer = null;
+    /** @type {AbortController | null} */
+    let controller = null;
+    let sequence = 0;
+    /** @type {RemoteState} */
+    const state = { status: 'idle', query: '', results: [], error: '' };
+
+    /** @param {Partial<RemoteState>} patch */
+    const publish = (patch) => {
+        Object.assign(state, patch);
+        onChange({ ...state });
+    };
+    const cancel = () => {
+        if (timer !== null) clearTimer(timer);
+        timer = null;
+        controller?.abort();
+        controller = null;
+    };
+
+    /** @param {string} query @param {number} id */
+    async function run(query, id) {
+        const mine = new AbortController();
+        controller = mine;
+        try {
+            const results = await request(query, mine.signal);
+            if (id === sequence) publish({ status: 'ready', results });
+        } catch (error) {
+            if (id === sequence && !mine.signal.aborted) publish({ status: 'error', results: [], error: searchErrorMessage(error) });
+        } finally {
+            if (controller === mine) controller = null;
+        }
+    }
+
+    return {
+        /** @param {string} text */
+        update(text) {
+            const query = text.trim().slice(0, MAX_LENGTH);
+            sequence++;
+            cancel();
+            if (query.length < MIN_LENGTH) {
+                publish({ status: 'idle', query, results: [], error: '' });
+                return;
+            }
+            publish({ status: 'loading', query, results: [], error: '' });
+            const id = sequence;
+            timer = setTimer(() => {
+                timer = null;
+                run(query, id);
+            }, delay);
+        },
+        close() {
+            sequence++;
+            cancel();
+            publish({ status: 'idle', query: '', results: [], error: '' });
+        },
+    };
+}
