APP_NAME="Social Scheduler"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CAMBIAR-DOMINIO

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# MariaDB >= 10.6 / MySQL >= 8.0 (SKIP LOCKED para la cola database)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CAMBIAR_usuario_scheduler
DB_USERNAME=CAMBIAR_usuario_scheduler
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_NAMES=publish,poll,metrics,reports

# Correo (decision abierta: SMTP de Hestia o proveedor transaccional)
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@CAMBIAR-DOMINIO"
MAIL_FROM_NAME="${APP_NAME}"

# Media en Cloudflare R2
MEDIA_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://CAMBIAR-ACCOUNT-ID.r2.cloudflarestorage.com
R2_URL=https://media.CAMBIAR-DOMINIO
R2_REGION=auto

# Healthcheck externo: token requerido en /health (cabecera X-Health-Token)
HEALTHCHECK_TOKEN=

# OAuth por red (Fase 2)
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
