APP_NAME="Social Scheduler"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://metricool.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=metricool
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Almacenamiento de media (Cloudflare R2, API compatible S3) ---
# En local/test se usa el disco "local"; en produccion MEDIA_DISK=r2
MEDIA_DISK=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_REGION=auto
R2_CONNECT_TIMEOUT=3
# Limite total por peticion al disco (amplio: transfiere videos/informes); la sonda del healthcheck usa R2_HEALTH_TIMEOUT
R2_TIMEOUT=600
R2_HEALTH_TIMEOUT=5

# --- Colas (database): publish,poll,metrics,reports ---
QUEUE_NAMES=publish,poll,metrics,reports

# --- Healthcheck externo (token opcional para /health) ---
HEALTHCHECK_TOKEN=

# --- OAuth por red (Fase 2) ---
# Redirect URIs a registrar en cada app (APP_URL debe ser HTTPS en produccion):
#   Meta   (Facebook Login for Business -> URIs de redireccion): ${APP_URL}/connections/meta/callback
#   Google (cliente web -> URIs de redireccion autorizados):    ${APP_URL}/connections/google/callback
#   TikTok (Login Kit -> Redirect URI):                          ${APP_URL}/connections/tiktok/callback
# Meta: cada permiso debe estar activado dentro del caso de uso de la app; dominio en "Dominios de la app".
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Permisos opcionales de Meta, separados por comas, SOLO tras activarlos en los casos de uso de la app y antes de
# reconectar (si no, Meta rechaza todo el login): pages_read_user_content (comentarios de FB en el Inbox), ads_read (Meta Ads)
META_EXTRA_SCOPES=
# Google: consentimiento "En produccion" (sin verificar) para que el refresh token no caduque a los 7 dias.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok foto/carrusel (PULL_FROM_URL): dominio VERIFICADO en TikTok que sirve la media. Vacio = el tipo no se ofrece.
# ATENCION: TikTok descarga la URL tal cual (sin firma), asi que el dominio debe ser el dominio PUBLICO del bucket (R2_URL)
# y TODA la media del bucket queda accesible por URL (claves ULID impredecibles, no listables). Mitigacion recomendada:
# un bucket/dominio publico SEPARADO solo para TikTok (o una regla WAF/Transform que limite el dominio a un prefijo) y
# una regla de ciclo de vida que borre ese prefijo a las 24 h. Ver deploy/hestia/README.md (seccion TikTok).
TIKTOK_VERIFIED_DOMAIN=
# YouTube: cupo diario de la API (por proyecto de Google) y coste por subida. Politica al agotarse: PUBLISH_QUOTA_POLICY.
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_UPLOAD_COST=1600
# Pasada de subida (el job dura 110 s): presupuesto blando, trozo minimo y marca dura. Plazo de la subida vs. el procesado.
YOUTUBE_UPLOAD_BUDGET=80
YOUTUBE_PASS_SECONDS=100
PUBLISH_UPLOAD_MAX_MINUTES=240
TIKTOK_UPLOAD_BUDGET=80
TIKTOK_PASS_SECONDS=100
# La upload_url de TikTok vale 1 h: minutos (con margen) tras los que se reinicia la subida (init nuevo), reinicios maximos y
# plazo de la fase de subida de TikTok (sustituye a PUBLISH_UPLOAD_MAX_MINUTES para esta red).
TIKTOK_UPLOAD_URL_TTL=55
TIKTOK_UPLOAD_RESTARTS=1
TIKTOK_UPLOAD_MAX_MINUTES=120
# YouTube idempotencia: paginas (50 videos) de subidas recientes que se recorren; cada pagina cuesta 2 uds de cuota.
YOUTUBE_LOOKUP_MAX_PAGES=3
# Borrador de TikTok sin confirmar tras la subida: minutos hasta darlo por enviado a la bandeja (con nota «revisa tus borradores»;
# no se sigue sondeando despues: ver TikTokPublisher).
TIKTOK_INBOX_GRACE_MINUTES=10

# --- Refresco de tokens (horas de antelacion y cola) ---
SOCIAL_REFRESH_MARGIN_META_HOURS=168
SOCIAL_REFRESH_MARGIN_GOOGLE_HOURS=1
SOCIAL_REFRESH_MARGIN_TIKTOK_HOURS=6
SOCIAL_REFRESH_QUEUE=poll
SOCIAL_HTTP_TIMEOUT=15
SOCIAL_REFRESH_MAX_TRANSIENT_FAILURES=12
META_MAX_PAGES=10

# Proxies de confianza: '*' o lista de IPs/CIDR separada por comas.
# - Hestia (Nginx + PHP-FPM directo, sin proxy HTTP delante): DEJAR VACIO. Con '*' cualquier cliente
#   podria falsear X-Forwarded-Host (se mitiga ademas con trustHosts sobre APP_URL).
# - Desarrollo tras ngrok: TRUSTED_PROXIES=* y APP_URL=https://<dominio-ngrok> (si no, route() genera
#   http:// y el redirect_uri de OAuth no coincide con el registrado).
TRUSTED_PROXIES=

# Informes PDF/CSV (Fase 8): DomPDF por defecto; color/logo/pie de la portada.
REPORTS_PDF_DRIVER=dompdf
REPORTS_BRAND_COLOR=#4f46e5
REPORTS_LOGO_PATH=
REPORTS_FOOTER=
REPORTS_CSV_LOCALE=es

# Email de contacto de /privacy y /terms (exigidas por Google y TikTok)
LEGAL_CONTACT_EMAIL=

# Usuario demo local (php artisan db:seed --class=DemoSeeder); nunca en produccion
DEMO_USER_EMAIL=demo@social-scheduler.test
DEMO_USER_PASSWORD=

# Fase P3 (paridad con Metricool). Los permisos instagram_manage_comments, pages_read_user_content, pages_manage_engagement
# y ads_read hay que activarlos en los casos de uso de la app de Meta y reconectar las cuentas.
SOCIAL_AUTOLISTS_DAILY_AT=02:00
SOCIAL_AUTOLISTS_HORIZON_DAYS=7
SOCIAL_INBOX_SYNC_MINUTES=15
# Asistente IA opcional (desactivado por defecto): ambos valores son necesarios para mostrar el boton Sugerir texto.
AI_ASSISTANT_ENABLED=false
ANTHROPIC_API_KEY=
AI_ASSISTANT_DAILY_LIMIT=20
SOCIAL_AUTOLISTS_QUEUE=poll
SOCIAL_INBOX_POST_DAYS=30
SOCIAL_INBOX_MAX_POSTS=25
SOCIAL_INBOX_COMMENTS_PER_POST=50
# Paginas de Graph que se siguen por publicacion / por hilo de respuestas, y presupuesto (s) por pasada del job del Inbox.
SOCIAL_INBOX_MAX_PAGES=5
SOCIAL_INBOX_MAX_REPLY_PAGES=3
SOCIAL_INBOX_BUDGET_SECONDS=60
SOCIAL_BEST_TIMES_DAYS=90
SOCIAL_BEST_TIMES_MIN_POSTS=10
SOCIAL_BEST_TIMES_CACHE_MINUTES=10
SOCIAL_COMPETITORS_DAILY_AT=13:00
SOCIAL_COMPETITORS_MAX=10
SOCIAL_ADS_CACHE_MINUTES=10
# Tope diario GLOBAL (todos los usuarios) del asistente IA; 0 = sin tope.
AI_ASSISTANT_GLOBAL_DAILY_LIMIT=200
# Contacto de las denuncias de las paginas publicas de SmartLinks (por defecto, MAIL_FROM_ADDRESS).
SMARTLINKS_REPORT_EMAIL=
# Registro publico de cuentas. true en local; en produccion de uso personal, false (las cuentas se crean por consola).
REGISTRATION_ENABLED=true

# --- Passkeys (WebAuthn) ---
# Las passkeys se atan al dominio: WEBAUTHN_RP_ID es el host de la app SIN esquema ni puerto y debe ser estable
# (si cambia, todas las passkeys registradas dejan de valer y hay que crearlas de nuevo). Por defecto sale del host de APP_URL.
#   Laragon: metricool.test (requiere HTTPS de confianza) · ngrok: el host de ngrok (cambia al rotar) · E2E: localhost
WEBAUTHN_RP_ID=
# Origenes completos (esquema + host + puerto) separados por comas. Por defecto, APP_URL. E2E: http://localhost:8080
WEBAUTHN_ORIGINS=
# Secreto del que sale el identificador (handle) de usuario de las passkeys NUEVAS (generar con: php -r "echo bin2hex(random_bytes(32));").
# Explicito en produccion (si esta vacio cae en APP_KEY y la app avisa en el log y en `php artisan about`). Rotarlo NO invalida las passkeys ya registradas (el handle se guarda en su registro); solo cambia el de las nuevas.
PASSKEYS_USER_HANDLE_SECRET=

# --- OAuth 2.1 del servidor MCP (clientes MCP se autorizan por navegador, sin API key) ---
# Vida del token emitido por OAuth, en dias (30 por defecto; se topa en MCP_KEY_MAX_DAYS).
MCP_OAUTH_TOKEN_DAYS=30
# Vida del codigo de autorizacion, en segundos.
MCP_OAUTH_CODE_TTL=300
# Prefijos https:// adicionales permitidos como redirect_uri al registrar clientes (CSV). Loopback (localhost, 127.0.0.1, [::1])
# y los callbacks de Claude ya estan permitidos. Ej.: https://cliente.example/oauth/callback
MCP_OAUTH_REDIRECT_ALLOWED=

# --- Login social (Google y Facebook; solo cuentas existentes) ---
# Credenciales PROPIAS del login, distintas de las de los conectores de redes (GOOGLE_CLIENT_*, META_APP_*). Vacias = proveedor desactivado.
# Redirect URIs a registrar: ${APP_URL}/auth/google/callback y ${APP_URL}/auth/facebook/callback
#   Google: proyecto de Google Cloud dedicado, cliente web, scopes openid email profile.
#   Meta:   app de consumidor con el caso de uso "Facebook Login" (permisos email y public_profile). Usa META_GRAPH_VERSION.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
META_LOGIN_APP_ID=
META_LOGIN_APP_SECRET=
