diff --git a/tests/frontend/push-client.test.mjs b/tests/frontend/push-client.test.mjs
new file mode 100644
index 0000000..f46fc25
--- /dev/null
+++ b/tests/frontend/push-client.test.mjs
@@ -0,0 +1,94 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+import test from 'node:test';
+
+function client(permission = 'granted', existing = null) {
+    const calls = [];
+    const subscription = {
+        toJSON: () => ({ endpoint: 'https://push.example.test/device', keys: { p256dh: 'public', auth: 'auth' } }),
+    };
+    const registration = {
+        pushManager: {
+            getSubscription: async () => {
+                calls.push(['get']);
+                return existing;
+            },
+            subscribe: async (options) => {
+                calls.push(['subscribe', options]);
+                return subscription;
+            },
+        },
+    };
+    const sandbox = {
+        window: { isSecureContext: true, PushManager: function () {} },
+        navigator: {
+            serviceWorker: {
+                register: async (...args) => {
+                    calls.push(['register', ...args]);
+                    return registration;
+                },
+                ready: Promise.resolve(registration),
+            },
+        },
+        Notification: {
+            requestPermission: () => {
+                calls.push(['permission']);
+                return Promise.resolve(permission);
+            },
+        },
+        Uint8Array,
+        atob: (value) => Buffer.from(value, 'base64').toString('binary'),
+    };
+    const source = fs
+        .readFileSync(new URL('../../resources/js/lib/push.js', import.meta.url), 'utf8')
+        .replace(/^export /gm, '');
+    vm.runInNewContext(
+        source + '\nglobalThis.api = { registerPushWorker, activatePush, revokeBrowserPush, pushSupported };',
+        sandbox,
+    );
+    return { calls, api: sandbox.api };
+}
+
+test('push client registers the static worker without requesting notification permission', async () => {
+    const { calls, api } = client();
+    await api.registerPushWorker();
+    assert.equal(calls.length, 1);
+    assert.equal(calls[0][0], 'register');
+    assert.equal(calls[0][1], '/sw.js');
+    assert.equal(calls[0][2].scope, '/');
+    assert.equal(calls[0][2].updateViaCache, 'none');
+});
+
+test('push permission is requested synchronously from the action before registration and subscription', async () => {
+    const { calls, api } = client();
+    const promise = api.activatePush('BA');
+    assert.equal(calls[0][0], 'permission');
+    const result = await promise;
+    assert.equal(result.endpoint, 'https://push.example.test/device');
+    const options = calls.find(([name]) => name === 'subscribe')[1];
+    assert.equal(options.userVisibleOnly, true);
+    assert.deepEqual([...options.applicationServerKey], [4]);
+});
+
+test('denied permission does not register or subscribe a device', async () => {
+    const { calls, api } = client('denied');
+    await assert.rejects(api.activatePush('BA'), /permiso/);
+    assert.deepEqual(
+        calls.map(([name]) => name),
+        ['permission'],
+    );
+});
+
+test('revocation unsubscribes the current browser without requesting permission', async () => {
+    let revoked = 0;
+    const { calls, api } = client('granted', {
+        unsubscribe: async () => {
+            revoked++;
+            return true;
+        },
+    });
+    await api.revokeBrowserPush();
+    assert.equal(revoked, 1);
+    assert.ok(!calls.some(([name]) => name === 'permission'));
+});
diff --git a/tests/frontend/service-worker.test.mjs b/tests/frontend/service-worker.test.mjs
new file mode 100644
index 0000000..9642c17
--- /dev/null
+++ b/tests/frontend/service-worker.test.mjs
@@ -0,0 +1,72 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+
+function worker() {
+    const handlers = new Map();
+    const notices = [];
+    const opened = [];
+    const forbidden = new Proxy(
+        {},
+        {
+            get() {
+                throw new Error('Worker attempted private storage.');
+            },
+        },
+    );
+    const self = {
+        addEventListener: (name, handler) => handlers.set(name, handler),
+        skipWaiting: async () => {},
+        clients: { claim: async () => {}, openWindow: async (url) => opened.push(url) },
+        registration: { showNotification: async (title, options) => notices.push({ title, ...options }) },
+        location: { origin: 'https://app.example.test' },
+    };
+    vm.runInNewContext(fs.readFileSync(new URL('../../resources/js/sw.js', import.meta.url), 'utf8'), {
+        self,
+        URL,
+        caches: forbidden,
+        indexedDB: forbidden,
+    });
+    async function fire(name, extra = {}) {
+        assert.ok(handlers.has(name), `Missing ${name} behavior.`);
+        const pending = [];
+        const event = Object.defineProperties(
+            { waitUntil: (promise) => pending.push(promise) },
+            Object.getOwnPropertyDescriptors(extra),
+        );
+        handlers.get(name)(event);
+        await Promise.all(pending);
+    }
+    return { handlers, notices, opened, fire };
+}
+
+test('the worker never intercepts user requests or reads private push text into notifications', async () => {
+    const context = worker();
+    assert.equal(context.handlers.has('fetch'), false);
+    await context.fire('install');
+    await context.fire('activate');
+    await context.fire('push', {
+        get data() {
+            throw new Error('Private push data read.');
+        },
+    });
+    assert.equal(context.notices.length, 1);
+    assert.equal(context.notices[0].title, 'Social Scheduler');
+    assert.equal(context.notices[0].body, 'Tienes nuevos avisos.');
+});
+
+test('notification clicks ignore a supplied external URL and open only the local authenticated inbox', async () => {
+    const context = worker();
+    let closed = false;
+    await context.fire('notificationclick', {
+        notification: {
+            data: { url: 'https://evil.example/private' },
+            close() {
+                closed = true;
+            },
+        },
+    });
+    assert.equal(closed, true);
+    assert.deepEqual(context.opened, ['https://app.example.test/notifications']);
+});
