+<?php
+
+namespace App\Connectors\Mastodon;
+
+use App\Enums\ContentType;
+
+/**
+ * Opciones de Mastodon (T-87): `mastodon_visibility` (`public` por defecto, `unlisted`, `private` o `direct`), la visibilidad del estado.
+ */
+final class MastodonPostOptions
+{
+    public const VISIBILITIES = ['public', 'unlisted', 'private', 'direct'];
+
+    public const DEFAULT_VISIBILITY = 'public';
+
+    /** Visibilidades que ofrece el compositor, con su etiqueta. @return list<array{value: string, label: string}> */
+    public static function capabilities(): array
+    {
+        return [
+            ['value' => 'public', 'label' => 'Pública'],
+            ['value' => 'unlisted', 'label' => 'Pública sin listar'],
+            ['value' => 'private', 'label' => 'Solo seguidores'],
+            ['value' => 'direct', 'label' => 'Solo las personas mencionadas'],
+        ];
+    }
+
+    /** @return list<string> */
+    public static function errors(array $options, ContentType $type): array
+    {
+        $asked = array_key_exists('mastodon_visibility', $options) && ! in_array($options['mastodon_visibility'], [null, false, [], ''], true);
+
+        if (! $asked) {
+            return [];
+        }
+        if ($type->network()->value !== 'mastodon') {
+            return ['La opcion mastodon_visibility solo existe en Mastodon.'];
+        }
+
+        return is_string($options['mastodon_visibility']) && in_array($options['mastodon_visibility'], self::VISIBILITIES, true)
+            ? []
+            : ['La visibilidad de Mastodon debe ser public, unlisted, private o direct.'];
+    }
+
+    /** Visibilidad efectiva del destino. @param array<string, mixed> $options */
+    public static function visibility(array $options): string
+    {
+        $value = $options['mastodon_visibility'] ?? null;
+
+        return is_string($value) && in_array($value, self::VISIBILITIES, true) ? $value : self::DEFAULT_VISIBILITY;
+    }
+}
diff --git a/app/Connectors/Mastodon/MastodonPublisher.php b/app/Connectors/Mastodon/MastodonPublisher.php
new file mode 100644
index 0000000..9da7fee
--- /dev/null
+++ b/app/Connectors/Mastodon/MastodonPublisher.php
@@ -0,0 +1,243 @@
+<?php
+
+namespace App\Connectors\Mastodon;
+
+use App\Connectors\Contracts\Publisher;
+use App\Connectors\Data\PublishMedia;
+use App\Connectors\Data\PublishRequest;
+use App\Connectors\Data\PublishResult;
+use App\Connectors\Exceptions\PermanentPublishException;
+use App\Connectors\Exceptions\ReconnectRequiredException;
+use App\Connectors\Exceptions\TransientPublishException;
+use App\Connectors\Support\StepBudget;
+use App\Enums\ContentType;
+use App\Models\SocialAccount;
+use App\Support\TextLength;
+use Illuminate\Support\Facades\Storage;
+use Throwable;
+
+/**
+ * Publicacion en Mastodon (T-87): `POST /api/v2/media` por cada imagen (con su texto alternativo como `description`; un 202 se sondea con
+ * `GET /api/v1/media/:id` dentro del presupuesto del paso) y `POST /api/v1/statuses` con `media_ids[]`, la visibilidad elegida (`public` por defecto) y una
+ * `Idempotency-Key` determinista por destino e intento (la instancia la recuerda una hora: un reintento tras un timeout devuelve el estado ya creado en
+ * lugar de duplicarlo). Los ids de las imagenes ya subidas se guardan en el progreso del destino para no subirlas otra vez al reintentar.
+ *
+ * Los limites son los de la instancia de ESA cuenta (`MastodonLimits`); si tienen mas de `limits_ttl_hours` se vuelven a leer antes de publicar.
+ */
+class MastodonPublisher implements Publisher
+{
+    public function __construct(private readonly MastodonClient $client) {}
+
+    public function publish(SocialAccount $account, PublishRequest $request): PublishResult
+    {
+        if ($request->type !== ContentType::MastodonPost) {
+            throw new PermanentPublishException('Mastodon no admite este tipo de contenido.', 'tipo_no_admitido');
+        }
+
+        $token = (string) $account->access_token;
+        $base = (string) ($account->meta['instance'] ?? '');
+        if ($token === '' || $base === '') {
+            throw new ReconnectRequiredException('La cuenta de Mastodon no tiene instancia o token guardados: vuelve a conectarla.');
+        }
+
+        try {
+            $limits = $this->limits($account, $base);
+            $this->assertWithinLimits($request, $limits);
+
+            $mediaIds = $this->uploadImages($base, $token, $request, $limits);
+            $status = $this->client->createStatus($base, $token, $this->body($request, $mediaIds), self::idempotencyKey($request));
+            $request->budget()->spent();
+        } catch (MastodonException $e) {
+            throw MastodonErrors::translate($e);
+        }
+
+        $id = (string) ($status['id'] ?? '');
+        if ($id === '') {
+            throw new PermanentPublishException('Mastodon no devolvió el identificador de la publicación.', 'sin_id');
+        }
+
+        // La URL la escribe una instancia ajena y acaba en un enlace de la app: solo https y del host de la instancia (`url`, o `uri` si `url` no vale).
+        $host = (string) parse_url($base, PHP_URL_HOST);
+        $url = MastodonClient::safeUrl($status['url'] ?? null, $host) ?? MastodonClient::safeUrl($status['uri'] ?? null, $host);
+
+        return PublishResult::published($id, $url, ['created_at' => $status['created_at'] ?? null]);
+    }
+
+    /** La instancia no permite consultar un estado por su `Idempotency-Key`: un reintento no publica de mas porque `publish` la repite. */
+    public function findPublished(SocialAccount $account, PublishRequest $request): ?PublishResult
+    {
+        return null;
+    }
+
+    /**
+     * Clave de idempotencia: la misma para todos los reintentos del MISMO contenido de un destino y de un intento de publicacion (`since` es el inicio de su
+     * ventana, fijo mientras dura) y distinta entre destinos. Lleva un hash del contenido (texto, visibilidad e imagenes con su alt): si se edita tras un
+     * timeout ambiguo, la instancia (que recuerda la clave una hora) no devuelve el estado viejo y la edicion se publica; el coste es que, si el envio
+     * anterior si llego a salir, queda tambien el estado antiguo en la instancia, visible para el usuario. Nunca contiene el token.
+     */
+    public static function idempotencyKey(PublishRequest $request): string
+    {
+        $content = json_encode([
+            trim((string) $request->text),
+            MastodonPostOptions::visibility($request->options),
+            array_map(fn (PublishMedia $m) => [$m->id, trim((string) $m->alt)], $request->media),
+        ], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
+
+        return hash('sha256', 'mastodon-status|'.$request->targetId.'|'.($request->since?->getTimestamp() ?? 0).'|'.hash('sha256', (string) $content));
+    }
+
+    /**
+     * Limites de la cuenta, releidos de la instancia si el dato es viejo. Si la lectura falla se siguen usando los guardados (o los por defecto).
+     *
+     * @return array<string, mixed>
+     */
+    private function limits(SocialAccount $account, string $base): array
+    {
+        if (MastodonLimits::isStale($account)) {
+            try {
+                $fresh = MastodonLimits::fromInstance($this->client->instance($base));
+                $account->forceFill(['meta' => array_merge((array) $account->meta, ['limits' => $fresh])])->save();
+            } catch (MastodonException) {
+                // Sin lectura se publica con lo que haya; el siguiente intento vuelve a probar.
+            }
+        }
+
+        return MastodonLimits::forAccount($account);
+    }
+
+    /** @param array<string, mixed> $limits */
+    private function assertWithinLimits(PublishRequest $request, array $limits): void
+    {
+        if (count($request->media) > $limits['max_media_attachments']) {
+            throw new PermanentPublishException('Tu instancia de Mastodon admite como máximo '.$limits['max_media_attachments'].' imágenes por publicación.', 'demasiadas_imagenes');
+        }
+        if (TextLength::count($request->text, TextLength::MASTODON, $limits['characters_reserved_per_url']) > $limits['max_characters']) {
+            throw new PermanentPublishException('El texto supera los '.$limits['max_characters'].' caracteres que admite tu instancia de Mastodon.', 'texto_largo');
+        }
+    }
+
+    /**
+     * Sube las imagenes que faltan y espera a que estén listas; devuelve los ids en orden. Los ya subidos (progreso del destino) no se repiten.
+     *
+     * @param  array<string, mixed>  $limits
+     * @return list<string>
+     */
+    private function uploadImages(string $base, #[\SensitiveParameter] string $token, PublishRequest $request, array $limits): array
+    {
+        $ids = array_values(array_filter((array) ($request->progress['media_ids'] ?? []), fn ($id) => is_string($id) && $id !== ''));
+        $budget = $request->budget();
+
+        foreach ($request->media as $i => $media) {
+            // Un id guardado en el progreso caduca (la instancia limpia las subidas sin usar): si ya no existe (404) se vuelve a subir.
+            if (isset($ids[$i])) {
+                try {
+                    $this->awaitReady($base, $token, $ids[$i], $budget);
+
+                    continue;
+                } catch (MastodonException $e) {
+                    if ($e->status !== 404) {
+                        throw $e;
+                    }
+                    unset($ids[$i]);
+                }
+            }
+
+            $this->assertTime($budget);
+            $uploaded = $this->upload($base, $token, $media, $limits);
+            $budget->spent();
+            $ids[$i] = $uploaded['id'];
+            ksort($ids);
+            $request->checkpoint(null, ['media_ids' => $ids]);
+
+            if (! $uploaded['ready']) {
+                $this->awaitReady($base, $token, $ids[$i], $budget);
+            }
+        }
+
+        return array_slice($ids, 0, count($request->media));
+    }
+
+    /**
+     * @param  array<string, mixed>  $limits
+     * @return array{id: string, ready: bool}
+     */
+    private function upload(string $base, #[\SensitiveParameter] string $token, PublishMedia $media, array $limits): array
+    {
+        if ($media->isVideo() || $media->disk === null || $media->path === null) {
+            throw new PermanentPublishException('Mastodon solo admite imágenes en este tipo de publicación.', 'tipo_no_admitido');
+        }
+        if (! in_array($media->mime, $limits['image_mime_types'], true)) {
+            throw new PermanentPublishException('Tu instancia de Mastodon no admite el formato de una de las imágenes ('.$media->mime.').', 'formato_no_admitido');
+        }
+        if ((int) $media->size > $limits['image_size_limit']) {
+            throw new PermanentPublishException('Una imagen pesa más de lo que admite tu instancia de Mastodon.', 'archivo_grande');
+        }
+
+        try {
+            $bytes = (string) Storage::disk($media->disk)->get($media->path);
+        } catch (Throwable) {
+            throw new PermanentPublishException('No se pudo leer una de las imágenes.', 'media_ilegible');
+        }
+        if ($bytes === '') {
+            throw new PermanentPublishException('No se pudo leer una de las imágenes.', 'media_ilegible');
+        }
+
+        $alt = trim((string) $media->alt);
+        if ($limits['description_limit'] !== null) {
+            $alt = mb_substr($alt, 0, $limits['description_limit']);
+        }
+
+        $result = $this->client->uploadMedia($base, $token, $bytes, $media->mime, basename($media->path), $alt);
+        $id = (string) ($result['media']['id'] ?? '');
+        if ($id === '') {
+            throw new PermanentPublishException('Mastodon no devolvió el identificador de la imagen subida.', 'sin_id');
+        }
+
+        // 200 = lista; 202 = la instancia sigue procesandola (la URL llega nula).
+        return ['id' => $id, 'ready' => $result['status'] === 200];
+    }
+
+    /** Sondea `GET /api/v1/media/:id` hasta que la imagen esté lista (200); sin tiempo o intentos, se reintenta el destino con los ids ya guardados. */
+    private function awaitReady(string $base, #[\SensitiveParameter] string $token, string $id, StepBudget $budget): void
+    {
+        $attempts = max(1, (int) config('social.mastodon.media_poll_attempts', 5));
+
+        for ($n = 1; $n <= $attempts; $n++) {
+            $this->assertTime($budget);
+            $state = $this->client->media($base, $token, $id);
+            $budget->spent();
+
+            if ($state['status'] === 200) {
+                return;
+            }
+            if ($n < $attempts) {
+                // La espera nunca se come el presupuesto del paso: se deja sitio para la siguiente llamada (`assertTime` corta si ya no cabe).
+                $room = max(0.0, $budget->remaining() - (float) config('social.http_timeout', 15));
+                usleep((int) (min(max(0, (int) config('social.mastodon.media_poll_delay_ms', 1500)) / 1000, $room) * 1_000_000));
+            }
+        }
+
+        throw new TransientPublishException('Mastodon sigue procesando una imagen; se reintentará.', 'imagen_procesando');
+    }
+
+    /** Sin tiempo para otra llamada dentro del presupuesto del paso: se reintenta en lugar de morir por el timeout del job. */
+    private function assertTime(StepBudget $budget): void
+    {
+        if (! $budget->allows()) {
+            throw new TransientPublishException('Sin tiempo para seguir publicando en Mastodon en este intento; se reintentará.', 'sin_tiempo');
+        }
+    }
+
+    /**
+     * @param  list<string>  $mediaIds
+     * @return array<string, mixed>
+     */
+    private function body(PublishRequest $request, array $mediaIds): array
+    {
+        return array_filter([
+            'status' => trim((string) $request->text),
+            'media_ids' => $mediaIds !== [] ? $mediaIds : null,
+            'visibility' => MastodonPostOptions::visibility($request->options),
+        ], fn ($v) => $v !== null && $v !== '');
+    }
+}
diff --git a/app/Connectors/Telegram/TelegramClient.php b/app/Connectors/Telegram/TelegramClient.php
new file mode 100644
index 0000000..725c645
--- /dev/null
+++ b/app/Connectors/Telegram/TelegramClient.php
@@ -0,0 +1,78 @@
+<?php
+
+namespace App\Connectors\Telegram;
+
+use App\Services\Media\UnsafeUrlException;
+use App\Services\Media\UrlGuard;
+use Illuminate\Http\Client\ConnectionException;
+use Illuminate\Http\Client\RequestException;
+use Illuminate\Support\Facades\Http;
+
+/**
+ * Cliente de la Bot API de Telegram (T-87) para UN bot. El token va en la RUTA (`/bot<token>/METODO`): por eso la URL no se registra nunca, ninguna excepcion
+ * la lleva (ni como mensaje ni encadenada) y el token se marca `SensitiveParameter` para que tampoco salga en las trazas. La conexion se fija a la IP
+ * validada (`UrlGuard`) y no se siguen redirecciones.
+ */
+final class TelegramClient
+{
+    /** La Bot API es siempre esta: no se configura (la URL lleva el token y solo hay un servidor legitimo). */
+    private const API = 'https://api.telegram.org';
+
+    /** Errores de cURL en los que la peticion NO llego a salir (DNS, conexion rechazada, TLS, proxy): reintentar es seguro. El resto (timeout, corte) es ambiguo. */
+    private const NOT_SENT = [5, 6, 7, 35, 51, 58, 59, 60];
+
+    public function __construct(#[\SensitiveParameter] private readonly string $token) {}
+
+    /**
+     * Llama a un metodo y devuelve su `result`.
+     *
+     * @param  array<string, scalar>  $params
+     * @param  array{name: string, contents: string, filename: string}|null  $file  Fichero multipart (p. ej. la foto de `sendPhoto`).
+     * @return array<string, mixed>
+     *
+     * @throws TelegramException
+     */
+    public function call(string $method, array $params = [], ?array $file = null): array
+    {
+        $guard = app(UrlGuard::class);
+
+        try {
+            $validated = $guard->validate(self::API.'/bot'.$this->token.'/'.$method);
+        } catch (UnsafeUrlException) {
+            throw new TelegramException('El servidor de Telegram configurado no es válido.');
+        }
+
+        $http = Http::acceptJson()->timeout((int) config('social.http_timeout', 15))->withoutRedirecting()->withOptions($guard->requestOptions($validated));
+
+        try {
+            $response = $file !== null
+                ? $http->attach($file['name'], $file['contents'], $file['filename'])->post($validated->url, $params)
+                : $http->asForm()->post($validated->url, $params);
+        } catch (ConnectionException $e) {
+            // El mensaje de la excepcion original lleva la URL (con el token): no se propaga ni se encadena. Solo se lee de el el codigo de cURL.
+            $errno = preg_match('/cURL error (\d+)/', $e->getMessage(), $m) === 1 ? (int) $m[1] : null;
+
+            throw new TelegramException('No se pudo conectar con Telegram.', ambiguous: ! in_array($errno, self::NOT_SENT, true));
+        } catch (RequestException $e) {
+            // Respuesta cortada a mitad o error del cliente HTTP: se trata como el error HTTP que traia, nunca como un fallo sin controlar.
+            throw new TelegramException('Telegram respondió con un error.', $e->response->status());
+        }
+
+        $json = $response->json();
+        $json = is_array($json) ? $json : [];
+
+        if (($json['ok'] ?? false) === true && $response->successful()) {
+            return is_array($json['result'] ?? null) ? $json['result'] : [];
+        }
+
+        $description = is_string($json['description'] ?? null) ? mb_substr(trim((string) preg_replace('/[\x00-\x1f\x7f\s]+/u', ' ', $json['description'])), 0, 200) : '';
+        $retry = $json['parameters']['retry_after'] ?? null;
+
+        throw new TelegramException(
+            'Telegram respondió con un error.',
+            (int) ($json['error_code'] ?? $response->status()),
+            $description,
+            is_int($retry) && $retry > 0 ? min($retry, 86400) : null,
+        );
+    }
+}
diff --git a/app/Connectors/Telegram/TelegramConnector.php b/app/Connectors/Telegram/TelegramConnector.php
new file mode 100644
index 0000000..6756b4a
--- /dev/null
+++ b/app/Connectors/Telegram/TelegramConnector.php
@@ -0,0 +1,128 @@
+<?php
+
+namespace App\Connectors\Telegram;
+
+use App\Connectors\Contracts\CredentialConnector;
+use App\Connectors\Data\ConnectionCandidate;
+use App\Connectors\Data\RefreshResult;
+use App\Connectors\Exceptions\ConnectorException;
+use App\Connectors\Network;
+use App\Models\SocialAccount;
+
+/**
+ * Conector de Telegram (T-87): se conecta con el token de un bot (BotFather) y el canal donde publica (`@canal` o su id numerico). El token se guarda cifrado
+ * en `access_token` (lo recifra `app:reencrypt`) y no caduca. Solo se admite un CANAL (`type = channel`): los grupos y supergrupos tienen otras reglas de
+ * permisos y de limite de envio que la documentacion leida no cubre, y la comprobacion de «puede publicar» (`can_post_messages`) es la de los canales.
+ * `external_id` = id del chat, `name` = titulo del canal (o su @usuario).
+ */
+class TelegramConnector implements CredentialConnector
+{
+    public function provider(): string
+    {
+        return 'telegram';
+    }
+
+    public function networks(): array
+    {
+        return [Network::Telegram];
+    }
+
+    /** El token de un bot no caduca: nunca hay renovacion (`token_expires_at` queda en null). */
+    public function refreshMarginHours(): int
+    {
+        return 0;
+    }
+
+    public function credentialIntro(): string
+    {
+        return 'Conecta un canal de Telegram con el token de un bot creado con BotFather. El bot tiene que ser administrador del canal con permiso para publicar mensajes. El token se guarda cifrado y puedes revocarlo desde BotFather cuando quieras.';
+    }
+
+    public function credentialFields(): array
+    {
+        return [
+            ['name' => 'bot_token', 'label' => 'Token del bot', 'type' => 'password', 'help' => 'Te lo da @BotFather al crear el bot con /newbot. Tiene el formato 123456789:AAA...'],
+            ['name' => 'channel', 'label' => 'Canal', 'type' => 'text', 'help' => 'El @usuario público del canal (por ejemplo @micanal) o su id numérico (por ejemplo -1001234567890).'],
+        ];
+    }
+
+    public function connectWithCredentials(array $input): array
+    {
+        $token = trim((string) ($input['bot_token'] ?? ''));
+        $channel = trim((string) ($input['channel'] ?? ''));
+
+        if ($token === '' || $channel === '') {
+            throw new ConnectorException('Escribe el token del bot y el canal de Telegram.');
+        }
+        // El token va en la ruta de la peticion: solo se admite su forma real, nunca algo que pueda alterar la URL.
+        if (preg_match('/^\d{3,20}:[A-Za-z0-9_-]{20,100}$/D', $token) !== 1) {
+            throw new ConnectorException('El token del bot no tiene el formato de Telegram (123456789:AAA...). Cópialo de @BotFather.');
+        }
+        if (preg_match('/^(?:@[A-Za-z][A-Za-z0-9_]{3,31}|-?\d{1,20})$/D', $channel) !== 1) {
+            throw new ConnectorException('Escribe el canal como @usuario (por ejemplo @micanal) o con su id numérico.');
+        }
+
+        $api = new TelegramClient($token);
+
+        try {
+            $bot = $api->call('getMe');
+            $botId = (string) ($bot['id'] ?? '');
+            $chat = $api->call('getChat', ['chat_id' => $channel]);
+            $chatId = (string) ($chat['id'] ?? '');
+
+            if ($botId === '' || $chatId === '') {
+                throw new ConnectorException('Telegram no devolvió los datos del bot o del canal.');
+            }
+            if (($chat['type'] ?? null) !== 'channel') {
+                throw new ConnectorException('Ese chat no es un canal de Telegram. Solo se pueden conectar canales, no grupos ni chats privados.');
+            }
+
+            $member = $api->call('getChatMember', ['chat_id' => $chatId, 'user_id' => $botId]);
+        } catch (TelegramException $e) {
+            throw new ConnectorException(match (true) {
+                $e->status === 401 => 'Telegram rechazó el token del bot. Comprueba que lo has copiado entero de @BotFather.',
+                $e->status === 400 && str_contains(strtolower($e->description), 'chat not found') => 'Telegram no encuentra ese canal. Comprueba el @usuario o el id y que el bot es administrador del canal.',
+                $e->status === 403 => 'Telegram no deja al bot acceder a ese canal. '.self::ADMIN_HELP,
+                $e->status > 0 => 'Telegram no pudo validar el canal (error '.$e->status.').',
+                default => $e->getMessage(),
+            });
+        }
+
+        if (! self::canPost($member)) {
+            throw new ConnectorException('El bot no puede publicar en ese canal. '.self::ADMIN_HELP);
+        }
+
+        $username = is_string($chat['username'] ?? null) && $chat['username'] !== '' ? $chat['username'] : null;
+        $title = trim((string) ($chat['title'] ?? ''));
+
+        return [new ConnectionCandidate(
+            network: Network::Telegram,
+            externalId: $chatId,
+            name: $title !== '' ? $title : ($username !== null ? '@'.$username : $chatId),
+            username: $username !== null ? '@'.$username : null,
+            accessToken: $token,
+            scopes: ['channel:post'],
+            meta: array_filter([
+                'bot_id' => $botId,
+                'bot_username' => is_string($bot['username'] ?? null) ? $bot['username'] : null,
+                'chat_type' => 'channel',
+                'chat_username' => $username,
+                'chat_title' => $title !== '' ? $title : null,
+            ], fn ($v) => $v !== null),
+        )];
+    }
+
+    public function refresh(SocialAccount $account): RefreshResult
+    {
+        return new RefreshResult((string) $account->access_token);
+    }
+
+    /** ¿Puede el bot publicar? El creador del canal siempre; un administrador, solo con `can_post_messages`. @param array<string, mixed> $member */
+    private static function canPost(array $member): bool
+    {
+        return ($member['status'] ?? null) === 'creator'
+            || (($member['status'] ?? null) === 'administrator' && ($member['can_post_messages'] ?? false) === true);
+    }
+
+    private const ADMIN_HELP = 'Abre el canal en Telegram > Administradores > Añadir administrador, elige a tu bot y activa «Publicar mensajes».';
+}
diff --git a/app/Connectors/Telegram/TelegramErrors.php b/app/Connectors/Telegram/TelegramErrors.php
new file mode 100644
index 0000000..f8632da
--- /dev/null
+++ b/app/Connectors/Telegram/TelegramErrors.php
@@ -0,0 +1,43 @@
+<?php
+
+namespace App\Connectors\Telegram;
+
+use App\Connectors\Exceptions\PermanentPublishException;
+use App\Connectors\Exceptions\PublishException;
+use App\Connectors\Exceptions\QuotaExceededException;
+use App\Connectors\Exceptions\ReconnectRequiredException;
+use App\Connectors\Exceptions\TransientPublishException;
+
+/**
+ * Traduce los errores de la Bot API a las excepciones de la cola: `retry_after` (flood control) -> espera; 401/403, «bot was kicked» o «not enough rights» ->
+ * reconectar; red y 5xx -> transitorio; el resto -> permanente con un mensaje legible. Nunca incluye el token ni la URL.
+ */
+final class TelegramErrors
+{
+    /** Fragmentos de `description` (en minusculas) que significan «el bot ya no puede publicar en el canal». */
+    private const NO_ACCESS = ['bot was kicked', 'not enough rights', 'bot is not a member', 'have no rights to send', 'chat not found'];
+
+    public static function translate(TelegramException $e): PublishException|ReconnectRequiredException
+    {
+        $description = strtolower($e->description);
+
+        if ($e->retryAfter !== null || $e->status === 429) {
+            return new QuotaExceededException('Telegram ha limitado temporalmente los envíos al canal; se reintentará.', now()->addSeconds($e->retryAfter ?? 30), 'limite_temporal');
+        }
+
+        if (in_array($e->status, [401, 403], true) || array_filter(self::NO_ACCESS, fn (string $needle) => str_contains($description, $needle)) !== []) {
+            return new ReconnectRequiredException('Telegram rechazó al bot (token revocado, bot expulsado del canal o sin permiso para publicar): vuelve a conectar el canal y comprueba que el bot sigue siendo administrador con permiso para publicar mensajes.');
+        }
+
+        // Timeout o corte despues de enviar: Telegram puede haber publicado ya y no deja comprobarlo. Reintentar duplicaria el mensaje: se para y el usuario lo revisa.
+        if ($e->ambiguous) {
+            return new PermanentPublishException('Telegram no confirmó el envío (tiempo agotado o conexión cortada): revisa el canal antes de volver a publicar para no duplicar el mensaje.', 'resultado_incierto');
+        }
+
+        if ($e->isTransient()) {
+            return new TransientPublishException('Telegram no respondió correctamente; se reintentará.', 'telegram_no_disponible');
+        }
+
+        return new PermanentPublishException('Telegram rechazó la publicación'.($e->description !== '' ? ': '.$e->description : '.'), 'rechazada');
+    }
+}
diff --git a/app/Connectors/Telegram/TelegramException.php b/app/Connectors/Telegram/TelegramException.php
new file mode 100644
index 0000000..37dfbb2
--- /dev/null
+++ b/app/Connectors/Telegram/TelegramException.php
@@ -0,0 +1,23 @@
+<?php
+
+namespace App\Connectors\Telegram;
+
+use App\Connectors\Exceptions\ConnectorException;
+
+/**
+ * Error de la Bot API de Telegram o fallo de red. `status` es el HTTP (0 = sin respuesta); `description` es la que devuelve Telegram (limpia y acotada);
+ * `retryAfter` son los segundos de espera de un 429 (`parameters.retry_after`). `ambiguous`: la peticion pudo llegar antes de fallar (timeout tras enviar, respuesta cortada) y no se sabe si el mensaje salio. El mensaje y la descripcion nunca incluyen el token ni la URL, que lo lleva en la ruta.
+ */
+class TelegramException extends ConnectorException
+{
+    public function __construct(string $message, public readonly int $status = 0, public readonly string $description = '', public readonly ?int $retryAfter = null, public readonly bool $ambiguous = false)
+    {
+        parent::__construct($message);
+    }
+
+    /** ¿Fallo de red o del servidor (reintentable)? */
+    public function isTransient(): bool
+    {
+        return ($this->status === 0 && ! $this->ambiguous) || $this->status === 408 || $this->status >= 500;
+    }
+}
diff --git a/app/Connectors/Telegram/TelegramPublisher.php b/app/Connectors/Telegram/TelegramPublisher.php
new file mode 100644
index 0000000..4e3bc72
--- /dev/null
+++ b/app/Connectors/Telegram/TelegramPublisher.php
@@ -0,0 +1,91 @@
+<?php
+
+namespace App\Connectors\Telegram;
+
+use App\Connectors\Contracts\Publisher;
+use App\Connectors\Data\PublishRequest;
+use App\Connectors\Data\PublishResult;
+use App\Connectors\Exceptions\PermanentPublishException;
+use App\Connectors\Exceptions\ReconnectRequiredException;
+use App\Enums\ContentType;
+use App\Models\SocialAccount;
+use Illuminate\Support\Facades\Storage;
+use Throwable;
+
+/**
+ * Publicacion en un canal de Telegram (T-87), siempre como texto plano (sin `parse_mode`: ningun caracter se interpreta como formato):
+ *  - `telegram_text`: `sendMessage` (1 a 4096 caracteres).
+ *  - `telegram_photo`: `sendPhoto` por multipart (hasta 10 MB; ancho + alto <= 10000 y proporcion <= 20) con el texto como `caption` (hasta 1024). El limite
+ *    de cada texto se valida al guardar (`media_specs`), asi que no falla al publicar por longitud. Varias fotos (`sendMediaGroup`) no estan en el contrato leido.
+ *
+ * La URL publicada es `https://t.me/<usuario>/<message_id>` si el canal tiene @usuario publico; en un canal privado Telegram no da enlace publico y la URL es null.
+ * Telegram no admite idempotencia: si una peticion acaba en timeout con la respuesta perdida, el reintento puede duplicar el mensaje (`findPublished` no puede comprobarlo).
+ */
+class TelegramPublisher implements Publisher
+{
+    public function publish(SocialAccount $account, PublishRequest $request): PublishResult
+    {
+        $token = (string) $account->access_token;
+        if ($token === '' || $account->external_id === '') {
+            throw new ReconnectRequiredException('La cuenta de Telegram no tiene el bot o el canal guardados: vuelve a conectarla.');
+        }
+
+        $api = new TelegramClient($token);
+        $text = trim((string) $request->text);
+
+        try {
+            $message = match ($request->type) {
+                ContentType::TelegramText => $api->call('sendMessage', ['chat_id' => $account->external_id, 'text' => $text]),
+                ContentType::TelegramPhoto => $this->sendPhoto($api, $account, $request, $text),
+                default => throw new PermanentPublishException('Telegram no admite este tipo de contenido.', 'tipo_no_admitido'),
+            };
+            $request->budget()->spent();
+        } catch (TelegramException $e) {
+            throw TelegramErrors::translate($e);
+        }
+
+        $id = (string) ($message['message_id'] ?? '');
+        if ($id === '') {
+            throw new PermanentPublishException('Telegram no devolvió el identificador del mensaje.', 'sin_id');
+        }
+
+        $username = (string) ($account->meta['chat_username'] ?? '');
+
+        return PublishResult::published($id, $username !== '' ? 'https://t.me/'.$username.'/'.$id : null, ['date' => $message['date'] ?? null]);
+    }
+
+    /** Telegram no deja comprobar si un mensaje ya salio: un reintento vuelve a enviarlo. */
+    public function findPublished(SocialAccount $account, PublishRequest $request): ?PublishResult
+    {
+        return null;
+    }
+
+    /** @return array<string, mixed> */
+    private function sendPhoto(TelegramClient $api, SocialAccount $account, PublishRequest $request, string $caption): array
+    {
+        $media = $request->firstMedia();
+        if ($media === null || $media->isVideo() || $media->disk === null || $media->path === null) {
+            throw new PermanentPublishException('Falta la foto que publicar en Telegram.', 'media_invalida');
+        }
+
+        try {
+            $bytes = (string) Storage::disk($media->disk)->get($media->path);
+        } catch (Throwable) {
+            throw new PermanentPublishException('No se pudo leer la foto.', 'media_ilegible');
+        }
+        if ($bytes === '') {
+            throw new PermanentPublishException('No se pudo leer la foto.', 'media_ilegible');
+        }
+        if (strlen($bytes) > 10 * 1024 * 1024) {
+            throw new PermanentPublishException('La foto pesa más de los 10 MB que admite Telegram.', 'archivo_grande');
+        }
+
+        // Ancho + alto <= 10000: es una regla de Telegram que `media_specs` no puede expresar (suma de dos lados).
+        $size = @getimagesizefromstring($bytes);
+        if ($size !== false && $size[0] + $size[1] > 10000) {
+            throw new PermanentPublishException('La foto es demasiado grande para Telegram (ancho + alto superan los 10000 píxeles).', 'dimensiones');
+        }
+
+        return $api->call('sendPhoto', array_filter(['chat_id' => $account->external_id, 'caption' => $caption], fn ($v) => $v !== ''), ['name' => 'photo', 'contents' => $bytes, 'filename' => basename($media->path)]);
+    }
+}
