+    Site::create(['user_id' => $user->id, 'brand_id' => $brand->id, 'slug' => strtolower($tag).'-sitio', 'title' => "$tag-sitio", 'draft' => ['hero' => "$tag-contenido"], 'password_hash' => $secrets ? 'SECRETO-HASH-DEL-SITIO' : null]);
+    $link = (new SmartLink)->forceFill(['user_id' => $user->id, 'brand_id' => $brand->id, 'slug' => strtolower($tag).'-link', 'title' => "$tag-smartlink"]);
+    $link->save();
