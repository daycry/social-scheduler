+                ><span class="block">{{ label }}</span
+                ><select
+                    :value="animation?.[phase]?.type ?? ''"
+                    :disabled="disabled"
+                    :aria-label="label"
+                    :data-testid="`animation-${phase}-type`"
+                    class="w-56 rounded-lg border-slate-200 text-xs"
+                    @change="change(phase, $event.target.value ? { type: $event.target.value } : null)"
+                    ><option value="">Sin animación</option
+                    ><option v-for="[type, name] in TYPES" :key="type" :value="type">{{ name }}</option></select
+                ></label
+            >
+            <label class="space-y-1 text-xs text-slate-600"
+                ><span class="block">Duración de la {{ label.toLowerCase() }} (s)</span
+                ><input
+                    type="number"
+                    :min="ANIMATION_LIMITS.minDuration"
+                    :max="ANIMATION_LIMITS.maxDuration"
+                    :step="step"
+                    :value="animation?.[phase] ? format(animation[phase].duration) : ''"
+                    :disabled="disabled || !animation?.[phase]"
+                    :data-testid="`animation-${phase}-duration`"
+                    class="w-24 rounded-lg border-slate-200 text-xs"
+                    @change="change(phase, { duration: Number($event.target.value) })"
+            /></label>
+            <template v-if="animation?.[phase]">
+                <label class="space-y-1 text-xs text-slate-600"
+                    ><span class="block">Retardo de la {{ label.toLowerCase() }} (s)</span
+                    ><input
+                        type="number"
+                        min="0"
+                        :step="step"
+                        :value="format(animation[phase].delay ?? 0)"
+                        :disabled="disabled"
+                        :data-testid="`animation-${phase}-delay`"
+                        class="w-24 rounded-lg border-slate-200 text-xs"
+                        @change="change(phase, { delay: Number($event.target.value) })"
+                /></label>
+                <label class="space-y-1 text-xs text-slate-600"
+                    ><span class="block">Curva de la {{ label.toLowerCase() }}</span
+                    ><select
+                        :value="animation[phase].easing ?? ANIMATION_DEFAULT_EASING"
+                        :disabled="disabled"
+                        :aria-label="`Curva de la ${label.toLowerCase()}`"
+                        :data-testid="`animation-${phase}-easing`"
+                        class="w-32 rounded-lg border-slate-200 text-xs"
+                        @change="change(phase, { easing: $event.target.value })"
+                        ><option
+                            v-for="[easing, name] in EASINGS"
+                            :key="easing"
+                            :value="easing"
+                            >{{ name }}</option
+                        ></select
+                    ></label
+                >
+            </template>
+        </div>
+        <p class="text-[10px] leading-relaxed text-slate-500"
+            >La entrada empieza tras el retardo desde el inicio del clip; la salida termina el retardo indicado antes de
+            su final. Mueve el cabezal para ver el resultado.</p
+        >
+    </fieldset>
+</template>
diff --git a/resources/js/Studio/animation-scene.js b/resources/js/Studio/animation-scene.js
new file mode 100644
index 0000000..dc25a5c
--- /dev/null
+++ b/resources/js/Studio/animation-scene.js
@@ -0,0 +1,39 @@
+import { Point } from 'fabric';
+import { animationState, effectiveWindow, fitAnimation } from './object-animation.js';
+
+/**
+ * Aplica a un objeto de Fabric el estado animado de su elemento en el instante local `time`.
+ * Parte siempre de la posición base guardada la primera vez, así que repetir el instante no acumula nada.
+ * Sin `animation` no toca el objeto: los diseños antiguos se pintan exactamente igual que antes.
+ * Devuelve la ventana efectiva del elemento, para pasarla como `parent` a los hijos de un grupo.
+ */
+export function applyElementAnimation(object, element, time, { width, height, pageDuration, parent, settled = false }) {
+    // La ventana efectiva (la del grupo cortada con la propia) manda; el llamante la pasa a los hijos del grupo.
+    const window = effectiveWindow(element.timing ?? { start: 0, duration: pageDuration }, parent);
+    // En reposo (salida estática sin instante explícito) el objeto queda como se diseñó.
+    if (!element.animation || settled) return window;
+    // Lo que no cabe en la ventana efectiva no se anima, igual que al desagrupar.
+    const animation = fitAnimation(element.animation, window.duration);
+    if (!animation) return window;
+    object.studioAnimationBase ??= {
+        center: object.getRelativeCenterPoint(),
+        scaleX: object.scaleX,
+        scaleY: object.scaleY,
+        opacity: object.opacity,
+    };
+    const base = object.studioAnimationBase;
+    const state = animationState(animation, time, window);
+    object.set({
+        opacity: base.opacity * state.opacity,
+        scaleX: base.scaleX * state.scale,
+        scaleY: base.scaleY * state.scale,
+    });
+    object.setPositionByOrigin(
+        new Point(base.center.x + state.offsetX * width, base.center.y + state.offsetY * height),
+        'center',
+        'center',
+    );
+    object.setCoords();
+    object.dirty = true;
+    return window;
+}
diff --git a/resources/js/Studio/object-animation.js b/resources/js/Studio/object-animation.js
new file mode 100644
index 0000000..33b52e0
--- /dev/null
+++ b/resources/js/Studio/object-animation.js
@@ -0,0 +1,152 @@
+/**
+ * Animaciones de entrada y salida por objeto. Es la ÚNICA implementación del cálculo: la previsualización,
+ * el render MP4/GIF de servidor (Chromium) y la exportación por fotograma llaman a `animationState`.
+ * El servidor valida el mismo esquema en StudioTimeline.php (tipos, rangos y ajuste a la vida del objeto).
+ */
+export const ANIMATION_TYPES = Object.freeze(['fade', 'slide_left', 'slide_right', 'slide_up', 'slide_down', 'zoom']);
+export const ANIMATION_EASINGS = Object.freeze(['linear', 'ease_in', 'ease_out', 'ease_in_out']);
+export const ANIMATION_LIMITS = Object.freeze({
+    minDuration: 0.1,
+    maxDuration: 10,
+    maxDelay: 3600,
+    slideDistance: 0.25,
+    zoomFrom: 0.5,
+});
+export const ANIMATION_DEFAULT_EASING = 'ease_in_out';
+const PHASES = ['in', 'out'];
+const EPS = 1e-9;
+const IDENTITY = Object.freeze({ opacity: 1, offsetX: 0, offsetY: 0, scale: 1 });
+
+const plain = (value) =>
+    value !== null &&
+    typeof value === 'object' &&
+    !Array.isArray(value) &&
+    [Object.prototype, null].includes(Object.getPrototypeOf(value));
+const fail = (path, message) => {
+    throw new Error(`${path}: ${message}`);
+};
+const span = (phase) => (phase.delay ?? 0) + phase.duration;
+
+/** Valida la animación de un objeto cuya vida dura `length` segundos y devuelve una copia. */
+export function normalizeAnimation(animation, length, path = 'animation') {
+    if (!plain(animation)) fail(path, 'la animación debe ser un objeto.');
+    for (const key of Object.keys(animation))
+        if (!PHASES.includes(key)) fail(`${path}.${key}`, 'propiedad de animación no admitida.');
+    if (!PHASES.some((key) => Object.hasOwn(animation, key))) fail(path, 'indica una entrada o una salida.');
+    const result = {};
+    let total = 0;
+    for (const key of PHASES) {
+        if (!Object.hasOwn(animation, key)) continue;
+        const phase = animation[key],
+            where = `${path}.${key}`;
+        if (!plain(phase)) fail(where, 'la fase debe ser un objeto.');
+        for (const name of Object.keys(phase))
+            if (!['type', 'duration', 'delay', 'easing'].includes(name))
+                fail(`${where}.${name}`, 'propiedad de animación no admitida.');
+        if (!ANIMATION_TYPES.includes(phase.type)) fail(`${where}.type`, 'tipo de animación no admitido.');
+        const { minDuration, maxDuration, maxDelay } = ANIMATION_LIMITS;
+        if (!Number.isFinite(phase.duration) || phase.duration < minDuration || phase.duration > maxDuration)
+            fail(`${where}.duration`, `la duración debe estar entre ${minDuration} y ${maxDuration} s.`);
+        if (
+            Object.hasOwn(phase, 'delay') &&
+            (!Number.isFinite(phase.delay) || phase.delay < 0 || phase.delay > maxDelay)
+        )
+            fail(`${where}.delay`, `el retardo debe estar entre 0 y ${maxDelay} s.`);
+        if (Object.hasOwn(phase, 'easing') && !ANIMATION_EASINGS.includes(phase.easing))
+            fail(`${where}.easing`, 'curva de suavizado no admitida.');
+        result[key] = { ...phase };
+        total += span(phase);
+    }
+    if (total > length + EPS) fail(path, 'la entrada y la salida no caben en la vida del objeto.');
+    return result;
+}
+
+/** Descarta las fases que ya no caben tras acortar la vida del objeto; devuelve null si no queda ninguna. */
+export function fitAnimation(animation, length) {
+    if (!animation) return null;
+    const result = {};
+    let total = 0;
+    for (const key of PHASES) {
+        if (animation[key] && total + span(animation[key]) <= length + EPS) {
+            result[key] = { ...animation[key] };
+            total += span(animation[key]);
+        }
+    }
+    return Object.keys(result).length ? result : null;
+}
+
+/** Ventana efectiva de un objeto: su `timing` (o la página) cortada por la del grupo que lo contiene. */
+export function effectiveWindow(own, parent) {
+    if (!parent) return own;
+    const start = Math.max(own.start, parent.start);
+    return { start, duration: Math.max(0, Math.min(own.start + own.duration, parent.start + parent.duration) - start) };
+}
+
+/**
+ * Reparte la animación de un clip entre las dos mitades de un corte. La entrada que cruza el corte se recorta al
+ * tiempo que le toca a la primera mitad (si queda menos del mínimo se descarta); la salida que cruza el corte se
+ * recorta al de la segunda. Una fase que empieza tras el corte pasa a la segunda mitad con su retardo ajustado.
+ */
+export function splitAnimation(animation, before, after) {
+    const left = {}, right = {};
+    const { minDuration } = ANIMATION_LIMITS;
+    const entry = animation?.in, exit = animation?.out;
+    if (entry) {
+        const delay = entry.delay ?? 0;
+        if (delay >= before - EPS) right.in = { ...entry, delay: delay - before };
+        else if (Math.min(entry.duration, before - delay) >= minDuration - EPS) left.in = { ...entry, duration: Math.min(entry.duration, before - delay) };
+    }
+    if (exit) {
+        const room = after - (exit.delay ?? 0);
+        if (room >= exit.duration - EPS) right.out = { ...exit };
+        else if (room >= minDuration - EPS) right.out = { ...exit, duration: room };
+    }
+    return { left: fitAnimation(left, before), right: fitAnimation(right, after) };
+}
+
+const curves = {
+    linear: (p) => p,
+    ease_in: (p) => p * p,
+    ease_out: (p) => 1 - (1 - p) * (1 - p),
+    ease_in_out: (p) => (p < 0.5 ? 2 * p * p : 1 - (-2 * p + 2) ** 2 / 2),
+};
+const direction = { slide_left: [-1, 0], slide_right: [1, 0], slide_up: [0, -1], slide_down: [0, 1] };
+
+/**
+ * Estado animado en el instante local `time` de la página para un objeto con ventana `window` ({start, duration}).
+ * Sin animación devuelve la identidad: el resultado no cambia respecto a un documento sin esta función.
+ * Con `settled` (salida estática sin instante explícito) el objeto se ve como se diseñó: entradas completadas y
+ * salidas sin empezar. Los desplazamientos son fracciones del ancho/alto de la página.
+ */
+export function animationState(animation, time, window, { settled = false } = {}) {
+    if (!animation || settled) return IDENTITY;
+    let opacity = 1,
+        offsetX = 0,
+        offsetY = 0,
+        scale = 1;
+    const apply = (phase, away) => {
+        const [dx, dy] = direction[phase.type] ?? [0, 0];
+        opacity *= 1 - away;
+        offsetX += dx * away * ANIMATION_LIMITS.slideDistance;
+        offsetY += dy * away * ANIMATION_LIMITS.slideDistance;
+        if (phase.type === 'zoom') scale *= 1 - (1 - ANIMATION_LIMITS.zoomFrom) * away;
+    };
+    const progress = (phase, from) => Math.min(1, Math.max(0, (time - from) / phase.duration));
+    if (animation.in) {
+        const phase = animation.in;
+        apply(
+            phase,
+            1 - curves[phase.easing ?? ANIMATION_DEFAULT_EASING](progress(phase, window.start + (phase.delay ?? 0))),
+        );
+    }
+    if (animation.out) {
+        const phase = animation.out;
+        apply(
+            phase,
+            curves[phase.easing ?? ANIMATION_DEFAULT_EASING](
+                progress(phase, window.start + window.duration - span(phase)),
+            ),
+        );
+    }
+    return { opacity, offsetX, offsetY, scale };
+}
diff --git a/tests/Feature/Studio/StudioObjectAnimationTest.php b/tests/Feature/Studio/StudioObjectAnimationTest.php
