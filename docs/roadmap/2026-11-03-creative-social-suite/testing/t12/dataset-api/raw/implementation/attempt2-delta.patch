+    public function test_all_mcp_post_media_types_are_bounded_before_real_sdk_decoding(): void
+    {
+        $observed = [];
+        foreach (['text/plain', 'application/JSON', null, 'application/json'] as $mime) {
+            foreach ([null, '1'] as $length) {
+                $server = ['REQUEST_METHOD' => 'POST', 'REQUEST_URI' => '/mcp', 'HTTP_HOST' => 'localhost', 'HTTP_ACCEPT' => 'application/json, text/event-stream'];
+                if ($mime !== null) {
+                    $server['CONTENT_TYPE'] = $mime;
+                }
+                if ($length !== null) {
+                    $server['CONTENT_LENGTH'] = $length;
+                }
+                $request = new class([], [], [], [], [], $server, '{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{}}') extends Request
+                {
+                    public int $resourceReads = 0;
+
+                    public function getContent(bool $asResource = false)
+                    {
+                        if ($asResource) {
+                            $this->resourceReads++;
+                        }
+
+                        return parent::getContent($asResource);
+                    }
+                };
+                $beforeSdk = null;
+                $response = (new LimitStudioDatasetPayload)->handle($request, function ($bounded) use (&$beforeSdk) {
+                    $beforeSdk = $bounded->resourceReads;
+
+                    return (new ValidateMcpHeaders)->handle($bounded, function ($validated) {
+                        $transport = new HttpTransport($validated);
+                        $server = new SchedulerServer($transport);
+                        $server->start();
+
+                        return $transport->run();
+                    });
+                });
+                $this->assertSame(200, $response->getStatusCode());
+                $this->assertCount(30, json_decode($response->getContent(), true)['result']['tools']);
+                $observed[($mime ?? 'absent').'/'.($length ?? 'absent')] = $beforeSdk;
+            }
+        }
+        $this->assertSame(array_fill_keys(array_keys($observed), 1), $observed);
+    }
+
+    public function test_mcp_typed_shape_rejection_does_not_depend_on_content_type(): void
+    {
+        $observed = [];
+        foreach (['text/plain', 'application/JSON', null] as $mime) {
+            foreach (['rows_object', 'columns_object_numeric_keys'] as $shape) {
+                $table = $shape === 'rows_object' ? ['columns' => $this->table()['columns'], 'rows' => (object) []]
+                    : ['columns' => (object) ['0' => (object) $this->table()['columns'][0]], 'rows' => []];
+                $body = json_encode(['jsonrpc' => '2.0', 'id' => 1, 'method' => 'tools/call', 'params' => ['name' => 'manage_studio_dataset', 'arguments' => ['action' => 'create', 'brand_id' => $this->brand->id, 'name' => 'Must reject shape', 'table' => $table]]], JSON_THROW_ON_ERROR);
+                $server = ['REQUEST_METHOD' => 'POST', 'REQUEST_URI' => '/mcp', 'HTTP_HOST' => 'localhost', 'HTTP_ACCEPT' => 'application/json, text/event-stream', 'HTTP_AUTHORIZATION' => 'Bearer '.$this->key];
+                if ($mime !== null) {
+                    $server['CONTENT_TYPE'] = $mime;
+                }
+                app('auth')->forgetGuards();
+                $response = app(\Illuminate\Contracts\Http\Kernel::class)->handle(new Request([], [], [], [], [], $server, $body));
+                $this->assertSame(200, $response->getStatusCode());
+                $observed[($mime ?? 'absent').'/'.$shape] = json_decode($response->getContent(), true)['result']['isError'] ?? false;
+            }
+        }
+        $this->assertSame(array_fill_keys(array_keys($observed), true), $observed);
+    }
