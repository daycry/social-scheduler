{
  "source": "https://developers.google.com/youtube/data/reference/rest/v3/errors",
  "method": "POST",
  "host": "www.googleapis.com",
  "path": "/upload/youtube/v3/videos",
  "query": {
    "uploadType": "resumable",
    "part": "snippet,status"
  },
  "status": 403,
  "headers": {},
