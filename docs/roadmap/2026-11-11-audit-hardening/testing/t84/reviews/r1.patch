+<?php
+
+/*
+| Exportación completa de los datos del usuario en un ZIP (T-84, F-10). Documentada en docs/usuario/exportar.md y en docs/modulos/despliegue.md.
+|
+| El ZIP se genera en cola, se guarda en un disco PRIVADO (nunca el público) y se borra al caducar (`exports:prune`, cada hora).
+*/
+return [
+    // Disco privado donde viven los ZIP. Debe ser un disco que no sirva ficheros por URL pública.
+    'disk' => env('EXPORTS_DISK', 'local'),
+
+    // Cola del job. Por defecto `media`, que ya tiene worker en todos los despliegues.
+    'queue' => env('EXPORTS_QUEUE', 'media'),
+
+    // Segundos máximos del job. Debe ser menor que `--timeout` del worker y que `retry_after` de la cola (ver despliegue.md): para archivos
+    // grandes, usa un worker propio con más margen y sube estos tres valores a la vez.
+    'timeout' => (int) env('EXPORTS_TIMEOUT', 110),
+
+    // Tope de tamaño del ZIP (bytes del ZIP ya comprimido). Si se supera, la exportación termina en error y no se publica nada. Máximo 4 000 000 000
+    // (sin ZIP64).
+    'max_bytes' => (int) env('EXPORTS_MAX_BYTES', 1_073_741_824),
+
+    // Horas que se conserva el ZIP desde que está listo; después `exports:prune` borra el fichero.
+    'retention_hours' => (int) env('EXPORTS_RETENTION_HOURS', 72),
+
+    // Minutos de validez del enlace firmado de descarga. Se genera uno nuevo al pulsar «Descargar».
+    'link_minutes' => (int) env('EXPORTS_LINK_MINUTES', 10),
+
+    // Minutos tras los que una exportación en curso sin avances se da por atascada (worker caído): `exports:prune` la marca en error y libera el cupo.
+    'stuck_minutes' => (int) env('EXPORTS_STUCK_MINUTES', 30),
+];
