+test('proportional endpoint addition remains contained when the remaining span rounds upward', () => {
+    const size = 3728.5800000000004;
+    for (const kind of ['bar-proportional', 'column-proportional']) {
+        const source = data([[129, null, 533]]);
+        const result = geometry(source, { kind, width: size, height: size });
+        assert.ok(result.bars.every(b => b.x + b.width <= size && b.y + b.height <= size));
+        assert.deepEqual(result.domain, { min: 0, max: 100 });
+        assert.deepEqual(result.bars.map(b => [b.raw, b.value]), [['129', 129], ['533', 533]]);
+        assert.equal(result.bars[0].start, 0); assert.equal(result.bars[1].end, 100);
+        near(result.bars[0].end, 129 / 662 * 100); near(result.bars[1].start, 129 / 662 * 100);
+        near(result.bars[0].percentage, 129 / 662 * 100); near(result.bars[1].percentage, 533 / 662 * 100);
+        assert.equal(source.snapshot.table.rows[0].values[3].raw, '533');
+    }
