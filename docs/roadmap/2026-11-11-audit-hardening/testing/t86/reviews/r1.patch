+
+/**
+ * Preferencias de avisos por tipo (T-86): resumen semanal (y su parrafo de IA) y recordatorio previo de publicacion manual. El correo global
+ * (`notify_by_mail`) sigue en el perfil. La baja del resumen desde el correo es un enlace firmado de un clic, igual que la de los informes
+ * programados: el GET solo confirma (sin efectos, para que escaneres y prefetchers de correo no den de baja a nadie) y el POST firmado
+ * (RFC 8058, fuera de CSRF en `bootstrap/app.php`) desactiva el resumen de ESE usuario. Idempotente.
+ */
+class NotificationPreferenceController extends Controller
+{
+    public function update(Request $request): RedirectResponse
+    {
+        $request->user()->update($request->validate([
+            'notify_weekly_digest' => ['required', 'boolean'],
+            'weekly_digest_ai' => ['required', 'boolean'],
+            'notify_manual_reminder' => ['required', 'boolean'],
+        ]));
+
+        return to_route('profile.notifications')->with('success', 'Preferencias de avisos guardadas.');
+    }
+
+    public function confirmUnsubscribe(Request $request, int $user): HttpResponse
+    {
+        return response()->view('notifications.digest-unsubscribe', ['done' => false, 'action' => $request->fullUrl()], 200, ['X-Robots-Tag' => 'noindex']);
+    }
+
+    public function unsubscribe(int $user): HttpResponse
+    {
+        User::query()->whereKey($user)->update(['notify_weekly_digest' => false]);
+
+        return response()->view('notifications.digest-unsubscribe', ['done' => true, 'action' => ''], 200, ['X-Robots-Tag' => 'noindex']);
+    }
+}
diff --git a/app/Jobs/SendWeeklyDigest.php b/app/Jobs/SendWeeklyDigest.php
new file mode 100644
index 0000000..d7ccd25
--- /dev/null
+++ b/app/Jobs/SendWeeklyDigest.php
@@ -0,0 +1,83 @@
+<?php
+
+namespace App\Jobs;
+
+use App\Mail\WeeklyDigest as WeeklyDigestMail;
+use App\Models\User;
+use App\Notifications\WeeklyDigestReady;
+use App\Services\WeeklyDigest;
+use Carbon\CarbonImmutable;
+use Illuminate\Contracts\Queue\ShouldQueue;
+use Illuminate\Foundation\Queue\Queueable;
+use Illuminate\Queue\InteractsWithQueue;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Mail;
+use Illuminate\Support\Facades\URL;
+use Throwable;
+
+/**
+ * Resumen semanal (T-86): se programa cada hora y, para cada usuario que lo tiene activado, envia el de la semana anterior cuando en SU
+ * zona (la de su marca principal) es lunes y ya han pasado las 08:00. Idempotente: `WeeklyDigest::claim()` reserva la semana con un UPDATE
+ * condicionado, asi una segunda pasada (o un job en paralelo) no repite el envio. El aviso en la app se envia siempre (y por push, lo gestiona
+ * `QueuePushNotification`); el correo solo con `notify_by_mail`. Cola `reports`, sin reintentos: la siguiente pasada de la hora ya reintenta
+ * lo que quedo sin reclamar.
+ */
+class SendWeeklyDigest implements ShouldQueue
+{
+    use InteractsWithQueue, Queueable;
+
+    public int $timeout = 100;
+
+    public int $tries = 1;
+
+    public function __construct()
+    {
+        $this->onQueue((string) config('reports.queue', 'reports'));
+    }
+
+    public function handle(WeeklyDigest $digest): void
+    {
+        $now = now()->toImmutable();
+
+        User::query()->where('notify_weekly_digest', true)->whereNotNull('email_verified_at')
+            ->eachById(fn (User $user) => $this->send($digest, $user, $now));
+    }
+
+    private function send(WeeklyDigest $digest, User $user, CarbonImmutable $now): void
+    {
+        $zone = $digest->zoneFor($user);
+        $week = $zone === null ? null : $digest->dueWeek($zone, $now);
+        $previous = $user->weekly_digest_sent_for?->format('Y-m-d');
+
+        if ($week === null || ! $digest->claim($user, $week)) {
+            return;
+        }
+
+        try {
+            $data = $digest->build($user, $zone, $now);
+            $user->notify(new WeeklyDigestReady($data));
+        } catch (Throwable $e) {
+            // Nada llego al usuario: se devuelve la semana para que la siguiente pasada de la hora lo intente de nuevo.
+            $digest->release($user, $week, $previous);
+            Log::error('weekly_digest.failed', ['user_id' => $user->id, 'exception' => $e::class]);
+
+            return;
+        }
+
+        if (! $user->notify_by_mail) {
+            return;
+        }
+
+        // El aviso ya esta entregado: un fallo del correo se registra pero no devuelve la semana (duplicaria el aviso de la app).
+        try {
+            Mail::to($user)->send(new WeeklyDigestMail(
+                $data,
+                URL::signedRoute('digest.unsubscribe', ['user' => $user->id]),
+                route('profile.notifications'),
+                route('dashboard'),
+            ));
+        } catch (Throwable $e) {
+            Log::error('weekly_digest.mail_failed', ['user_id' => $user->id, 'exception' => $e::class]);
+        }
+    }
+}
