+
+    // La misma clave con otro cuerpo no se acepta.
+    confirmPlan(['idempotency_key' => 'plan-doble-clic', 'items' => [['scheduled_at' => '2026-12-09T09:00', 'account_ids' => [$this->bs->id], 'text' => 'Otro']]])->assertStatus(422)->assertJsonPath('message', fn ($m) => str_contains($m, 'otro contenido'));
+    expect(postCount())->toBe(2);
