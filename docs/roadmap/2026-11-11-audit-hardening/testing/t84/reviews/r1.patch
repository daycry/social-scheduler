@@ -0,0 +1,120 @@
+<?php
+
+namespace App\Services\Export;
+
+use RuntimeException;
+
+/**
+ * Escritor ZIP en streaming (T-84): cada entrada se comprime con deflate a medida que se lee (descriptor de datos tras el contenido), así
+ * que nunca se carga un fichero entero en memoria ni hace falta conocer su tamaño antes. No depende de `ext-zip` (solo de zlib). Sin ZIP64:
+ * el tope de bytes y de entradas se comprueba mientras se escribe y lanza `ExportTooLarge`. Devuelve de cada entrada su tamaño y su SHA-256
+ * para el manifiesto.
+ */
+final class ZipStream
+{
+    /** Límite del formato sin ZIP64. */
+    public const FORMAT_MAX_BYTES = 4_000_000_000;
+
+    private const MAX_ENTRIES = 65000;
+
+    /** @var resource */
+    private $handle;
+
+    /** @var list<array{name: string, crc: int, compressed: int, size: int, offset: int}> */
+    private array $entries = [];
+
+    private int $offset = 0;
+
+    private int $maxBytes;
+
+    private int $dosTime;
+
+    private int $dosDate;
+
+    /** @param  resource  $handle  Flujo de escritura del ZIP. */
+    public function __construct($handle, int $maxBytes)
+    {
+        $this->handle = $handle;
+        $this->maxBytes = min($maxBytes, self::FORMAT_MAX_BYTES);
+        $now = getdate();
+        $this->dosTime = ($now['hours'] << 11) | ($now['minutes'] << 5) | intdiv($now['seconds'], 2);
+        $this->dosDate = ((max(1980, $now['year']) - 1980) << 9) | ($now['mon'] << 5) | $now['mday'];
+    }
+
+    /** @return array{size: int, sha256: string} */
+    public function addString(string $name, string $content): array
+    {
+        $stream = fopen('php://temp/maxmemory:8388608', 'w+b');
+        fwrite($stream, $content);
+        rewind($stream);
+        try {
+            return $this->addStream($name, $stream);
+        } finally {
+            fclose($stream);
+        }
+    }
+
+    /**
+     * @param  resource  $source
+     * @return array{size: int, sha256: string}
+     */
+    public function addStream(string $name, $source): array
+    {
+        if (count($this->entries) >= self::MAX_ENTRIES) {
+            throw new ExportTooLarge('Demasiados ficheros para un único ZIP.');
+        }
+        $offset = $this->offset;
+        $this->write(pack('VvvvvvVVVvv', 0x04034B50, 20, 0x0808, 8, $this->dosTime, $this->dosDate, 0, 0, 0, strlen($name), 0).$name);
+        $deflate = deflate_init(ZLIB_ENCODING_RAW, ['level' => 1]);
+        $crc = hash_init('crc32b');
+        $sha = hash_init('sha256');
+        $size = 0;
+        $compressed = 0;
+        while (! feof($source)) {
+            $chunk = fread($source, 1_048_576);
+            if ($chunk === false) {
+                throw new RuntimeException('No se pudo leer un fichero para el ZIP.');
+            }
+            if ($chunk === '') {
+                continue;
+            }
+            hash_update($crc, $chunk);
+            hash_update($sha, $chunk);
+            $size += strlen($chunk);
+            $compressed += $this->write((string) deflate_add($deflate, $chunk, ZLIB_NO_FLUSH));
+        }
+        $compressed += $this->write((string) deflate_add($deflate, '', ZLIB_FINISH));
+        $crcValue = (int) hexdec(hash_final($crc));
+        $this->write(pack('VVVV', 0x08074B50, $crcValue, $compressed, $size));
+        $this->entries[] = ['name' => $name, 'crc' => $crcValue, 'compressed' => $compressed, 'size' => $size, 'offset' => $offset];
+
+        return ['size' => $size, 'sha256' => hash_final($sha)];
+    }
+
+    /** Escribe el directorio central y devuelve el tamaño total del ZIP. */
+    public function finish(): int
+    {
+        $start = $this->offset;
+        foreach ($this->entries as $entry) {
+            $this->write(pack('VvvvvvvVVVvvvvvVV', 0x02014B50, 20, 20, 0x0808, 8, $this->dosTime, $this->dosDate, $entry['crc'], $entry['compressed'], $entry['size'], strlen($entry['name']), 0, 0, 0, 0, 0, $entry['offset']).$entry['name']);
+        }
+        $count = count($this->entries);
+        $this->write(pack('VvvvvVVv', 0x06054B50, 0, 0, $count, $count, $this->offset - $start, $start, 0));
+
+        return $this->offset;
+    }
+
+    private function write(string $bytes): int
+    {
+        $length = strlen($bytes);
+        if ($this->offset + $length > $this->maxBytes) {
+            throw new ExportTooLarge('El archivo supera el tamaño máximo permitido.');
+        }
+        if ($length > 0 && fwrite($this->handle, $bytes) !== $length) {
+            throw new RuntimeException('No se pudo escribir el ZIP (¿disco lleno?).');
+        }
+        $this->offset += $length;
+
+        return $length;
+    }
+}
