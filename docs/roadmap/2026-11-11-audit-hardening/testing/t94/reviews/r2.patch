@@ -0,0 +1,147 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { parse } from '@babel/parser';
+import { animationState, splitAnimation } from '../../resources/js/Studio/object-animation.js';
+import { applyElementAnimation } from '../../resources/js/Studio/animation-scene.js';
+import { blankDocument, newElement, validateDocument } from '../../resources/js/Studio/document.js';
+import { clipMediaState, compileTimeline, restrictElementWindow, sampleTimeline, splitTimelineElement } from '../../resources/js/Studio/timeline.js';
+
+const near = (actual, expected, message) => assert.ok(Math.abs(actual - expected) < 1e-9, `${message ?? ''} ${actual} != ${expected}`);
+const window = { start: 1, duration: 4 };
+
+function scene(animation, timing = window) {
+    const doc = blankDocument(320, 180);
+    doc.schema_version = 2;
+    doc.timeline = { fps: 30, audio_tracks: [] };
+    doc.pages[0].duration = 6;
+    doc.pages[0].elements = [newElement('text', { id: 'title', text: 'Hola', ...(timing ? { timing } : {}), ...(animation ? { animation } : {}) })];
+    return doc;
+}
+
+function fakeObject() {
+    return {
+        left: 10, top: 20, scaleX: 2, scaleY: 2, opacity: 0.8, dirty: false,
+        getRelativeCenterPoint() { return { x: this.left + 50, y: this.top + 25 }; },
+        set(values) { Object.assign(this, values); },
+        setPositionByOrigin(point) { this.left = point.x - 50; this.top = point.y - 25; },
+        setCoords() {},
+    };
+}
+
+test('settled state is the identity: designed look with entrances completed and exits not started', () => {
+    const animation = { in: { type: 'zoom', duration: 1 }, out: { type: 'slide_left', duration: 1 } };
+    for (const time of [1, 1.5, 4.5]) assert.deepEqual(animationState(animation, time, window, { settled: true }), { opacity: 1, offsetX: 0, offsetY: 0, scale: 1 });
+    assert.notDeepEqual(animationState(animation, 1, window), animationState(animation, 1, window, { settled: true }));
+});
+
+test('settled applications leave the object untouched even with an animation', () => {
+    const object = fakeObject(), before = JSON.stringify(object);
+    applyElementAnimation(object, { timing: window, animation: { in: { type: 'fade', duration: 1 } } }, 1, { width: 320, height: 180, pageDuration: 6, settled: true });
+    assert.equal(JSON.stringify(object), before);
+});
+
+test('a child inside a group animates over the window shared with the group and hands that window on', () => {
+    const size = { width: 320, height: 180, pageDuration: 6 };
+    const groupWindow = applyElementAnimation(fakeObject(), { timing: { start: 1, duration: 3 } }, 2, size);
+    assert.deepEqual(groupWindow, { start: 1, duration: 3 });
+    const child = { timing: { start: 0, duration: 6 }, animation: { in: { type: 'fade', duration: 1, easing: 'linear' } } };
+    const object = fakeObject();
+    assert.deepEqual(applyElementAnimation(object, child, 1.5, { ...size, parent: groupWindow }), { start: 1, duration: 3 });
+    near(object.opacity, 0.8 * 0.5, 'la entrada del hijo parte del inicio común, no del suyo');
+});
+
+test('ungrouping hands the group animation to the children that lack the phase and keeps their own', () => {
+    const child = scene({ out: { type: 'zoom', duration: 0.5 } }).pages[0].elements[0];
+    const parentAnimation = { in: { type: 'fade', duration: 1 }, out: { type: 'slide_left', duration: 1 } };
+    const result = restrictElementWindow(child, { start: 0, duration: 6 }, { pageDuration: 6, parentAnimation });
+    assert.deepEqual(result.animation, { in: { type: 'fade', duration: 1 }, out: { type: 'zoom', duration: 0.5 } });
+    const bare = restrictElementWindow({ ...child, animation: undefined }, { start: 1, duration: 0.5 }, { pageDuration: 6, parentAnimation });
+    assert.equal(Object.hasOwn(bare, 'animation'), false, 'lo que no cabe en la ventana común se descarta');
+});
+
+test('splitting inside a phase trims it to the time each half owns', () => {
+    const animation = { in: { type: 'fade', duration: 2, delay: 0.5 }, out: { type: 'zoom', duration: 2, delay: 0.5 } };
+    const cross = splitAnimation(animation, 2, 4);
+    assert.deepEqual(cross.left, { in: { type: 'fade', duration: 1.5, delay: 0.5 } });
+    assert.deepEqual(cross.right, { out: { type: 'zoom', duration: 2, delay: 0.5 } });
+    assert.deepEqual(splitAnimation({ out: { type: 'zoom', duration: 2, delay: 0.5 } }, 4, 2).right, { out: { type: 'zoom', duration: 1.5, delay: 0.5 } });
+    assert.deepEqual(splitAnimation({ in: { type: 'fade', duration: 1, delay: 3 } }, 2, 4).right, { in: { type: 'fade', duration: 1, delay: 1 } });
+    assert.equal(splitAnimation({ in: { type: 'fade', duration: 1, delay: 1.95 } }, 2, 4).left, null);
+});
+
+test('splitting a clip in the middle of its entrance keeps the visible part on the first half', () => {
+    const doc = scene({ in: { type: 'fade', duration: 2 } });
+    const result = splitTimelineElement(doc, doc.pages[0].id, 'title', 2, { createId: () => 'second_half' });
+    assert.deepEqual(result.pages[0].elements[0].animation, { in: { type: 'fade', duration: 1 } });
+    assert.equal(Object.hasOwn(result.pages[0].elements[1], 'animation'), false);
+});
+
+test('a short clip can be animated: the default duration is whatever fits, never below 0.1 s', async () => {
+    const { ref } = await import('vue');
+    const { useTimelineEditing } = await import('../../resources/js/Studio/composables/useTimelineEditing.js');
+    const doc = scene(null, { start: 1, duration: 0.3 });
+    const documentData = ref(doc), page = ref(doc.pages[0]);
+    const editing = useTimelineEditing({
+        documentData, page, pageId: ref(doc.pages[0].id), selection: ref([{ id: 'title' }]), localAssets: ref([]),
+        timeline: ref(0), timelineDuration: ref(6), timelinePageStart: ref(0), timelineOpen: ref(true), pauseTimeline() {}, error: ref(''),
+        run: fn => fn(), commit() {}, reloadCanvas: async () => {}, selectOnCanvas() {}, isCaptionBlocked: () => false,
+    });
+    await editing.patchClipAnimation({ phase: 'in', patch: { type: 'zoom' } });
+    assert.equal(documentData.value.pages[0].elements[0].animation.in.duration, 0.3);
+});
+
+const loadBody = async relative => (await readFile(new URL('../../' + relative, import.meta.url), 'utf8')).replace(/^import .*;\r?\n/gm, '')
+    .replaceAll('export async function', 'async function').replaceAll('export function', 'function').replaceAll('export const', 'const');
+const AsyncFunction = Object.getPrototypeOf(async function () {}).constructor;
+
+test('static frames render animations settled unless the page has an explicit instant', async () => {
+    const body = await loadBody('resources/js/Studio/exports.js');
+    const calls = [];
+    const rendered = { canvas: { backgroundColor: '', renderAll() {}, toSVG: () => '<svg/>', getObjects: () => [], getZoom: () => 1 }, fontFaces: () => [], async dispose() {} };
+    const factory = new AsyncFunction('validateDocument', 'frameTimes', 'renderStudioFrame', 'StudioDocumentError', body + ';return exportPage;');
+    const exportPage = await factory(x => x, () => new Map([['p', 0]]), async (...args) => { calls.push(args[5].settled); return rendered; }, Error);
+    const design = { width: 100, height: 100, pages: [] };
+    await exportPage(design, 'p', [], { format: 'svg' });
+    await exportPage(design, 'p', [], { format: 'svg', frame_times: [{ page_id: 'p', time: 0 }] });
+    await exportPage(design, 'p', [], { format: 'svg', frame_times: [{ page_id: 'other', time: 0 }] });
+    assert.deepEqual(calls, [true, false, true]);
+});
+
+test('renderStudioFrame applies animations at its instant, none when settled, and never forwards the flag to the page renderer', async () => {
+    const body = await loadBody('resources/js/Studio/frame-renderer.js');
+    const applied = [];
+    let received;
+    const rendered = { canvas: { getObjects: () => [{ id: 1 }], renderAll() {} }, async dispose() {} };
+    const run = new AsyncFunction('renderStudioPage', 'frameElements', 'compileTimeline', 'attachFrameCaptions', 'applyElementAnimation', body + ';return renderStudioFrame;');
+    const frame = await run(async (...args) => { received = args; return rendered; }, x => x, () => ({ pages: [{ id: 'p', start: 0 }] }), async s => s,
+        (_object, _layer, time, options) => { applied.push([time, options.settled]); });
+    const doc = { schema_version: 2, width: 100, height: 100, timeline: { fps: 30 }, pages: [{ id: 'p', duration: 4, elements: [{ id: 'a', type: 'rect', animation: { in: { type: 'fade', duration: 1 } } }] }] };
+    await frame(doc, 'p', 0.5, [], [], {});
+    await frame(doc, 'p', 0.5, [], [], { settled: true });
+    assert.deepEqual(applied, [[0.5, false], [0.5, true]]);
+    assert.equal(Object.hasOwn(received[4], 'settled'), false);
+});
+
+test('the offline project render (MP4/GIF) applies the animation of each object at every sampled instant', async () => {
+    const source = await readFile(new URL('../../resources/js/Studio/timeline-preview.js', import.meta.url), 'utf8');
+    const factory = parse(source, { sourceType: 'module' }).program.body.find(node => node.type === 'ExportNamedDeclaration' && node.declaration?.id?.name === 'createTimelinePreview').declaration;
+    const instantiate = Function('validateDocument', 'renderStudioPage', 'seekVideoFrame', 'videoFrameReady', 'clipMediaState', 'compileTimeline', 'sampleTimeline',
+        'createTimelineAudio', 'createCaptionLayer', 'assertChartDocumentBudget', 'applyElementAnimation', `return (${source.slice(factory.start, factory.end)});`);
+    const doc = scene({ in: { type: 'fade', duration: 1, easing: 'linear' } });
+    const object = fakeObject();
+    const seen = [];
+    const create = instantiate(validateDocument, async () => ({ canvas: { getObjects: () => [object], renderAll() {}, lowerCanvasEl: {} }, async dispose() {} }),
+        async () => {}, async () => {}, clipMediaState, compileTimeline, sampleTimeline,
+        () => ({ prepare: async () => ({ bufferingMs: 0 }), pause() {}, pauseMedia() {}, play: async () => {}, state: () => [], dispose: async () => {} }),
+        async () => null, async () => {},
+        (target, element, time, options) => { const result = applyElementAnimation(target, element, time, options); seen.push([time, target.opacity]); return result; });
+    const context = { clearRect() {}, save() {}, restore() {}, drawImage() {}, fillRect() {} };
+    const preview = await create({ getContext: () => context }, { document: doc, offline: true });
+    await preview.seek(1.5);
+    await preview.seek(3);
+    await preview.dispose();
+    assert.equal(seen.length, 2);
+    near(seen[0][0], 1.5); near(seen[0][1], 0.8 * 0.5, 'a mitad de la entrada');
+    near(seen[1][0], 3); near(seen[1][1], 0.8, 'tras la entrada');
+});
diff --git a/tests/frontend/studio-object-animation.test.mjs b/tests/frontend/studio-object-animation.test.mjs
new file mode 100644
index 0000000..5c5a236
--- /dev/null
+++ b/tests/frontend/studio-object-animation.test.mjs
@@ -0,0 +1,184 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { animationState, fitAnimation, normalizeAnimation } from '../../resources/js/Studio/object-animation.js';
+import { applyElementAnimation } from '../../resources/js/Studio/animation-scene.js';
+import { blankDocument, newElement, validateDocument } from '../../resources/js/Studio/document.js';
+import { restrictElementWindow, splitTimelineElement } from '../../resources/js/Studio/timeline.js';
+
+const near = (actual, expected, message) =>
+    assert.ok(Math.abs(actual - expected) < 1e-9, `${message ?? ''} ${actual} != ${expected}`);
+const window = { start: 1, duration: 4 };
+
+function scene(animation, timing = window) {
+    const doc = blankDocument(320, 180);
+    doc.schema_version = 2;
+    doc.timeline = { fps: 30, audio_tracks: [] };
+    doc.pages[0].duration = 6;
+    doc.pages[0].elements = [
+        newElement('text', {
+            id: 'title',
+            text: 'Hola',
+            ...(timing ? { timing } : {}),
+            ...(animation ? { animation } : {}),
+        }),
+    ];
+    return doc;
+}
+
+test('without animation the state is the identity, so old designs render as before', () => {
+    for (const time of [0, 1, 2.5, 5])
+        assert.deepEqual(animationState(undefined, time, window), { opacity: 1, offsetX: 0, offsetY: 0, scale: 1 });
+});
+
+test('fade in: hidden before the entry, half way at the middle, fully visible at the end', () => {
+    const animation = { in: { type: 'fade', duration: 1, delay: 0.5, easing: 'linear' } };
+    near(animationState(animation, 1.2, window).opacity, 0, 'antes de la entrada');
+    near(animationState(animation, 1.5, window).opacity, 0, 'inicio de la entrada');
+    near(animationState(animation, 2, window).opacity, 0.5, 'mitad');
+    near(animationState(animation, 2.5, window).opacity, 1, 'fin');
+    near(animationState(animation, 4, window).opacity, 1, 'después');
+});
+
+test('fade out ends at the end of the window minus the delay and stays hidden afterwards', () => {
+    const animation = { out: { type: 'fade', duration: 1, delay: 0.5, easing: 'linear' } };
+    near(animationState(animation, 3.5, window).opacity, 1, 'antes de la salida');
+    near(animationState(animation, 4, window).opacity, 0.5, 'mitad de la salida');
+    near(animationState(animation, 4.5, window).opacity, 0, 'fin de la salida');
+    near(animationState(animation, 4.9, window).opacity, 0, 'retardo final');
+});
+
+test('slides move from and towards their side by a quarter of the page, zoom scales from half', () => {
+    const slide = (type) => animationState({ in: { type, duration: 1, easing: 'linear' } }, 1, window);
+    assert.deepEqual([slide('slide_left').offsetX, slide('slide_left').offsetY], [-0.25, 0]);
+    assert.deepEqual([slide('slide_right').offsetX, slide('slide_right').offsetY], [0.25, 0]);
+    assert.deepEqual([slide('slide_up').offsetX, slide('slide_up').offsetY], [0, -0.25]);
+    assert.deepEqual([slide('slide_down').offsetX, slide('slide_down').offsetY], [0, 0.25]);
+    near(animationState({ in: { type: 'zoom', duration: 1, easing: 'linear' } }, 1, window).scale, 0.5, 'zoom inicial');
+    near(
+        animationState({ in: { type: 'zoom', duration: 1, easing: 'linear' } }, 1.5, window).scale,
+        0.75,
+        'zoom a mitad',
+    );
+    const out = animationState({ out: { type: 'slide_left', duration: 1, easing: 'linear' } }, 5, window);
+    near(out.offsetX, -0.25, 'la salida se va hacia su lado');
+    near(out.opacity, 0, 'la salida termina transparente');
+});
+
+test('easing curves keep the endpoints and differ in the middle', () => {
+    const at = (easing) => animationState({ in: { type: 'fade', duration: 1, easing } }, 1.25, window).opacity;
+    near(at('linear'), 0.25);
+    assert.ok(at('ease_in') < 0.25 && at('ease_out') > 0.25 && at('ease_in_out') < 0.25);
+    for (const easing of ['linear', 'ease_in', 'ease_out', 'ease_in_out']) {
+        near(animationState({ in: { type: 'fade', duration: 1, easing } }, 1, window).opacity, 0, easing);
+        near(animationState({ in: { type: 'fade', duration: 1, easing } }, 2, window).opacity, 1, easing);
+    }
+});
+
+test('the document validator accepts valid animations and rejects the invalid ones', () => {
+    const valid = {
+        in: { type: 'slide_left', duration: 0.5, delay: 0.25, easing: 'ease_out' },
+        out: { type: 'zoom', duration: 1 },
+    };
+    assert.deepEqual(validateDocument(scene(valid)).pages[0].elements[0].animation, valid);
+    assert.equal(Object.hasOwn(validateDocument(scene(null)).pages[0].elements[0], 'animation'), false);
+    const bad = [
+        { in: { type: 'spin', duration: 1 } },
+        { in: { type: 'fade', duration: 0.01 } },
+        { in: { type: 'fade', duration: 11 } },
+        { in: { type: 'fade', duration: 1, delay: -1 } },
+        { in: { type: 'fade', duration: 1, easing: 'bounce' } },
+        { in: { type: 'fade', duration: 1, extra: 1 } },
+        { middle: { type: 'fade', duration: 1 } },
+        {},
+        { in: { type: 'fade', duration: 3, delay: 1.5 } },
+        { in: { type: 'fade', duration: 2 }, out: { type: 'fade', duration: 2.5 } },
+    ];
+    for (const animation of bad)
+        assert.throws(
+            () => validateDocument(scene(animation)),
+            /animaci|propiedad|duraci|retardo|tipo|curva|entrada|caben/i,
+            JSON.stringify(animation),
+        );
+});
+
+test('v1 documents still reject animations', () => {
+    const doc = scene({ in: { type: 'fade', duration: 1 } }, null);
+    doc.schema_version = 1;
+    delete doc.timeline;
+    assert.throws(() => validateDocument(doc), /animation|propiedad/);
+});
+
+test('fitAnimation drops the phases that no longer fit and normalizeAnimation checks the object life', () => {
+    const animation = { in: { type: 'fade', duration: 1 }, out: { type: 'fade', duration: 2 } };
+    assert.deepEqual(fitAnimation(animation, 3), animation);
+    assert.deepEqual(fitAnimation(animation, 2), { in: animation.in });
+    assert.equal(fitAnimation(animation, 0.5), null);
+    assert.throws(() => normalizeAnimation(animation, 2.9, 'animation'), /caben/);
+});
+
+test('splitting a clip keeps the entry on the first half and the exit on the second', () => {
+    const doc = scene({ in: { type: 'fade', duration: 0.5 }, out: { type: 'zoom', duration: 0.5 } });
+    const result = splitTimelineElement(doc, doc.pages[0].id, 'title', 3, { createId: () => 'second_half' });
+    const [left, right] = result.pages[0].elements;
+    assert.deepEqual(left.animation, { in: { type: 'fade', duration: 0.5 } });
+    assert.deepEqual(right.animation, { out: { type: 'zoom', duration: 0.5 } });
+});
+
+test('restricting a window removes only the phases that do not fit', () => {
+    const element = scene({ in: { type: 'fade', duration: 1 }, out: { type: 'fade', duration: 1 } }).pages[0]
+        .elements[0];
+    const result = restrictElementWindow(element, { start: 1, duration: 1.5 }, { pageDuration: 6 });
+    assert.deepEqual(result.animation, { in: { type: 'fade', duration: 1 } });
+    assert.equal(
+        Object.hasOwn(restrictElementWindow(element, { start: 1, duration: 0.5 }, { pageDuration: 6 }), 'animation'),
+        false,
+    );
+});
+
+function fakeObject() {
+    const object = {
+        left: 10,
+        top: 20,
+        scaleX: 2,
+        scaleY: 2,
+        opacity: 0.8,
+        dirty: false,
+        getRelativeCenterPoint() {
+            return { x: this.left + 50, y: this.top + 25 };
+        },
+        set(values) {
+            Object.assign(this, values);
+        },
+        setPositionByOrigin(point) {
+            this.left = point.x - 50;
+            this.top = point.y - 25;
+        },
+        setCoords() {},
+    };
+    return object;
+}
+
+test('applying the state starts from the stored base and does not accumulate when repeated', () => {
+    const element = { timing: window, animation: { in: { type: 'slide_right', duration: 1, easing: 'linear' } } };
+    const size = { width: 320, height: 180, pageDuration: 6 };
+    const object = fakeObject();
+    applyElementAnimation(object, element, 1, size);
+    near(object.opacity, 0);
+    near(object.left, 10 + 0.25 * 320);
+    applyElementAnimation(object, element, 1.5, size);
+    applyElementAnimation(object, element, 1.5, size);
+    near(object.opacity, 0.4);
+    near(object.left, 10 + 0.125 * 320);
+    applyElementAnimation(object, element, 3, size);
+    near(object.opacity, 0.8);
+    near(object.left, 10);
+    near(object.top, 20);
+});
+
+test('an element without animation leaves its object untouched', () => {
+    const object = fakeObject();
+    const before = JSON.stringify(object);
+    applyElementAnimation(object, { timing: window }, 1.5, { width: 320, height: 180, pageDuration: 6 });
+    assert.equal(JSON.stringify(object), before);
+    assert.equal(object.studioAnimationBase, undefined);
+});
