+<?php
+
+namespace App\Notifications;
+
+use Illuminate\Bus\Queueable;
+use Illuminate\Contracts\Queue\ShouldQueue;
+use Illuminate\Notifications\Messages\MailMessage;
+use Illuminate\Notifications\Notification;
+
+/**
+ * Aviso (T-84) de que la exportación completa de datos está lista. Siempre en la app (`database`) y por correo solo si el usuario lo activó
+ * (`notify_by_mail`). No lleva enlace de descarga (un correo reenviado no debe dar acceso): enlaza a la página, que genera el enlace firmado
+ * al pulsar «Descargar». Mismo contrato que los demás avisos: `type`, `title`, `message` y un `url` relativo.
+ */
+class FullExportReady extends Notification implements ShouldQueue
+{
+    use Queueable;
+
+    public int $tries = 3;
+
+    public int $backoff = 120;
+
+    public function __construct(public readonly int $exportId)
+    {
+        $this->onQueue((string) config('social.refresh_queue', 'poll'));
+    }
+
+    /** @return list<string> */
+    public function via(object $notifiable): array
+    {
+        return $notifiable->notify_by_mail ? ['database', 'mail'] : ['database'];
+    }
+
+    public function toMail(object $notifiable): MailMessage
+    {
+        return (new MailMessage)->subject($this->title())->line($this->title().'.')->line($this->message())->action('Ir a mi exportación', route('profile.export'));
+    }
+
+    /** @return array<string, mixed> */
+    public function toArray(object $notifiable): array
+    {
+        return [
+            'type' => 'job_done_full_export',
+            'title' => $this->title(),
+            'message' => $this->message(),
+            'excerpt' => '',
+            'brand_id' => null,
+            'url' => route('profile.export', [], false),
+        ];
+    }
+
+    private function title(): string
+    {
+        return 'Tu exportación de datos está lista';
+    }
+
+    private function message(): string
+    {
+        return 'Ya puedes descargar el ZIP con tus datos. Estará disponible '.(int) config('exports.retention_hours').' horas.';
+    }
+}
