diff --git a/app/Services/Webhooks/WebhookDeliveryRunner.php b/app/Services/Webhooks/WebhookDeliveryRunner.php
new file mode 100644
index 0000000..f1bfcad
--- /dev/null
+++ b/app/Services/Webhooks/WebhookDeliveryRunner.php
@@ -0,0 +1,146 @@
+<?php
+
+namespace App\Services\Webhooks;
+
+use App\Models\Brand;
+use App\Models\Webhook;
+use App\Models\WebhookDelivery;
+use App\Models\WebhookEvent;
+use App\Services\Media\UnsafeUrlException;
+use App\Services\Media\ValidatedUrl;
+use GuzzleHttp\Exception\TransferException;
+use Illuminate\Contracts\Encryption\DecryptException;
+use Illuminate\Http\Client\ConnectionException;
+use Illuminate\Http\Client\RequestException;
+use Illuminate\Support\Facades\DB;
+
+/** Serializa intentos; el receptor deduplica por event id si debe repetirse una petición ambigua. */
+final class WebhookDeliveryRunner
+{
+    public const MAX_ATTEMPTS = 5;
+
+    public const BACKOFF = [60, 300, 900, 3600];
+
+    public function __construct(private readonly WebhookTransport $transport) {}
+
+    /** @return ?int Segundos hasta reintentar; null indica que no debe reencolarse. */
+    public function run(int $id): ?int
+    {
+        [$url, $preparationError] = $this->prepareUrl($id);
+
+        // Sin reintentos automáticos de la transacción: repetiría el efecto HTTP de un intento ambiguo.
+        return DB::transaction(function () use ($id, $url, $preparationError): ?int {
+            $delivery = WebhookDelivery::withoutUserScope()->lockForUpdate()->find($id);
+            if ($delivery === null || $delivery->status !== 'pending') {
+                return null;
+            }
+            if ($delivery->next_attempt_at?->isFuture()) {
+                return max(1, (int) ceil(now()->diffInSeconds($delivery->next_attempt_at)));
+            }
+            $event = WebhookEvent::ownedBy($delivery->user_id)->find($delivery->webhook_event_id);
+            $hook = Webhook::ownedBy($delivery->user_id)->find($delivery->webhook_id);
+            if (! $this->eligible($delivery, $hook, $event)) {
+                $this->finish($delivery, 'cancelled', 'subscription_unavailable');
+
+                return null;
+            }
+            if ($delivery->attempts >= self::MAX_ATTEMPTS) {
+                $this->finish($delivery, 'exhausted', $delivery->last_error);
+
+                return null;
+            }
+            // Una reactivación durante la prelectura se reevalúa sin enviar una URL sin validar.
+            if ($url === null && $preparationError === null) {
+                return 1;
+            }
+            $delivery->attempts++;
+            // Toma también el lock de escritura SQLite antes de cualquier efecto HTTP.
+            $delivery->save();
+            $outcome = $preparationError !== null
+                ? ['state' => 'blocked', 'error' => $preparationError, 'http' => null]
+                : $this->send($hook, $event, $url);
+            $delivery->last_http_status = $outcome['http'];
+            $delivery->last_error = $outcome['error'];
+            if ($outcome['state'] !== 'pending') {
+                if ($outcome['state'] === 'delivered') {
+                    $delivery->delivered_at = now();
+                }
+                $this->finish($delivery, $outcome['state'], $outcome['error']);
+
+                return null;
+            }
+            if ($delivery->attempts >= self::MAX_ATTEMPTS) {
+                $this->finish($delivery, 'exhausted', $delivery->last_error);
+
+                return null;
+            }
+            $delay = self::BACKOFF[$delivery->attempts - 1];
+            $delivery->forceFill(['next_attempt_at' => now()->addSeconds($delay)])->save();
+
+            return $delay;
+        });
+    }
+
+    /** @return array{?ValidatedUrl, ?string} */
+    private function prepareUrl(int $id): array
+    {
+        $delivery = WebhookDelivery::withoutUserScope()->find($id);
+        if ($delivery === null || $delivery->status !== 'pending' || $delivery->next_attempt_at?->isFuture()
+            || $delivery->attempts >= self::MAX_ATTEMPTS) {
+            return [null, null];
+        }
+        $hook = Webhook::ownedBy($delivery->user_id)->find($delivery->webhook_id);
+        if ($hook === null || ! $hook->enabled) {
+            return [null, null];
+        }
+        try {
+            return [$this->transport->prepare($hook->url), null];
+        } catch (UnsafeUrlException) {
+            return [null, 'unsafe_url'];
+        }
+    }
+
+    private function eligible(WebhookDelivery $delivery, ?Webhook $hook, ?WebhookEvent $event): bool
+    {
+        return $event !== null && $hook !== null && $hook->enabled && $hook->brand_id === $event->brand_id
+            && in_array($event->event, $hook->events, true)
+            && Brand::ownedBy($delivery->user_id)->whereKey($event->brand_id)->exists();
+    }
+
+    /** @return array{state: string, error: ?string, http: ?int} */
+    private function send(Webhook $hook, WebhookEvent $event, ValidatedUrl $url): array
+    {
+        try {
+            return $this->classify($this->transport->send($hook, $event, $url));
+        } catch (DecryptException) {
+            return ['state' => 'blocked', 'error' => 'invalid_secret', 'http' => null];
+        } catch (ConnectionException|RequestException|TransferException) {
+            return ['state' => 'pending', 'error' => 'connection_error', 'http' => null];
+        }
+    }
+
+    /** @return array{state: string, error: ?string, http: int} */
+    private function classify(int $status): array
+    {
+        [$state, $error] = match (true) {
+            $status >= 200 && $status < 300 => ['delivered', null],
+            $status >= 300 && $status < 400 => ['blocked', 'redirect'],
+            $status >= 500 || in_array($status, [408, 425, 429], true) => ['pending', 'http_error'],
+            default => ['failed', 'http_error'],
+        };
+
+        return ['state' => $state, 'error' => $error, 'http' => $status];
+    }
+
+    public function markFailed(int $id): void
+    {
+        WebhookDelivery::withoutUserScope()->whereKey($id)->where('status', 'pending')->update([
+            'status' => 'exhausted', 'last_error' => 'worker_failed', 'finished_at' => now(), 'next_attempt_at' => null,
+        ]);
+    }
+
+    private function finish(WebhookDelivery $delivery, string $status, ?string $error): void
+    {
+        $delivery->forceFill(['status' => $status, 'last_error' => $error, 'finished_at' => now(), 'next_attempt_at' => null])->save();
+    }
+}
diff --git a/app/Services/Webhooks/WebhookDispatcher.php b/app/Services/Webhooks/WebhookDispatcher.php
new file mode 100644
index 0000000..a472e09
--- /dev/null
+++ b/app/Services/Webhooks/WebhookDispatcher.php
@@ -0,0 +1,69 @@
+<?php
+
+namespace App\Services\Webhooks;
+
+use App\Events\OutboundDomainEvent;
+use App\Jobs\DeliverWebhook;
+use App\Models\Brand;
+use App\Models\Webhook;
+use App\Models\WebhookDelivery;
+use App\Models\WebhookEvent;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use InvalidArgumentException;
+use Throwable;
+
+/** Outbox transaccional; el cuerpo firmado queda inmutable y cada suscripción recibe una entrega independiente. */
+final class WebhookDispatcher
+{
+    public function handle(OutboundDomainEvent $event): void
+    {
+        if (! array_key_exists($event->name, Webhook::EVENTS)) {
+            throw new InvalidArgumentException('Unsupported outbound event.');
+        }
+        if (! Brand::ownedBy($event->ownerId)->whereKey($event->brandId)->exists()) {
+            return;
+        }
+        $hooks = Webhook::ownedBy($event->ownerId)->where('brand_id', $event->brandId)->where('enabled', true)
+            ->whereJsonContains('events', $event->name)->get(['id']);
+        if ($hooks->isEmpty()) {
+            return;
+        }
+        DB::transaction(function () use ($event, $hooks): void {
+            $stored = WebhookEvent::ownedBy($event->ownerId)->find($event->id);
+            if ($stored === null) {
+                $stored = new WebhookEvent;
+                $stored->forceFill([
+                    'id' => $event->id, 'user_id' => $event->ownerId, 'brand_id' => $event->brandId,
+                    'event' => $event->name, 'body' => json_encode([
+                        'id' => $event->id, 'event' => $event->name, 'occurred_at' => $event->occurredAt,
+                        'brand_id' => $event->brandId, 'data' => $event->data,
+                    ], JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE),
+                ])->save();
+            }
+            foreach ($hooks as $hook) {
+                $delivery = WebhookDelivery::ownedBy($event->ownerId)->where('webhook_id', $hook->id)->where('webhook_event_id', $event->id)->first();
+                if ($delivery !== null) {
+                    continue;
+                }
+                $delivery = new WebhookDelivery;
+                $delivery->forceFill([
+                    'user_id' => $event->ownerId, 'webhook_id' => $hook->id, 'webhook_event_id' => $event->id,
+                    'next_attempt_at' => now(),
+                ])->save();
+                $id = (int) $delivery->id;
+                DB::afterCommit(fn () => $this->enqueue($id));
+            }
+        });
+    }
+
+    public function enqueue(int $id): void
+    {
+        try {
+            DeliverWebhook::dispatch($id);
+        } catch (Throwable $error) {
+            // PendingDispatch libera su lock único si falla la cola; el barrido puede volver a intentarlo.
+            Log::warning('webhooks.enqueue_failed', ['delivery_id' => $id, 'exception' => $error::class]);
+        }
+    }
+}
diff --git a/app/Services/Webhooks/WebhookSubscriptions.php b/app/Services/Webhooks/WebhookSubscriptions.php
new file mode 100644
index 0000000..15bd57c
--- /dev/null
+++ b/app/Services/Webhooks/WebhookSubscriptions.php
@@ -0,0 +1,89 @@
+<?php
+
+namespace App\Services\Webhooks;
+
+use App\Models\Brand;
+use App\Models\User;
+use App\Models\Webhook;
+use App\Services\Media\UnsafeUrlException;
+use App\Support\Ownership;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+
+/** Suscripciones de una marca propia. URL y secreto son inmutables: cambiar receptor requiere un alta nueva. */
+final class WebhookSubscriptions
+{
+    public function __construct(private readonly WebhookTransport $transport) {}
+
+    /** @param array<string, mixed> $data */
+    public function create(User $user, Brand $brand, array $data): Webhook
+    {
+        Ownership::assert($brand, $user);
+        $valid = $this->validated($data, creating: true);
+        try {
+            $url = $this->transport->prepare($valid['url']);
+        } catch (UnsafeUrlException $error) {
+            throw ValidationException::withMessages(['url' => $error->getMessage()]);
+        }
+        $valid['url'] = $url->url;
+
+        return DB::transaction(function () use ($user, $brand, $valid): Webhook {
+            // El lock del usuario también limita altas simultáneas en marcas distintas.
+            User::whereKey($user->id)->lockForUpdate()->firstOrFail();
+            $limit = self::limit();
+            if (Webhook::ownedBy($user->id)->count() >= $limit) {
+                throw ValidationException::withMessages(['webhook' => 'Se ha alcanzado el límite de '.$limit.' webhooks de la cuenta.']);
+            }
+            $hook = new Webhook($valid);
+            $hook->user_id = $user->id;
+            $hook->brand_id = $brand->id;
+            $hook->save();
+
+            return $hook->fresh();
+        });
+    }
+
+    /** @param array<string, mixed> $data */
+    public function update(User $user, Webhook $hook, array $data): void
+    {
+        $this->assertOwner($user, $hook);
+        $hook->fill($this->validated($data, creating: false))->save();
+    }
+
+    public function delete(User $user, Webhook $hook): void
+    {
+        $this->assertOwner($user, $hook);
+        $hook->delete();
+    }
+
+    private function assertOwner(User $user, Webhook $hook): void
+    {
+        Ownership::assert($hook, $user);
+        Ownership::assert(Brand::ownedBy($user->id)->find($hook->brand_id), $user);
+    }
+
+    public static function limit(): int
+    {
+        return max(1, (int) config('webhooks.max_per_user', 20));
+    }
+
+    /** @param array<string, mixed> $data
+     * @return array<string, mixed>
+     */
+    private function validated(array $data, bool $creating): array
+    {
+        $valid = Validator::make($data, [
+            'name' => ['required', 'string', 'max:120', 'not_regex:/[\p{C}]/u'],
+            'url' => $creating ? ['required', 'string', 'max:2048'] : ['prohibited'],
+            'secret' => $creating ? ['required', 'string', 'regex:/\A[A-Za-z0-9_-]{32,128}\z/'] : ['prohibited'],
+            'events' => ['required', 'array', 'min:1', 'max:'.count(Webhook::EVENTS)],
+            'events.*' => ['required', 'string', 'distinct', Rule::in(array_keys(Webhook::EVENTS))],
+            'enabled' => ['sometimes', 'boolean'],
+        ])->validate();
+        $valid['name'] = trim($valid['name']);
+
+        return $valid;
+    }
+}
