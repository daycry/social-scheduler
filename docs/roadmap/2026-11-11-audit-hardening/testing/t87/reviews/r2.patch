+function tgPhoto(int $id = 1, int $width = 64, int $height = 48): PublishMedia
+{
+    $im = imagecreatetruecolor($width, $height);
+    ob_start();
+    imagejpeg($im);
+    $bytes = (string) ob_get_clean();
+    $path = "media/test/tg-$id.jpg";
+    Storage::disk('local')->put($path, $bytes);
