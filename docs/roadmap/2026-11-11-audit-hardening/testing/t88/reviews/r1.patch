+    expect($res['rss'])->toBe(['added' => 3, 'error' => null])
+        ->and(rssLabels($list))->toBe(["Primera\nhttps://blog.example.test/1", "Segunda\nhttps://blog.example.test/2", "Tercera\nhttps://blog.example.test/3"]);
