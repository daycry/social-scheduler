+    expect($old->refresh()->status)->toBe(DataExport::STATUS_EXPIRED)->and($old->path)->toBeNull()
+        ->and($keep->refresh()->status)->toBe(DataExport::STATUS_READY)
+        ->and($stuck->refresh()->status)->toBe(DataExport::STATUS_FAILED)->and($stuck->in_progress)->toBeNull();
+    expect(collect(app(Schedule::class)->events())->contains(fn ($e) => str_contains($e->command, 'exports:prune')))->toBeTrue();
+});
+
+test('la página muestra el estado y un enlace de descarga solo cuando está lista', function () {
+    $this->actingAs($this->user)->get(route('profile.export'))->assertInertia(fn (Assert $page) => $page->component('Profile/Export')->where('latest', null)
+        ->where('limits.retention_hours', config('exports.retention_hours'))->has('limits.max_mb'));
+
+    $export = runExport(requestExport($this->user));
+    $this->actingAs($this->user)->get(route('profile.export'))->assertInertia(fn (Assert $page) => $page->where('latest.status', 'ready')->where('latest.download_url', route('profile.export.link', $export))
+        ->missing('latest.path'));
