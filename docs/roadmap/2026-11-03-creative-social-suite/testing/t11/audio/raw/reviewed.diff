+                || ! preg_match('/^[a-f0-9-]{36}\.bin$/D', $file->getFilename()) || $file->getMTime() >= $limit) {
+                continue;
+            }
+            if (File::delete($path)) {
+                $removed++;
+            }
+        }
+
+        return $removed;
+    }
