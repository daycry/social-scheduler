{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && node scripts/studio/build.mjs",
        "dev": "vite",
        "test:e2e": "playwright test",
        "test:e2e:roadmap": "playwright test -c playwright.roadmap.config.ts",
        "test:unit": "node scripts/test/run-node-tests.mjs unit",
        "test:browser": "node scripts/test/run-node-tests.mjs browser",
        "test:purge": "node scripts/test/purge-testing.mjs",
        "typecheck": "tsc --noEmit -p tsconfig.json && php artisan ziggy:generate --types-only storage/framework/cache/typecheck/ziggy.d.ts && vue-tsc --noEmit -p tsconfig.frontend.json",
        "lint": "eslint \"resources/js/**/*.vue\" --max-warnings 0",
        "format": "prettier --write \"resources/js/**/*.vue\"",
        "format:check": "prettier --check \"resources/js/**/*.vue\""
    },
    "devDependencies": {
        "@axe-core/playwright": "4.10.2",
        "@inertiajs/vue3": "^2.0.0",
        "@playwright/test": "^1.49.1",
        "@tailwindcss/forms": "^0.5.3",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.0",
        "autoprefixer": "^10.4.12",
        "concurrently": "^10.0.3",
        "eslint": "10.15.0",
        "eslint-plugin-vue": "10.12.1",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.4.31",
        "prettier": "3.10.1",
        "tailwindcss": "^3.2.1",
        "typescript": "6.0.3",
        "vite": "^8.0.0",
        "vue": "^3.4.0",
        "vue-eslint-parser": "10.4.2",
        "vue-tsc": "3.3.14"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@laravel/passkeys": "~0.4.0",
        "fabric": "^7.4.0",
        "pdf-lib": "^1.17.1",
        "playwright": "^1.64.1"
    }
}
