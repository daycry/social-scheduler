+++ b/tests/Feature/Calendar/MarketingDatesTest.php
@@ -0,0 +1,121 @@
+<?php
+
+use App\Models\User;
+use App\Support\MarketingDates;
+use Illuminate\Support\Carbon;
+use Inertia\Testing\AssertableInertia as Assert;
+
+// T-90 · F-17: fechas señaladas propias (fijas y móviles calculadas), visibles en el calendario y ocultables por usuario.
+
+function marketingDateOf(string $key, int $year): ?string
+{
+    foreach (MarketingDates::forYear($year) as $date) {
+        if ($date['key'] === $key) {
+            return $date['date'];
+        }
+    }
+
+    return null;
+}
+
+it('calcula Black Friday y Cyber Monday: el día siguiente y el lunes posterior al cuarto jueves de noviembre', function (int $year, string $blackFriday, string $cyberMonday) {
+    expect(marketingDateOf('black-friday', $year))->toBe($blackFriday)
+        ->and(marketingDateOf('cyber-monday', $year))->toBe($cyberMonday);
+})->with([
+    [2024, '2024-11-29', '2024-12-02'],
+    [2025, '2025-11-28', '2025-12-01'],
+    [2026, '2026-11-27', '2026-11-30'],
+    [2027, '2027-11-26', '2027-11-29'],
+    [2028, '2028-11-24', '2028-11-27'],
+]);
+
+it('el Día de la Madre en España es el primer domingo de mayo', function (int $year, string $expected) {
+    expect(marketingDateOf('mothers-day', $year))->toBe($expected);
+})->with([[2025, '2025-05-04'], [2026, '2026-05-03'], [2027, '2027-05-02'], [2028, '2028-05-07']]);
+
+it('las fechas fijas caen siempre en su día', function () {
+    expect(marketingDateOf('new-year', 2027))->toBe('2027-01-01')
+        ->and(marketingDateOf('valentines-day', 2027))->toBe('2027-02-14')
+        ->and(marketingDateOf('womens-day', 2027))->toBe('2027-03-08')
+        ->and(marketingDateOf('world-book-day', 2027))->toBe('2027-04-23')
+        ->and(marketingDateOf('christmas', 2027))->toBe('2027-12-25');
+});
+
+it('devuelve cada año ordenado por fecha, con nombre y sin duplicados', function () {
+    $dates = MarketingDates::forYear(2026);
+    $days = array_column($dates, 'date');
+
+    expect($dates)->not->toBeEmpty()
+        ->and($days)->toBe(collect($days)->sort()->values()->all())
+        ->and(array_unique(array_column($dates, 'key')))->toHaveCount(count($dates));
+    foreach ($dates as $date) {
+        expect($date['name'])->toBeString()->not->toBeEmpty()->and($date['date'])->toStartWith('2026-');
+    }
+});
+
+it('between devuelve solo las fechas del rango, incluidos los extremos, también al cruzar de año', function () {
+    $days = array_column(MarketingDates::between('2026-12-24', '2027-01-06'), 'date');
+
+    expect($days)->toBe(['2026-12-25', '2026-12-31', '2027-01-01', '2027-01-06']);
+});
+
+it('el calendario envía las fechas señaladas del rango y la preferencia', function () {
+    Carbon::setTestNow('2026-11-25 12:00:00');
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->get(route('calendar.index', ['view' => 'week', 'date' => '2026-11-25']))
+        ->assertInertia(fn (Assert $page) => $page
+            ->where('marketing_dates_hidden', false)
+            ->where('marketing_dates', fn ($dates) => collect($dates)->pluck('name', 'date')->all() === ['2026-11-27' => 'Black Friday']));
+});
+
+it('ocultar las fechas las quita del calendario y se recuerda por usuario', function () {
+    Carbon::setTestNow('2026-11-25 12:00:00');
+    $user = User::factory()->create();
+    $other = User::factory()->create();
+
+    $this->actingAs($user)->patch(route('calendar.marketing-dates.update'), ['hidden' => true])->assertRedirect();
+
+    expect($user->fresh()->hide_marketing_dates)->toBeTrue()->and($other->fresh()->hide_marketing_dates)->toBeFalse();
+    $this->actingAs($user)->get(route('calendar.index', ['view' => 'week', 'date' => '2026-11-25']))
+        ->assertInertia(fn (Assert $page) => $page->where('marketing_dates_hidden', true)->where('marketing_dates', []));
+    $this->actingAs($other)->get(route('calendar.index', ['view' => 'week', 'date' => '2026-11-25']))
+        ->assertInertia(fn (Assert $page) => $page->where('marketing_dates_hidden', false)->has('marketing_dates', 1));
+
+    $this->actingAs($user)->patch(route('calendar.marketing-dates.update'), ['hidden' => false])->assertRedirect();
+    expect($user->fresh()->hide_marketing_dates)->toBeFalse();
+});
+
+it('la preferencia exige un booleano y un invitado no puede cambiarla', function () {
+    $this->patch(route('calendar.marketing-dates.update'), ['hidden' => true])->assertRedirect(route('login'));
+    $this->actingAs(User::factory()->create())->patch(route('calendar.marketing-dates.update'), ['hidden' => 'quizá'])->assertSessionHasErrors('hidden');
+});
+
+it('un 29 de febrero fijo solo existe en años bisiestos', function () {
+    config(['marketing_dates.dates' => [['key' => 'leap', 'name' => 'Bisiesto', 'month' => 2, 'day' => 29]]]);
+
+    expect(MarketingDates::forYear(2028))->toBe([['key' => 'leap', 'name' => 'Bisiesto', 'date' => '2028-02-29']])
+        ->and(MarketingDates::forYear(2027))->toBe([]);
+});
+
+it('el enésimo día de la semana que el mes no tiene no cae en el mes siguiente; nth -1 es el último', function () {
+    config(['marketing_dates.dates' => [
+        ['key' => 'fifth-monday', 'name' => 'Quinto lunes', 'month' => 2, 'weekday' => 1, 'nth' => 5],
+        ['key' => 'last-friday', 'name' => 'Último viernes', 'month' => 2, 'weekday' => 5, 'nth' => -1],
+    ]]);
+
+    expect(array_column(MarketingDates::forYear(2027), 'date'))->toBe(['2027-02-26'])
+        ->and(array_column(MarketingDates::forYear(2028), 'date'))->toBe(['2028-02-25']);
+    config(['marketing_dates.dates' => [['key' => 'fifth-monday', 'name' => 'Quinto lunes', 'month' => 2, 'weekday' => 1, 'nth' => 5]]]);
+    expect(MarketingDates::forYear(2027))->toBe([]);
+});
+
+it('between incluye las fechas cuyo offset las lleva al año contiguo', function () {
+    config(['marketing_dates.dates' => [
+        ['key' => 'after-december', 'name' => 'Tras el último jueves de diciembre', 'month' => 12, 'weekday' => 4, 'nth' => -1, 'offset' => 10],
+        ['key' => 'before-january', 'name' => 'Antes del primer lunes de enero', 'month' => 1, 'weekday' => 1, 'nth' => 1, 'offset' => -10],
+    ]]);
+
+    expect(array_column(MarketingDates::between('2027-01-05', '2027-01-15'), 'date'))->toBe(['2027-01-10'])
+        ->and(array_column(MarketingDates::between('2026-12-20', '2026-12-30'), 'date'))->toBe(['2026-12-25']);
+});
diff --git a/tests/e2e/calendar-ics-feed.spec.ts b/tests/e2e/calendar-ics-feed.spec.ts
new file mode 100644
index 0000000..4999e79
--- /dev/null
+++ b/tests/e2e/calendar-ics-feed.spec.ts
@@ -0,0 +1,170 @@
+import { expect, test, type Page } from '@playwright/test';
+import {
+    artisan,
+    axeSeriousCritical,
+    cleanComposerBrands,
+    createExtraE2eUser,
+    e2eUser,
+    expectNoOverflow,
+    loginAs,
+    seedComposerBrand,
+    settle,
+    stamp,
+    watch,
+    type ComposerBrand,
+} from './helpers';
+
+/**
+ * T-90 · Fechas señaladas y feed .ics (E2E-29). Las fechas señaladas se ven en el calendario y se ocultan (la preferencia persiste); el enlace
+ * de suscripción se crea, se descarga como iCalendar válido con SOLO las publicaciones del usuario, se regenera (el anterior da 404, tras un
+ * diálogo de confirmación) y se revoca. Usuarios `e2e-sec-*` y marcas `e2e-composer-*`: nada toca datos reales ni publica en redes.
+ */
+test.describe.configure({ mode: 'serial' });
+
+/** Deja al usuario sin feed y con las fechas señaladas visibles. */
+const resetFeed = (email: string) =>
+    artisan(
+        String.raw`App\Models\User::where('email', '${email}')->update(['calendar_feed_token_hash' => null, 'calendar_feed_token_at' => null, 'hide_marketing_dates' => false]);`,
+    );
+
+/** Una publicación propia programada en 3 días y otra de OTRO usuario con el mismo aspecto: la ajena nunca puede salir en el feed. */
+function seedPosts(brandId: number, other: string, word: string) {
+    artisan(
+        String.raw`$b = App\Models\Brand::withoutUserScope()->findOrFail(${brandId}); ` +
+            String.raw`App\Models\Post::factory()->create(['brand_id' => $b->id, 'text' => 'e2e ics propia, con coma; ${word}', 'status' => App\Enums\PostStatus::Scheduled, 'scheduled_at' => now()->addDays(3)]); ` +
+            String.raw`$o = App\Models\User::where('email', '${other}')->firstOrFail(); ` +
+            String.raw`$ob = App\Models\Brand::factory()->for($o)->create(['name' => 'e2e-composer-ajena-${word}']); ` +
+            String.raw`App\Models\Post::factory()->create(['brand_id' => $ob->id, 'text' => 'e2e ics ajena ${word}', 'status' => App\Enums\PostStatus::Scheduled, 'scheduled_at' => now()->addDays(3)]);`,
+    );
+}
+
+const panel = (page: Page) => page.getByTestId('calendar-feed-panel');
+const showDates = (page: Page) => panel(page).getByLabel(/Mostrar las fechas señaladas/);
+const blackFriday = (page: Page) => page.getByTestId('marketing-date').filter({ hasText: 'Black Friday' });
+const feedPath = (url: string) => new URL(url).pathname;
+
+async function confirmDialog(page: Page, title: string, button: string) {
+    const dialog = page.getByRole('alertdialog', { name: title, exact: true });
+    await expect(dialog).toBeVisible();
+    await dialog.getByRole('button', { name: button, exact: true }).click();
+    await expect(dialog).toBeHidden();
+    await settle(page);
+}
+
+test.describe('Fechas señaladas y feed .ics', { tag: '@responsive' }, () => {
+    let brand: ComposerBrand;
+    let otherEmail: string;
+    let word: string;
+
+    test.beforeEach(async ({ page }, info) => {
+        const user = e2eUser(info.project.name);
+        word = `ics${stamp()}`;
+        cleanComposerBrands(user.email);
+        resetFeed(user.email);
+        brand = seedComposerBrand(user.email, `${word}-${info.project.name}`);
+        otherEmail = createExtraE2eUser(`ics-${word}`);
+        cleanComposerBrands(otherEmail);
+        seedPosts(brand.id, otherEmail, word);
+        await loginAs(page, user);
+    });
+
+    test.afterEach(async ({}, info) => {
+        const user = e2eUser(info.project.name);
+        try {
+            resetFeed(user.email);
+        } finally {
+            cleanComposerBrands(user.email);
+            cleanComposerBrands(otherEmail);
+        }
+    });
+
+    test('E2E-29 · fechas señaladas visibles y ocultables; el .ics es válido, solo del usuario, regenerable y revocable', async ({
+        page,
+    }, info) => {
+        const w = watch(page);
+        await page.goto('/calendar?view=month&date=2027-11-15');
+        await settle(page);
+
+        // 1. Las fechas señaladas se ven, distinguibles de las publicaciones, y se ocultan; la preferencia sobrevive a recargar.
+        await expect(blackFriday(page)).toBeVisible();
+        await expect(showDates(page)).toBeChecked();
+        await page.screenshot({ path: info.outputPath('calendario-fechas-inicial.png'), fullPage: true });
+        await showDates(page).uncheck();
+        await settle(page);
+        await expect(blackFriday(page)).toHaveCount(0);
+        await page.reload();
+        await settle(page);
+        await expect(showDates(page)).not.toBeChecked();
+        await expect(blackFriday(page)).toHaveCount(0);
+        await showDates(page).check();
+        await settle(page);
+        await expect(blackFriday(page)).toBeVisible();
+
+        // 2. Crear el enlace: se muestra una vez y el .ics es válido y solo contiene lo del usuario.
+        await panel(page).getByRole('button', { name: 'Crear enlace de suscripción', exact: true }).click();
+        await settle(page);
+        const urlField = panel(page).getByLabel(/Tu enlace/);
+        await expect(urlField).toBeVisible();
+        const url = await urlField.inputValue();
+        expect(url).toMatch(/\/calendar\/feed\/[A-Za-z0-9_-]{43}\.ics$/);
+        await page.screenshot({ path: info.outputPath('calendario-feed-creado.png'), fullPage: true });
+
+        const feed = await page.request.get(feedPath(url));
+        expect(feed.status()).toBe(200);
+        expect(feed.headers()['content-type']).toContain('text/calendar');
+        expect(feed.headers()['content-type']).toContain('charset=utf-8');
+        expect(feed.headers()['cache-control']).toContain('no-store');
+        expect(feed.headers()['x-robots-tag']).toContain('noindex');
+        const body = await feed.text();
+        expect(body.startsWith('BEGIN:VCALENDAR\r\n')).toBe(true);
+        expect(body.endsWith('END:VCALENDAR\r\n')).toBe(true);
+        expect(body).toContain('VERSION:2.0');
+        expect(body).toMatch(/PRODID:/);
+        expect(body).toMatch(/DTSTART:\d{8}T\d{6}Z/);
+        expect(body).not.toMatch(/(?<!\r)\n/);
+        for (const line of body.split('\r\n')) expect(Buffer.byteLength(line)).toBeLessThanOrEqual(75);
+        const unfolded = body.replace(/\r\n[ \t]/g, '');
+        expect(unfolded).toContain(`e2e ics propia\\, con coma\\; ${word}`);
+        expect(unfolded).not.toContain(`e2e ics ajena ${word}`);
+        expect(unfolded).not.toContain(`e2e-composer-ajena-${word}`);
+        expect(unfolded).toContain('SUMMARY:Navidad');
+
+        // 3. Con las fechas ocultas, el feed no las lleva (las publicaciones sí).
+        await showDates(page).uncheck();
+        await settle(page);
+        const hidden = (await (await page.request.get(feedPath(url))).text()).replace(/\r\n[ \t]/g, '');
+        expect(hidden).not.toContain('SUMMARY:Navidad');
+        expect(hidden).toContain(`e2e ics propia\\, con coma\\; ${word}`);
+        await expect(urlField).toBeVisible(); // la URL recién creada sigue en el panel tras cambiar la casilla
+        await showDates(page).check();
+        await settle(page);
+
+        // 4. Tras recargar, la URL ya no se muestra (solo el hash está guardado).
+        await page.reload();
+        await settle(page);
+        await expect(panel(page).getByTestId('calendar-feed-active')).toBeVisible();
+        await expect(panel(page).getByLabel(/Tu enlace/)).toHaveCount(0);
+
+        // 5. Regenerar pide confirmación; el enlace anterior da 404 y el nuevo funciona.
+        await panel(page).getByRole('button', { name: 'Regenerar enlace', exact: true }).click();
+        await confirmDialog(page, 'Regenerar el enlace', 'Regenerar');
+        const fresh = await panel(page)
+            .getByLabel(/Tu enlace/)
+            .inputValue();
+        expect(fresh).not.toBe(url);
+        expect((await page.request.get(feedPath(url))).status()).toBe(404);
+        expect((await page.request.get(feedPath(fresh))).status()).toBe(200);
+
+        // 6. Revocar también pide confirmación y deja el feed sin servicio.
+        await panel(page).getByRole('button', { name: 'Revocar enlace', exact: true }).click();
+        await confirmDialog(page, 'Revocar el enlace', 'Revocar');
+        await expect(
+            panel(page).getByRole('button', { name: 'Crear enlace de suscripción', exact: true }),
+        ).toBeVisible();
+        expect((await page.request.get(feedPath(fresh))).status()).toBe(404);
+
+        await expectNoOverflow(page);
+        await axeSeriousCritical(page, 'Calendario con fechas señaladas');
+        expect(w.errors).toEqual([]);
+    });
+});
