+            const time = (segment.sampleStart + n) / 48000;
+            let expected;
+            if (pageIds[0] === 'c') expected = time < 1 ? at(1.75 + time) : at(time - 1);
+            else if (time < 0.75) expected = at(time);
+            else if (time < 1) expected = at(time) * (1 - time) / 0.25 + at(time + 1) * (time - 0.75) / 0.25;
