+                break;
+            }
+            // La clave unica decide: si otra ejecucion registro esta entrada entre medias, no se inserta nada y no se crea el elemento.
+            if (DB::table('autolist_rss_entries')->insertOrIgnore(['autolist_id' => $autolistId, 'entry_key' => $entry['key'], 'created_at' => now()]) !== 1) {
+                continue;
+            }
+
+            $item = new AutolistItem(['text' => mb_substr($entry['title'].($entry['link'] !== null ? "\n".$entry['link'] : ''), 0, 10000), 'position' => ++$position]);
