+test(
+    'E2E-08 · compositor: Threads cuenta 500 caracteres con cada emoji por sus bytes UTF-8',
+    { tag: '@responsive' },
+    async ({ page }) => {
+        const w = watch(page);
+        await page.goto(`/brands/${brand.id}/posts/create`);
