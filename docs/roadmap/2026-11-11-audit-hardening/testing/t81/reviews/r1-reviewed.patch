diff --git a/resources/js/lib/push.js b/resources/js/lib/push.js
new file mode 100644
index 0000000..1d1b2bd
--- /dev/null
+++ b/resources/js/lib/push.js
@@ -0,0 +1,50 @@
+/** Public worker registration never requests notification permission. */
+export function pushSupported() {
+    return (
+        typeof window !== 'undefined' &&
+        window.isSecureContext &&
+        'serviceWorker' in navigator &&
+        'PushManager' in window &&
+        typeof Notification !== 'undefined'
+    );
+}
+
+export async function registerPushWorker() {
+    if (!pushSupported()) return null;
+    return navigator.serviceWorker.register('/sw.js', { scope: '/', updateViaCache: 'none' });
+}
+
+/** @param {string} publicKey @returns {Promise<PushSubscriptionJSON>} */
+export async function activatePush(publicKey) {
+    if (!pushSupported()) throw new Error('Este navegador necesita HTTPS y compatibilidad con notificaciones push.');
+    // First async operation: called directly by the user's click, preserving the permission gesture.
+    const permission = await Notification.requestPermission();
+    if (permission !== 'granted')
+        throw new Error(
+            'No has concedido permiso para las notificaciones. Puedes cambiarlo en los ajustes del navegador.',
+        );
+    await registerPushWorker();
+    const registration = await navigator.serviceWorker.ready;
+    const binary = atob(publicKey.replace(/-/g, '+').replace(/_/g, '/'));
+    const key = Uint8Array.from(binary, (character) => character.charCodeAt(0));
+    let subscription = await registration.pushManager.getSubscription();
+    const previous = subscription?.options?.applicationServerKey;
+    if (subscription && previous && !sameKey(new Uint8Array(previous), key)) {
+        await subscription.unsubscribe();
+        subscription = null;
+    }
+    subscription ??= await registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: key });
+    return subscription.toJSON();
+}
+
+/** @param {Uint8Array} left @param {Uint8Array} right */
+function sameKey(left, right) {
+    return left.length === right.length && left.every((byte, index) => byte === right[index]);
+}
+
+export async function revokeBrowserPush() {
+    if (!pushSupported()) return;
+    await registerPushWorker();
+    const registration = await navigator.serviceWorker.ready;
+    await (await registration.pushManager.getSubscription())?.unsubscribe();
+}
diff --git a/resources/js/sw.js b/resources/js/sw.js
new file mode 100644
index 0000000..6c4abe8
--- /dev/null
+++ b/resources/js/sw.js
@@ -0,0 +1,27 @@
+// No fetch handler, Cache Storage or IndexedDB: authenticated pages and user data stay out of worker storage.
+self.addEventListener('install', (event) => {
+    event.waitUntil(self.skipWaiting());
+});
+
+self.addEventListener('activate', (event) => {
+    event.waitUntil(self.clients.claim());
+});
+
+self.addEventListener('push', (event) => {
+    // Generic text also protects privacy when a device has been locked or its web session has ended.
+    event.waitUntil(
+        self.registration.showNotification('Social Scheduler', {
+            body: 'Tienes nuevos avisos.',
+            icon: '/icon-192.png',
+            badge: '/icon-192.png',
+            tag: 'social-scheduler-notifications',
+            data: { url: '/notifications' },
+        }),
+    );
+});
+
+self.addEventListener('notificationclick', (event) => {
+    event.notification.close();
+    // Never navigate to an endpoint or URL supplied by a push payload.
+    event.waitUntil(self.clients.openWindow(new URL('/notifications', self.location.origin).href));
+});
