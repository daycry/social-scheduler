+        const entry = entries.get(id);
+        if (!entry) return;
+        entries.delete(id); entry.abort.abort(); entry.node.pause();
+        entry.source?.disconnect(); entry.gain?.disconnect();
+        entry.node.removeAttribute('src'); entry.node.load();
