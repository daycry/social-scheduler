diff --git a/resources/js/Components/Composer/AiAdapt.vue b/resources/js/Components/Composer/AiAdapt.vue
new file mode 100644
index 0000000..7017927
--- /dev/null
+++ b/resources/js/Components/Composer/AiAdapt.vue
@@ -0,0 +1,126 @@
+<script setup>
+import { computed, ref, useId } from 'vue';
+import AiNotConfigured from '@/Components/AiNotConfigured.vue';
+import NetworkIcon from '@/Components/NetworkIcon.vue';
+import { useAiStatus } from '@/Composables/useAiStatus';
+import { useComposerContext } from '@/Composables/useComposer';
+import { formatThousands } from '@/Composables/textCount';
+import { countText } from '@/Composables/textLength';
+import { HttpError } from '@/lib/http';
+
+/**
+ * «Adaptar a cada red» (T-82): la IA reescribe el texto común para cada destino seleccionado en UNA petición (una unidad de la cuota
+ * diaria compartida con «Sugerir texto»). El servidor valida cada versión contra la regla de texto de su tipo y rechaza la que no cabe
+ * (con su motivo). El resultado se MUESTRA por red y solo se aplica al pulsar «Aplicar» (texto propio de cada red, como «Editar por red»);
+ * «Descartar» lo tira. Sin IA configurada el botón queda inactivo y explica por qué.
+ */
+const { brand, form, accounts, limits, applyTargetTexts } = useComposerContext();
+const { enabled, loaded, remaining, call } = useAiStatus();
+
+const hintId = useId();
+const loading = ref(false);
+const error = ref('');
+const results = ref(null);
+const applied = ref('');
+
+const canAdapt = computed(() => form.text.trim() !== '' && form.targets.length > 0);
+
+const adapt = async () => {
+    error.value = '';
+    applied.value = '';
+    results.value = null;
+    loading.value = true;
+    try {
+        const data = await call(
+            'ai.adapt',
+            {
+                brand_id: brand.value.id,
+                text: form.text,
+                targets: form.targets.map((t) => ({ account_id: t.account_id, content_type: t.content_type })),
+            },
+            { errorMessage: (data) => data?.message ?? data?.errors?.text?.[0] ?? 'No se pudo adaptar el texto.' },
+        );
+        results.value = data?.results ?? [];
+    } catch (failure) {
+        error.value = failure instanceof HttpError ? failure.message : 'No se pudo contactar con el asistente.';
+    } finally {
+        loading.value = false;
+    }
+};
+
+const rows = computed(() => (results.value ?? []).map((r) => {
+    const account = accounts.value.find((a) => a.id === r.account_id);
+    const target = form.targets.find((t) => t.account_id === r.account_id);
+    const limit = limits.value?.[target?.content_type] ?? {};
+    return {
+        ...r,
+        network: account?.network,
+        label: account ? `${account.network_label} · ${account.name}` : 'Cuenta eliminada',
+        chars: r.text ? countText(r.text, limit.count) : 0,
+        max: limit.max_chars ?? null,
+    };
+}));
+const accepted = computed(() => rows.value.filter((r) => r.text));
+
+const apply = () => {
+    applyTargetTexts(accepted.value);
+    applied.value = `Aplicado a ${accepted.value.length} ${accepted.value.length === 1 ? 'red' : 'redes'}. Puedes editar cada texto en su pestaña.`;
+    results.value = null;
+};
+const discard = () => {
+    results.value = null;
+    applied.value = '';
+};
+</script>
+
+<template>
+    <div class="min-w-0" data-testid="ai-adapt">
+        <button
+            type="button"
+            class="btn btn-secondary"
+            :disabled="!enabled || !canAdapt || loading"
+            :aria-describedby="hintId"
+            data-testid="ai-adapt-run"
+            @click="adapt"
+            >{{ loading ? 'Adaptando…' : 'Adaptar a cada red' }}</button
+        >
+        <AiNotConfigured v-if="loaded && !enabled" :id="hintId" class="mt-1 max-w-sm text-xs" data-testid="ai-adapt-unconfigured" />
+        <p v-else-if="loaded && !canAdapt" :id="hintId" class="mt-1 max-w-xs text-xs text-slate-600"
+            >Escribe el texto común y elige al menos una red para adaptarlo.</p
+        >
+        <p v-else-if="loaded" :id="hintId" class="mt-1 max-w-xs text-xs text-slate-600"
+            >La IA propone una versión por red y tú confirmas. Te quedan {{ remaining }} usos hoy.</p
+        >
+        <p v-if="error" class="mt-1 text-sm text-rose-700" role="alert" data-testid="ai-adapt-error">{{ error }}</p>
+        <p v-if="applied" class="mt-1 text-sm text-emerald-800" role="status" data-testid="ai-adapt-applied">{{ applied }}</p>
+    </div>
+
+    <div
+        v-if="results"
+        class="w-full rounded-lg border border-indigo-200 bg-indigo-50 p-3"
+        role="group"
+        aria-label="Versiones propuestas por la IA"
+        data-testid="ai-adapt-proposal"
+    >
+        <p class="text-sm font-semibold text-slate-900">Versiones propuestas</p>
+        <ul class="mt-2 space-y-2">
+            <li v-for="r in rows" :key="r.account_id" class="min-w-0 rounded border border-indigo-100 bg-white p-2 text-sm" data-testid="ai-adapt-version">
+                <p class="flex min-w-0 items-center gap-1.5 text-xs font-medium text-slate-900">
+                    <NetworkIcon v-if="r.network" :network="r.network" size="sm" />
+                    <span class="truncate">{{ r.label }}</span>
+                    <span v-if="r.text" class="shrink-0 rounded bg-slate-100 px-1.5 py-0.5 text-slate-700" data-testid="ai-adapt-count"
+                        >{{ formatThousands(r.chars) }}<template v-if="r.max != null"> / {{ formatThousands(r.max) }}</template></span
+                    >
+                </p>
+                <p v-if="r.text" class="mt-1 whitespace-pre-line break-words text-slate-900">{{ r.text }}</p>
+                <p v-else class="mt-1 text-xs text-amber-800" data-testid="ai-adapt-rejected"
+                    >No se propone texto para esta red: {{ r.error }}</p
+                >
+            </li>
+        </ul>
+        <div class="mt-3 flex flex-wrap gap-2">
+            <button type="button" class="btn btn-primary" :disabled="!accepted.length" data-testid="ai-adapt-apply" @click="apply">Aplicar</button>
+            <button type="button" class="btn btn-secondary" data-testid="ai-adapt-discard" @click="discard">Descartar</button>
+        </div>
+    </div>
+</template>
diff --git a/tests/Feature/Ai/AdaptContentTest.php b/tests/Feature/Ai/AdaptContentTest.php
new file mode 100644
index 0000000..174fda5
--- /dev/null
+++ b/tests/Feature/Ai/AdaptContentTest.php
@@ -0,0 +1,211 @@
+<?php
+
+use App\Connectors\Network;
+use App\Models\Brand;
+use App\Models\MediaAsset;
+use App\Models\SocialAccount;
+use App\Models\User;
+use App\Services\Studio\StudioAssets;
+use App\Support\TargetMedia;
+use Illuminate\Http\Client\Request;
+use Illuminate\Support\Facades\Cache;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Testing\TestResponse;
+
+// T-82: POST ai/adapt (una versión del texto por red, validada contra `media_specs`) y POST ai/alt (alt text desde el compositor).
+// La IA va siempre simulada con Http::fake; nada llega a la red.
+
+beforeEach(function () {
+    Cache::flush();
+    Http::preventStrayRequests();
+    Storage::fake('local');
+    config(['social.ai' => ['enabled' => true, 'api_key' => 'sk-ant-TEST', 'model' => 'claude-sonnet-5-5', 'max_tokens' => 600, 'timeout' => 30, 'daily_limit' => 20, 'global_daily_limit' => 0, 'vision' => true]]);
+    $this->user = User::factory()->create();
+    $this->brand = Brand::factory()->for($this->user)->create(['name' => 'Panadería Sol']);
+    $this->ig = SocialAccount::factory()->for($this->user)->create(['brand_id' => $this->brand->id, 'network' => Network::Instagram]);
+    $this->bs = SocialAccount::factory()->for($this->user)->create(['brand_id' => $this->brand->id, 'network' => Network::Bluesky]);
+    $this->targets = [
+        ['account_id' => $this->ig->id, 'content_type' => 'instagram_image'],
+        ['account_id' => $this->bs->id, 'content_type' => 'bluesky_post'],
+    ];
+});
+
+function claudeText(string $text): array
+{
+    return ['content' => [['type' => 'text', 'text' => $text]]];
+}
+
+function fakeVersions(array $versions): void
+{
+    Http::fake(['api.anthropic.com/*' => Http::response(claudeText(json_encode(['versions' => $versions], JSON_UNESCAPED_UNICODE)))]);
+}
+
+function adapt(array $overrides = []): TestResponse
+{
+    return test()->actingAs(test()->user)->postJson(route('ai.adapt'), $overrides + ['brand_id' => test()->brand->id, 'text' => 'Hoy estrenamos pan de masa madre en Panadería Sol.', 'targets' => test()->targets]);
+}
+
+test('devuelve una versión por red dentro de sus límites y no aplica nada', function () {
+    fakeVersions([(string) $this->ig->id => 'Pan de masa madre recién horneado. #pan #masamadre', (string) $this->bs->id => 'Pan de masa madre, hoy en Panadería Sol.']);
+
+    adapt()->assertOk()
+        ->assertJsonPath('results.0.account_id', $this->ig->id)
+        ->assertJsonPath('results.0.text', 'Pan de masa madre recién horneado. #pan #masamadre')
+        ->assertJsonPath('results.0.error', null)
+        ->assertJsonPath('results.1.account_id', $this->bs->id)
+        ->assertJsonPath('results.1.text', 'Pan de masa madre, hoy en Panadería Sol.')
+        ->assertJsonPath('remaining', 19);
+});
+
+test('una versión que excede el máximo de su red se rechaza con mensaje y no se trunca', function () {
+    $long = str_repeat('a', 301);
+    fakeVersions([(string) $this->ig->id => 'Versión corta para Instagram.', (string) $this->bs->id => $long]);
+
+    $response = adapt()->assertOk()
+        ->assertJsonPath('results.0.text', 'Versión corta para Instagram.')
+        ->assertJsonPath('results.1.text', null);
+    expect($response->json('results.1.error'))->toContain('301')->toContain('300');
+});
+
+test('una versión con más hashtags que el máximo de la red se rechaza', function () {
+    $tags = implode(' ', array_map(fn ($i) => "#tag$i", range(1, 31)));
+    fakeVersions([(string) $this->ig->id => "Pan. $tags", (string) $this->bs->id => 'Pan.']);
+
+    $response = adapt()->assertOk()->assertJsonPath('results.0.text', null)->assertJsonPath('results.1.text', 'Pan.');
+    expect($response->json('results.0.error'))->toContain('31 hashtags')->toContain('30');
+});
+
+test('JSON inválido: error manejable y la cuota se reembolsa', function () {
+    Http::fake(['api.anthropic.com/*' => Http::response(claudeText('No puedo hacerlo, lo siento.'))]);
+
+    adapt()->assertStatus(422)->assertJsonPath('remaining', 20);
+});
+
+test('si falta una red en la respuesta es un error y la cuota se reembolsa', function () {
+    fakeVersions([(string) $this->ig->id => 'Solo Instagram.']);
+
+    adapt()->assertStatus(422)->assertJsonPath('remaining', 20);
+});
+
+test('si ninguna versión cabe no se descuenta la cuota', function () {
+    fakeVersions([(string) $this->ig->id => str_repeat('a', 2201), (string) $this->bs->id => str_repeat('a', 301)]);
+
+    adapt()->assertOk()->assertJsonPath('results.0.text', null)->assertJsonPath('results.1.text', null)->assertJsonPath('remaining', 20);
+});
+
+test('una adaptación consume una sola unidad de cuota, no una por red', function () {
+    fakeVersions([(string) $this->ig->id => 'Instagram.', (string) $this->bs->id => 'Bluesky.']);
+
+    adapt()->assertOk()->assertJsonPath('remaining', 19);
+    Http::assertSentCount(1);
+});
+
+test('sin clave responde 409 con explicación y no llama a ningún servicio', function () {
+    config(['social.ai.api_key' => '']);
+    Http::fake();
+
+    adapt()->assertStatus(409)->assertJsonPath('message', 'El asistente IA no está activado.');
+    Http::assertNothingSent();
+});
+
+test('una marca de otro usuario responde 404 y no llama a la IA', function () {
+    Http::fake();
+    $other = Brand::factory()->for(User::factory()->create())->create();
+
+    adapt(['brand_id' => $other->id])->assertNotFound();
+    Http::assertNothingSent();
+});
+
+test('una cuenta que no es de la marca responde 404', function () {
+    Http::fake();
+    $foreign = SocialAccount::factory()->for(User::factory()->create())->create(['network' => Network::Instagram]);
+
+    adapt(['targets' => [['account_id' => $foreign->id, 'content_type' => 'instagram_image']]])->assertNotFound();
+    Http::assertNothingSent();
+});
+
+test('valida el texto, los destinos y el tipo de contenido', function () {
+    Http::fake();
+
+    adapt(['text' => ''])->assertStatus(422)->assertJsonValidationErrors('text');
+    adapt(['targets' => []])->assertStatus(422)->assertJsonValidationErrors('targets');
+    adapt(['targets' => [['account_id' => $this->ig->id, 'content_type' => 'nada']]])->assertStatus(422)->assertJsonValidationErrors('targets.0.content_type');
+    adapt(['targets' => [['account_id' => $this->ig->id, 'content_type' => 'bluesky_post']]])->assertStatus(422)->assertJsonValidationErrors('targets.0.content_type');
+    Http::assertNothingSent();
+});
+
+test('envía el texto sin datos personales y como dato, no como instrucción', function () {
+    fakeVersions([(string) $this->ig->id => 'Instagram.', (string) $this->bs->id => 'Bluesky.']);
+
+    adapt(['text' => 'Escríbenos a hola@sol.test o llama al +34 600 123 456 y visita https://sol.test/pan'])->assertOk();
+
+    Http::assertSent(function (Request $r) {
+        $body = (string) $r['messages'][0]['content'];
+
+        return str_contains($r['system'], 'dato') && ! str_contains($body, 'hola@sol.test') && ! str_contains($body, '600 123 456') && ! str_contains($body, 'sol.test/pan')
+            && str_contains($body, 'Panadería Sol') && str_contains($body, 'instagram');
+    });
+});
+
+test('los enlaces, correos y teléfonos redactados se restauran en la versión devuelta', function () {
+    Http::fake(function (Request $r) {
+        preg_match('/\[enlace\d+\]/', (string) $r['messages'][0]['content'], $m);
+
+        return Http::response(claudeText(json_encode(['versions' => [(string) $this->ig->id => "Mira {$m[0]}", (string) $this->bs->id => "Mira {$m[0]}"]])));
+    });
+
+    adapt(['text' => 'Mira https://sol.test/pan'])->assertOk()->assertJsonPath('results.0.text', 'Mira https://sol.test/pan');
+});
+
+test('hace falta sesión', function () {
+    $this->postJson(route('ai.adapt'), [])->assertUnauthorized();
+    $this->postJson(route('ai.alt'), [])->assertUnauthorized();
+});
+
+describe('alt text desde el compositor', function () {
+    beforeEach(function () {
+        $png = imagecreatetruecolor(300, 200);
+        ob_start();
+        imagepng($png);
+        $bytes = (string) ob_get_clean();
+        $this->image = MediaAsset::factory()->for($this->user)->create([
+            'disk' => 'local', 'path' => 'media/'.$this->user->id.'/photo.png', 'mime' => 'image/png', 'kind' => 'image', 'status' => 'listo',
+            'size' => strlen($bytes), 'width' => 300, 'height' => 200,
+        ]);
+        Storage::disk('local')->put($this->image->path, $bytes);
+        app(StudioAssets::class)->attach($this->user, $this->brand, $this->image->id);
+    });
+
+    test('genera un alt text editable de una imagen propia y consume una unidad', function () {
+        Http::fake(['api.anthropic.com/*' => Http::response(claudeText('  "Una barra de pan sobre una mesa de madera"  '))]);
+
+        $response = $this->actingAs($this->user)->postJson(route('ai.alt'), ['brand_id' => $this->brand->id, 'media_id' => $this->image->id])
+            ->assertOk()->assertJsonPath('text', 'Una barra de pan sobre una mesa de madera')->assertJsonPath('remaining', 19);
+        expect(mb_strlen($response->json('text')))->toBeLessThanOrEqual(TargetMedia::ALT_MAX);
+    });
+
+    test('una media de otro usuario responde 404 y no llama a la IA', function () {
+        Http::fake();
+        $foreign = MediaAsset::factory()->for(User::factory()->create())->create(['kind' => 'image', 'mime' => 'image/png', 'status' => 'listo']);
+
+        $this->actingAs($this->user)->postJson(route('ai.alt'), ['brand_id' => $this->brand->id, 'media_id' => $foreign->id])->assertNotFound();
+        Http::assertNothingSent();
+    });
+
+    test('una marca de otro usuario responde 404', function () {
+        Http::fake();
+        $other = Brand::factory()->for(User::factory()->create())->create();
+
+        $this->actingAs($this->user)->postJson(route('ai.alt'), ['brand_id' => $other->id, 'media_id' => $this->image->id])->assertNotFound();
+        Http::assertNothingSent();
+    });
+
+    test('sin clave responde 409 y no llama a ningún servicio', function () {
+        config(['social.ai.enabled' => false]);
+        Http::fake();
+
+        $this->actingAs($this->user)->postJson(route('ai.alt'), ['brand_id' => $this->brand->id, 'media_id' => $this->image->id])->assertStatus(409);
+        Http::assertNothingSent();
+    });
+});
diff --git a/tests/e2e/ai-adapt.spec.ts b/tests/e2e/ai-adapt.spec.ts
new file mode 100644
index 0000000..c33b4ee
--- /dev/null
+++ b/tests/e2e/ai-adapt.spec.ts
@@ -0,0 +1,190 @@
+import AxeBuilder from '@axe-core/playwright';
+import fs from 'node:fs';
+import path from 'node:path';
+import { expect, test, type Page } from '@playwright/test';
+import { animationsDone, artisan, cleanComposerBrands, e2eUser, expectNoOverflow, loginAs, seedComposerBrand, seedExtraAccount, settle, stamp, watch, type ComposerBrand } from './helpers';
+import { runRoot } from './isolated/runtime';
+
+/**
+ * Adaptar el texto a cada red con IA y generar el texto alternativo desde el compositor (T-82, E2E-21). La IA es FALSA dentro del servidor
+ * desechable (`tests/e2e/isolated/fakes.php`): con la bandera `studio-ai-on` atiende a Anthropic sin red y el servidor valida de verdad cada
+ * versión contra `media_specs`; con `studio-ai-text-off` el asistente no está configurado (la IA real es la prueba manual M-05).
+ * Usuarios `e2e-sec-*` y marcas `e2e-composer-*`.
+ */
+test.describe.configure({ mode: 'serial' });
+
+const flagOn = path.join(runRoot, 'studio-ai-on');
+const flagTextOff = path.join(runRoot, 'studio-ai-text-off');
+
+let brand: ComposerBrand;
+
+test.beforeEach(async ({ page }, info) => {
+    const user = e2eUser(info.project.name);
+    cleanComposerBrands(user.email);
+    brand = seedComposerBrand(user.email, `adapt-${stamp()}-${info.project.name}`);
+    seedExtraAccount(brand.id, 'bluesky', 'e2e Bluesky');
+    await loginAs(page, user);
+});
+
+test.afterEach(async ({}, info) => {
+    fs.rmSync(flagOn, { force: true });
+    fs.rmSync(flagTextOff, { force: true });
+    cleanComposerBrands(e2eUser(info.project.name).email);
+});
+
+async function axeNow(page: Page, label: string) {
+    await settle(page);
+    await expect(page.locator('#nprogress')).toHaveCount(0);
+    await page.mouse.move(0, 0);
+    await animationsDone(page);
+    const result = await new AxeBuilder({ page }).withTags(['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa']).analyze();
+    const bad = result.violations.filter((v) => v.impact === 'serious' || v.impact === 'critical');
+    expect(bad, `${label}: ${JSON.stringify(bad.map((v) => ({ id: v.id, nodes: v.nodes.map((n) => n.target) })))}`).toEqual([]);
+}
+
+const pill = (page: Page, name: RegExp) => page.getByRole('button', { name });
+const instagram = /^Instagram: e2e Instagram/;
+const bluesky = /^Bluesky: e2e Bluesky/;
+const adaptButton = (page: Page) => page.getByRole('button', { name: 'Adaptar a cada red' });
+const open = async (page: Page) => {
+    await page.goto(`/brands/${brand.id}/posts/create`);
+    await settle(page);
+};
+
+test('E2E-21 · sin clave el botón está inactivo y explica por qué', { tag: '@responsive' }, async ({ page }) => {
+    fs.writeFileSync(flagTextOff, 'asistente de texto apagado');
+    const w = watch(page);
+    await open(page);
+    await pill(page, instagram).click();
+    await page.getByLabel('Texto', { exact: true }).fill('Hoy estrenamos pan de masa madre.');
+
+    await expect(adaptButton(page)).toBeDisabled();
+    await expect(page.getByTestId('ai-adapt-unconfigured')).toContainText('no configurado');
+    await expect(adaptButton(page)).toHaveAccessibleDescription(/no configurado/);
+    await page.screenshot({ path: 'test-results/ai-adapt-sin-clave.png' });
+    await expectNoOverflow(page);
+    await axeNow(page, 'adaptar sin clave');
+    expect(w.errors, w.errors.join('\n')).toEqual([]);
+});
+
+test('E2E-21 · con IA, «Adaptar» muestra una versión por red dentro de sus límites y «Aplicar» rellena el texto de cada red', { tag: '@responsive' }, async ({ page }) => {
+    fs.writeFileSync(flagOn, 'proveedores de IA falsos');
+    const w = watch(page);
+    await open(page);
+    await pill(page, instagram).click();
+    await pill(page, bluesky).click();
+
+    // Sin texto el botón está inactivo y dice qué falta.
+    await expect(adaptButton(page)).toBeDisabled();
+    await expect(page.getByTestId('ai-adapt')).toContainText('Escribe el texto común');
+
+    await page.getByLabel('Texto', { exact: true }).fill('Hoy estrenamos pan de masa madre en la panadería.');
+    await expect(adaptButton(page)).toBeEnabled();
+    await page.screenshot({ path: 'test-results/ai-adapt-inicial.png' });
+    await adaptButton(page).click();
+
+    // Una versión por red, dentro de su límite, y NADA aplicado todavía.
+    const proposal = page.getByTestId('ai-adapt-proposal');
+    await expect(proposal).toBeVisible();
+    const versions = proposal.getByTestId('ai-adapt-version');
+    await expect(versions).toHaveCount(2);
+    await expect(versions.nth(0)).toContainText('Adaptado a instagram');
+    await expect(versions.nth(1)).toContainText('Adaptado a bluesky');
+    await expect(proposal.getByTestId('ai-adapt-rejected')).toHaveCount(0);
+    await expect(proposal.getByTestId('ai-adapt-count').first()).toHaveText(/^\d+ \/ 2\.200$/);
+    await expect(proposal.getByTestId('ai-adapt-count').nth(1)).toHaveText(/^\d+ \/ 300$/);
+    await expect(page.getByRole('button', { name: 'Editar por red' })).toHaveAttribute('aria-pressed', 'false');
+    await expectNoOverflow(page);
+    await axeNow(page, 'versiones propuestas');
+
+    // Aplicar: cada red queda con su texto propio (las pestañas se abren solas).
+    await proposal.getByTestId('ai-adapt-apply').click();
+    await expect(proposal).toHaveCount(0);
+    await expect(page.getByTestId('ai-adapt-applied')).toContainText('Aplicado a 2 redes');
+    await expect(page.getByRole('button', { name: 'Editar por red' })).toHaveAttribute('aria-pressed', 'true');
+    await page.getByRole('tab', { name: /Instagram/ }).click();
+    await expect(page.getByLabel('Texto de Instagram · e2e Instagram')).toHaveValue(/^Adaptado a instagram: Hoy estrenamos/);
+    await page.getByRole('tab', { name: /Bluesky/ }).click();
+    await expect(page.getByLabel('Texto de Bluesky · e2e Bluesky')).toHaveValue(/^Adaptado a bluesky: Hoy estrenamos/);
+    await expect(page.getByTestId('network-counters').getByTestId('counter-chars').first()).not.toContainText('supera el máximo');
+    await page.screenshot({ path: 'test-results/ai-adapt-aplicado.png' });
+    await expectNoOverflow(page);
+    expect(w.errors, w.errors.join('\n')).toEqual([]);
+});
+
+test('E2E-21 · una versión que no cabe se rechaza con su motivo y descartar no cambia nada', { tag: '@responsive' }, async ({ page }) => {
+    fs.writeFileSync(flagOn, 'proveedores de IA falsos');
+    await open(page);
+    await pill(page, instagram).click();
+    await pill(page, bluesky).click();
+    await page.getByLabel('Texto', { exact: true }).fill('Promoción e2e-excede de verano.');
+    await adaptButton(page).click();
+
+    const proposal = page.getByTestId('ai-adapt-proposal');
+    await expect(proposal.getByTestId('ai-adapt-version').nth(0)).toContainText('Adaptado a instagram');
+    await expect(proposal.getByTestId('ai-adapt-rejected')).toHaveCount(1);
+    await expect(proposal.getByTestId('ai-adapt-rejected')).toContainText('301 caracteres');
+    await expectNoOverflow(page);
+
+    await proposal.getByTestId('ai-adapt-discard').click();
+    await expect(proposal).toHaveCount(0);
+    await expect(page.getByRole('button', { name: 'Editar por red' })).toHaveAttribute('aria-pressed', 'false');
+    await expect(page.getByLabel('Texto', { exact: true })).toHaveValue('Promoción e2e-excede de verano.');
+});
+
+/** Post con una imagen común de la marca (ya vinculada a sus recursos, como lo hace la subida desde el compositor) y destino Bluesky. */
+function seedPostWithImage(brandId: number): { post: number; media: number; bsky: number } {
+    const out = artisan(
+        String.raw`$b = App\Models\Brand::withoutUserScope()->findOrFail(${brandId}); $u = App\Models\User::findOrFail($b->user_id); ` +
+            String.raw`$a = App\Models\MediaAsset::factory()->for($u)->create(['original_name' => 'alt.jpg', 'mime' => 'image/jpeg', 'path' => 'media/e2e/alt-' . uniqid() . '.jpg', 'width' => 400, 'height' => 400]); ` +
+            String.raw`$im = imagecreatetruecolor(400, 400); imagefill($im, 0, 0, imagecolorallocate($im, 240, 220, 40)); ob_start(); imagejpeg($im); $bytes = ob_get_clean(); ` +
+            String.raw`Illuminate\Support\Facades\Storage::disk($a->disk)->put($a->path, $bytes); $a->forceFill(['size' => strlen($bytes)])->save(); ` +
+            String.raw`app(App\Services\Studio\StudioAssets::class)->attach($u, $b, $a->id); ` +
+            String.raw`$bs = App\Models\SocialAccount::withoutUserScope()->where('brand_id', $b->id)->where('network', 'bluesky')->firstOrFail(); ` +
+            String.raw`$p = app(App\Services\PostService::class)->create($u, $b, ['text' => 'Alt text E2E', 'schedule' => false, 'media' => [$a->id], 'targets' => [['account_id' => $bs->id, 'content_type' => 'bluesky_post']]]); ` +
+            String.raw`echo 'SEED:' . json_encode(['post' => $p->id, 'media' => $a->id, 'bsky' => $bs->id]);`,
+    );
+    return JSON.parse(out.match(/SEED:(\{.*\})/)![1]);
+}
+
+test('E2E-21 · el alt text generado se puede editar antes de guardar', { tag: '@responsive' }, async ({ page }) => {
+    fs.writeFileSync(flagOn, 'proveedores de IA falsos');
+    const w = watch(page);
+    const s = seedPostWithImage(brand.id);
+    await page.goto(`/posts/${s.post}/edit`);
+    await settle(page);
+
