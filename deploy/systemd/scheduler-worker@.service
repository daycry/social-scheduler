# Worker de cola de Social Scheduler. Unidad plantilla: la instancia (%i) es la cola
# o lista de colas por prioridad que atiende ese worker.
#
#   scheduler-worker@publish.service          -> queue:work --queue=publish
#   scheduler-worker@poll.service             -> queue:work --queue=poll
#   scheduler-worker@metrics.service          -> queue:work --queue=metrics
#   scheduler-worker@reports.service          -> queue:work --queue=reports
#
# Instalacion en el VPS (ver deploy/systemd/README.md):
#   sudo cp deploy/systemd/scheduler-worker@.service /etc/systemd/system/
#   sudo sed -i 's#USUARIO#<usuario hestia>#g; s#DOMINIO#<dominio>#g; s#PHP_BIN=php#PHP_BIN=<php8.4>#' /etc/systemd/system/scheduler-worker@.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now scheduler-worker@publish scheduler-worker@poll scheduler-worker@metrics scheduler-worker@reports
# --timeout=120 debe ser MAYOR que el $timeout del job mas largo (RefreshSocialAccount: 100 s) y MENOR que
# retry_after de la cola (config/queue.php, 180 s); si no, un job lento se reencola mientras sigue en curso.
[Unit]
Description=Social Scheduler queue worker (%i)
After=network.target mysql.service mariadb.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=USUARIO
Group=USUARIO
WorkingDirectory=/home/USUARIO/web/DOMINIO/app
# PHP CLI configurable: el nombre o ruta del binario (php8.4, /usr/bin/php8.4...) se fija aqui
# o con un drop-in (`systemctl edit`); debe coincidir con PHP_BIN de deploy.sh.
Environment=PHP_BIN=php
ExecStart=/usr/bin/env ${PHP_BIN} artisan queue:work database --queue=%i --sleep=3 --tries=3 --timeout=120 --max-time=3600 --max-jobs=500
# `queue:restart` hace que el worker termine limpiamente; systemd lo relanza.
Restart=always
RestartSec=5
# Deja terminar el job en curso antes de matar el proceso: debe ser > --timeout (120 s).
TimeoutStopSec=130
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=scheduler-worker-%i

# Sandboxing basico: el worker solo escribe en storage/ y bootstrap/cache.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/USUARIO/web/DOMINIO/app/storage /home/USUARIO/web/DOMINIO/app/bootstrap/cache
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
