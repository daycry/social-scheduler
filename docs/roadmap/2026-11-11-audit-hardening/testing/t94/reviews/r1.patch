+
+test('an animation per object persists exactly and survives a later revision', function () {
+    $animation = ['in' => ['type' => 'slide_left', 'duration' => 0.5, 'delay' => 0.25, 'easing' => 'ease_out'], 'out' => ['type' => 'fade', 'duration' => 1]];
+    $doc = animatedScene($animation);
+    $created = $this->postJson($this->url, ['name' => 'Animado', 'document' => $doc])->assertCreated()->json('design');
+    expect($created['document'])->toBe($doc);
+    $this->patchJson('/studio/designs/'.$created['id'], ['name' => 'Animado', 'document' => $doc, 'revision' => 1])
+        ->assertOk()->assertJsonPath('design.document.pages.0.elements.0.animation', $animation);
+});
+
+test('every animation type and easing is accepted, also on an element without its own timing window', function (string $type) {
+    foreach (['linear', 'ease_in', 'ease_out', 'ease_in_out'] as $easing) {
+        $doc = animatedScene(['in' => ['type' => $type, 'duration' => 1, 'easing' => $easing]], null);
+        $this->postJson($this->url, ['name' => "$type $easing", 'document' => $doc])->assertCreated();
+    }
+})->with(['fade', 'slide_left', 'slide_right', 'slide_up', 'slide_down', 'zoom']);
+
+test('invalid animations are rejected', function (array $animation) {
+    $this->postJson($this->url, ['name' => 'Mala', 'document' => animatedScene($animation)])->assertUnprocessable();
+})->with([
+    'unknown type' => [['in' => ['type' => 'spin', 'duration' => 1]]],
+    'unknown easing' => [['in' => ['type' => 'fade', 'duration' => 1, 'easing' => 'bounce']]],
+    'unknown phase' => [['middle' => ['type' => 'fade', 'duration' => 1]]],
+    'unknown field' => [['in' => ['type' => 'fade', 'duration' => 1, 'script' => 'x']]],
+    'empty animation' => [[]],
+    'duration too short' => [['in' => ['type' => 'fade', 'duration' => 0.01]]],
+    'duration too long' => [['in' => ['type' => 'fade', 'duration' => 11]]],
+    'negative delay' => [['in' => ['type' => 'fade', 'duration' => 1, 'delay' => -1]]],
+    'string duration' => [['in' => ['type' => 'fade', 'duration' => '1']]],
+    'missing duration' => [['in' => ['type' => 'fade']]],
+    'phase is a list' => [['in' => [['type' => 'fade', 'duration' => 1]]]],
+    'in does not fit the object life' => [['in' => ['type' => 'fade', 'duration' => 2, 'delay' => 1.5]]],
+    'in and out overlap' => [['in' => ['type' => 'fade', 'duration' => 2], 'out' => ['type' => 'zoom', 'duration' => 1.5]]],
+]);
+
+test('an object that lives too little cannot carry the animation, but an exact fit is valid', function () {
+    $short = animatedScene(['in' => ['type' => 'fade', 'duration' => 1]], ['start' => 0, 'duration' => 0.5]);
+    $this->postJson($this->url, ['name' => 'Corto', 'document' => $short])->assertUnprocessable();
+    $exact = animatedScene(['in' => ['type' => 'fade', 'duration' => 1, 'delay' => 1], 'out' => ['type' => 'fade', 'duration' => 1]], ['start' => 0, 'duration' => 3]);
+    $this->postJson($this->url, ['name' => 'Justo', 'document' => $exact])->assertCreated();
+});
+
+test('animations also validate inside groups and v1 documents keep rejecting them', function () {
+    $doc = animatedScene(['in' => ['type' => 'fade', 'duration' => 1]]);
+    $child = $doc['pages'][0]['elements'][0];
+    $doc['pages'][0]['elements'] = [['id' => 'box', 'type' => 'group', 'x' => 0, 'y' => 0, 'width' => 300, 'height' => 100, 'elements' => [$child]]];
+    $this->postJson($this->url, ['name' => 'Grupo', 'document' => $doc])->assertCreated();
+    $doc['pages'][0]['elements'][0]['elements'][0]['animation']['in']['duration'] = 99;
+    $this->postJson($this->url, ['name' => 'Grupo malo', 'document' => $doc])->assertUnprocessable();
+    $v1 = animatedScene(['in' => ['type' => 'fade', 'duration' => 1]]);
+    unset($v1['timeline'], $v1['pages'][0]['elements'][0]['timing']);
+    $v1['schema_version'] = 1;
+    $this->postJson($this->url, ['name' => 'v1', 'document' => $v1])->assertUnprocessable();
+});
+
+test('a design without animations is stored exactly as before', function () {
+    $doc = animatedScene(['in' => ['type' => 'fade', 'duration' => 1]]);
+    unset($doc['pages'][0]['elements'][0]['animation']);
+    $created = $this->postJson($this->url, ['name' => 'Sin animar', 'document' => $doc])->assertCreated()->json('design');
+    expect($created['document'])->toBe($doc)->and(json_encode($created['document']))->not->toContain('animation');
+});
+
+test('server rendering of a frame at a chosen instant receives the animated document untouched', function () {
+    $doc = animatedScene(['in' => ['type' => 'zoom', 'duration' => 0.5], 'out' => ['type' => 'slide_right', 'duration' => 0.5]]);
+    $design = app(StudioService::class)->create($this->user, $this->brand, ['name' => 'Render', 'document' => $doc]);
+    $export = app(StudioRenderer::class)->export($this->user, $design, ['revision' => 1, 'format' => 'png', 'pages' => ['page_1'], 'frame_times' => [['page_id' => 'page_1', 'time' => 1.25]]]);
+    Process::fake(function ($process) use ($doc) {
+        $sent = json_decode($process->input, true);
+        expect($sent['document']['pages'][0]['elements'][0]['animation'])->toBe($doc['pages'][0]['elements'][0]['animation']);
+        $image = imagecreatetruecolor(320, 180);
+        imagepng($image, $process->command[2].DIRECTORY_SEPARATOR.'page-001.png');
+        imagedestroy($image);
+
+        return Process::result(output: '{"files":[{"name":"page-001.png","mime":"image/png"}]}');
+    });
+    app(StudioRenderer::class)->render($export->id);
+    expect($export->refresh()->status)->toBe('ready', $export->error ?? '');
+});
+
+test('only the owner can store or edit a design with animations', function () {
+    $doc = animatedScene(['in' => ['type' => 'fade', 'duration' => 1]]);
+    $design = $this->postJson($this->url, ['name' => 'Mío', 'document' => $doc])->assertCreated()->json('design');
+    $intruder = User::factory()->create();
+    $this->actingAs($intruder);
+    $this->patchJson('/studio/designs/'.$design['id'], ['name' => 'Robado', 'document' => $doc, 'revision' => 1])->assertNotFound();
+    $this->postJson($this->url, ['name' => 'Ajena', 'document' => $doc])->assertNotFound();
+});
diff --git a/tests/e2e/studio-object-animation.spec.ts b/tests/e2e/studio-object-animation.spec.ts
new file mode 100644
index 0000000..344a9c8
--- /dev/null
+++ b/tests/e2e/studio-object-animation.spec.ts
@@ -0,0 +1,76 @@
+import { expect, test } from '@playwright/test';
+import { cleanComposerBrands, e2eUser, expectNoOverflow, loginAs, seedComposerBrand, stamp } from './helpers';
+
+const near = (pixel: number[], expected: number[], tolerance = 12) => pixel.every((value, i) => Math.abs(value - expected[i]) <= tolerance);
+
+test('Studio object animation: animate an object, see it in two instants of the preview and export the frame that matches', { tag: '@responsive' }, async ({ page }, info) => {
+    const user = e2eUser(info.project.name), errors: string[] = [];
+    cleanComposerBrands(user.email);
+    const brand = seedComposerBrand(user.email, `studio-animation-${stamp()}-${info.project.name}`);
+    page.on('pageerror', error => errors.push(error.message));
+    page.on('console', message => { if (message.type() === 'error') errors.push(message.text()); });
+    try {
+        await loginAs(page, user); await page.goto(`/studio?brand_id=${brand.id}`);
+        const design = await page.evaluate(async brandId => {
+            const csrf = decodeURIComponent((document.cookie.match(/(?:^|; )XSRF-TOKEN=([^;]+)/) ?? [])[1] ?? '');
+            const response = await fetch(`/brands/${brandId}/studio/designs`, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-XSRF-TOKEN': csrf },
+                body: JSON.stringify({ name: 'Animado', document: { schema_version: 2, width: 100, height: 100, timeline: { fps: 30, audio_tracks: [] }, pages: [
+                    { id: 'one', name: 'Una', duration: 4, background: '#ffffff', elements: [{ id: 'red', type: 'rect', name: 'Cuadro rojo', x: 0, y: 0, width: 100, height: 100, fill: '#ff0000' }] },
+                ] } }) });
+            if (!response.ok) throw new Error(await response.text());
+            return (await response.json()).design;
+        }, brand.id);
+        await page.goto(`/studio/designs/${design.id}/edit`);
+        const timeline = page.getByRole('region', { name: 'Línea de tiempo', exact: true });
+        await expect(timeline).toBeVisible();
+        await timeline.getByRole('button', { name: 'Seleccionar clip Cuadro rojo', exact: true }).click();
+        // Sin animación declarada, el objeto sigue como antes.
+        await expect(timeline.getByTestId('timeline-animation-in')).toHaveCount(0);
+        await timeline.getByLabel('Entrada', { exact: true }).selectOption('fade');
+        const duration = timeline.getByLabel('Duración de la entrada (s)', { exact: true });
+        await duration.fill('1'); await duration.press('Tab');
+        await timeline.getByLabel('Curva de la entrada', { exact: true }).selectOption({ label: 'Lineal' });
+        await expect(timeline.getByTestId('timeline-animation-in')).toHaveCount(1);
+        await page.getByRole('button', { name: 'Guardar ahora', exact: true }).click();
+        await expect(page.getByTestId('studio-save-status')).toHaveText('Guardado');
+        const stored = await page.evaluate(async id => (await (await fetch(`/studio/designs/${id}`, { headers: { Accept: 'application/json' } })).json()).design.document, design.id);
+        expect(stored.pages[0].elements[0].animation).toEqual({ in: { type: 'fade', duration: 1, easing: 'linear' } });
+
+        const clock = timeline.getByLabel('Tiempo de reproducción', { exact: true });
+        const preview = page.getByLabel('Previsualización de la línea de tiempo', { exact: true });
+        const pixel = () => preview.evaluate(canvas => [...(canvas as HTMLCanvasElement).getContext('2d')!.getImageData(50, 50, 1, 1).data]);
+        // El reloj parte de 0: el primer instante debe cambiar para que se genere la previsualización.
+        const instants = [[2, [255, 0, 0, 255]], [0.5, [255, 128, 128, 255]], [0, [255, 255, 255, 255]]] as const;
+        for (const [second, expected] of instants) {
+            await clock.fill(String(second)); await clock.press('Tab');
+            await expect.poll(async () => near(await pixel(), [...expected]), { message: `previsualización en ${second} s` }).toBe(true);
+        }
+        await page.screenshot({ path: info.outputPath('object-animation-preview.png'), fullPage: true });
+
+        // El fotograma exportado en el instante elegido coincide con la previsualización.
+        await clock.fill('0.5'); await clock.press('Tab');
+        await page.getByRole('button', { name: 'Exportar', exact: true }).click();
+        const dialog = page.getByRole('dialog', { name: 'Exportar diseño', exact: true });
+        const time = dialog.getByLabel('Fotograma de Una (s)', { exact: true });
+        await expect(time).toHaveValue('0.5');
+        for (const [second, expected] of [[0.5, [255, 128, 128, 255]], [2, [255, 0, 0, 255]]] as const) {
+            await time.fill(String(second));
+            const registration = page.waitForResponse(response => response.url().endsWith(`/studio/designs/${design.id}/exports`) && response.request().method() === 'POST');
+            await dialog.getByRole('button', { name: 'Guardar en biblioteca', exact: true }).click();
+            const response = await registration; expect(response.status()).toBe(201);
+            const result = (await response.json()).export;
+            const exported = await page.evaluate(async ({ brandId, mediaId }) => {
+                const data = await (await fetch(`/brands/${brandId}/studio/assets`, { headers: { Accept: 'application/json' } })).json();
+                const asset = data.assets.find((asset: { id: number }) => asset.id === mediaId);
+                const bitmap = await createImageBitmap(await (await fetch(asset.preview_url)).blob());
+                try { const canvas = document.createElement('canvas'); canvas.width = canvas.height = 100; const context = canvas.getContext('2d')!;
+                    context.drawImage(bitmap, 0, 0); return [...context.getImageData(50, 50, 1, 1).data]; }
+                finally { bitmap.close(); }
+            }, { brandId: brand.id, mediaId: result.media_ids[0] });
+            expect(near(exported, [...expected]), `fotograma exportado en ${second} s: ${exported}`).toBe(true);
+            await expect(dialog.getByRole('status')).toContainText('biblioteca');
+        }
+        await dialog.getByRole('button', { name: 'Cerrar exportación', exact: true }).click();
+        await expectNoOverflow(page); expect(errors).toEqual([]);
+    } finally { cleanComposerBrands(user.email); }
+});
diff --git a/tests/frontend/studio-object-animation.test.mjs b/tests/frontend/studio-object-animation.test.mjs
new file mode 100644
index 0000000..5c5a236
--- /dev/null
+++ b/tests/frontend/studio-object-animation.test.mjs
@@ -0,0 +1,184 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { animationState, fitAnimation, normalizeAnimation } from '../../resources/js/Studio/object-animation.js';
+import { applyElementAnimation } from '../../resources/js/Studio/animation-scene.js';
+import { blankDocument, newElement, validateDocument } from '../../resources/js/Studio/document.js';
+import { restrictElementWindow, splitTimelineElement } from '../../resources/js/Studio/timeline.js';
+
+const near = (actual, expected, message) =>
+    assert.ok(Math.abs(actual - expected) < 1e-9, `${message ?? ''} ${actual} != ${expected}`);
+const window = { start: 1, duration: 4 };
+
+function scene(animation, timing = window) {
+    const doc = blankDocument(320, 180);
+    doc.schema_version = 2;
+    doc.timeline = { fps: 30, audio_tracks: [] };
+    doc.pages[0].duration = 6;
+    doc.pages[0].elements = [
+        newElement('text', {
+            id: 'title',
+            text: 'Hola',
+            ...(timing ? { timing } : {}),
+            ...(animation ? { animation } : {}),
+        }),
+    ];
+    return doc;
+}
+
+test('without animation the state is the identity, so old designs render as before', () => {
+    for (const time of [0, 1, 2.5, 5])
+        assert.deepEqual(animationState(undefined, time, window), { opacity: 1, offsetX: 0, offsetY: 0, scale: 1 });
+});
+
+test('fade in: hidden before the entry, half way at the middle, fully visible at the end', () => {
+    const animation = { in: { type: 'fade', duration: 1, delay: 0.5, easing: 'linear' } };
+    near(animationState(animation, 1.2, window).opacity, 0, 'antes de la entrada');
+    near(animationState(animation, 1.5, window).opacity, 0, 'inicio de la entrada');
+    near(animationState(animation, 2, window).opacity, 0.5, 'mitad');
+    near(animationState(animation, 2.5, window).opacity, 1, 'fin');
+    near(animationState(animation, 4, window).opacity, 1, 'después');
+});
+
+test('fade out ends at the end of the window minus the delay and stays hidden afterwards', () => {
+    const animation = { out: { type: 'fade', duration: 1, delay: 0.5, easing: 'linear' } };
+    near(animationState(animation, 3.5, window).opacity, 1, 'antes de la salida');
+    near(animationState(animation, 4, window).opacity, 0.5, 'mitad de la salida');
+    near(animationState(animation, 4.5, window).opacity, 0, 'fin de la salida');
+    near(animationState(animation, 4.9, window).opacity, 0, 'retardo final');
+});
+
+test('slides move from and towards their side by a quarter of the page, zoom scales from half', () => {
+    const slide = (type) => animationState({ in: { type, duration: 1, easing: 'linear' } }, 1, window);
+    assert.deepEqual([slide('slide_left').offsetX, slide('slide_left').offsetY], [-0.25, 0]);
+    assert.deepEqual([slide('slide_right').offsetX, slide('slide_right').offsetY], [0.25, 0]);
+    assert.deepEqual([slide('slide_up').offsetX, slide('slide_up').offsetY], [0, -0.25]);
+    assert.deepEqual([slide('slide_down').offsetX, slide('slide_down').offsetY], [0, 0.25]);
+    near(animationState({ in: { type: 'zoom', duration: 1, easing: 'linear' } }, 1, window).scale, 0.5, 'zoom inicial');
+    near(
+        animationState({ in: { type: 'zoom', duration: 1, easing: 'linear' } }, 1.5, window).scale,
+        0.75,
+        'zoom a mitad',
+    );
+    const out = animationState({ out: { type: 'slide_left', duration: 1, easing: 'linear' } }, 5, window);
+    near(out.offsetX, -0.25, 'la salida se va hacia su lado');
+    near(out.opacity, 0, 'la salida termina transparente');
+});
+
+test('easing curves keep the endpoints and differ in the middle', () => {
+    const at = (easing) => animationState({ in: { type: 'fade', duration: 1, easing } }, 1.25, window).opacity;
+    near(at('linear'), 0.25);
+    assert.ok(at('ease_in') < 0.25 && at('ease_out') > 0.25 && at('ease_in_out') < 0.25);
+    for (const easing of ['linear', 'ease_in', 'ease_out', 'ease_in_out']) {
+        near(animationState({ in: { type: 'fade', duration: 1, easing } }, 1, window).opacity, 0, easing);
+        near(animationState({ in: { type: 'fade', duration: 1, easing } }, 2, window).opacity, 1, easing);
+    }
+});
+
+test('the document validator accepts valid animations and rejects the invalid ones', () => {
+    const valid = {
+        in: { type: 'slide_left', duration: 0.5, delay: 0.25, easing: 'ease_out' },
+        out: { type: 'zoom', duration: 1 },
+    };
+    assert.deepEqual(validateDocument(scene(valid)).pages[0].elements[0].animation, valid);
+    assert.equal(Object.hasOwn(validateDocument(scene(null)).pages[0].elements[0], 'animation'), false);
+    const bad = [
+        { in: { type: 'spin', duration: 1 } },
+        { in: { type: 'fade', duration: 0.01 } },
+        { in: { type: 'fade', duration: 11 } },
+        { in: { type: 'fade', duration: 1, delay: -1 } },
+        { in: { type: 'fade', duration: 1, easing: 'bounce' } },
+        { in: { type: 'fade', duration: 1, extra: 1 } },
+        { middle: { type: 'fade', duration: 1 } },
+        {},
+        { in: { type: 'fade', duration: 3, delay: 1.5 } },
+        { in: { type: 'fade', duration: 2 }, out: { type: 'fade', duration: 2.5 } },
+    ];
+    for (const animation of bad)
+        assert.throws(
+            () => validateDocument(scene(animation)),
+            /animaci|propiedad|duraci|retardo|tipo|curva|entrada|caben/i,
+            JSON.stringify(animation),
+        );
+});
+
+test('v1 documents still reject animations', () => {
+    const doc = scene({ in: { type: 'fade', duration: 1 } }, null);
+    doc.schema_version = 1;
+    delete doc.timeline;
+    assert.throws(() => validateDocument(doc), /animation|propiedad/);
+});
+
+test('fitAnimation drops the phases that no longer fit and normalizeAnimation checks the object life', () => {
+    const animation = { in: { type: 'fade', duration: 1 }, out: { type: 'fade', duration: 2 } };
+    assert.deepEqual(fitAnimation(animation, 3), animation);
+    assert.deepEqual(fitAnimation(animation, 2), { in: animation.in });
+    assert.equal(fitAnimation(animation, 0.5), null);
+    assert.throws(() => normalizeAnimation(animation, 2.9, 'animation'), /caben/);
+});
+
+test('splitting a clip keeps the entry on the first half and the exit on the second', () => {
+    const doc = scene({ in: { type: 'fade', duration: 0.5 }, out: { type: 'zoom', duration: 0.5 } });
+    const result = splitTimelineElement(doc, doc.pages[0].id, 'title', 3, { createId: () => 'second_half' });
+    const [left, right] = result.pages[0].elements;
+    assert.deepEqual(left.animation, { in: { type: 'fade', duration: 0.5 } });
+    assert.deepEqual(right.animation, { out: { type: 'zoom', duration: 0.5 } });
+});
+
+test('restricting a window removes only the phases that do not fit', () => {
+    const element = scene({ in: { type: 'fade', duration: 1 }, out: { type: 'fade', duration: 1 } }).pages[0]
+        .elements[0];
+    const result = restrictElementWindow(element, { start: 1, duration: 1.5 }, { pageDuration: 6 });
+    assert.deepEqual(result.animation, { in: { type: 'fade', duration: 1 } });
+    assert.equal(
+        Object.hasOwn(restrictElementWindow(element, { start: 1, duration: 0.5 }, { pageDuration: 6 }), 'animation'),
+        false,
+    );
+});
+
+function fakeObject() {
+    const object = {
+        left: 10,
+        top: 20,
+        scaleX: 2,
+        scaleY: 2,
+        opacity: 0.8,
+        dirty: false,
+        getRelativeCenterPoint() {
+            return { x: this.left + 50, y: this.top + 25 };
+        },
+        set(values) {
+            Object.assign(this, values);
+        },
+        setPositionByOrigin(point) {
+            this.left = point.x - 50;
+            this.top = point.y - 25;
+        },
+        setCoords() {},
+    };
+    return object;
+}
+
+test('applying the state starts from the stored base and does not accumulate when repeated', () => {
+    const element = { timing: window, animation: { in: { type: 'slide_right', duration: 1, easing: 'linear' } } };
+    const size = { width: 320, height: 180, pageDuration: 6 };
+    const object = fakeObject();
+    applyElementAnimation(object, element, 1, size);
+    near(object.opacity, 0);
+    near(object.left, 10 + 0.25 * 320);
+    applyElementAnimation(object, element, 1.5, size);
+    applyElementAnimation(object, element, 1.5, size);
+    near(object.opacity, 0.4);
+    near(object.left, 10 + 0.125 * 320);
+    applyElementAnimation(object, element, 3, size);
+    near(object.opacity, 0.8);
+    near(object.left, 10);
+    near(object.top, 20);
+});
+
+test('an element without animation leaves its object untouched', () => {
+    const object = fakeObject();
+    const before = JSON.stringify(object);
+    applyElementAnimation(object, { timing: window }, 1.5, { width: 320, height: 180, pageDuration: 6 });
+    assert.equal(JSON.stringify(object), before);
+    assert.equal(object.studioAnimationBase, undefined);
+});
