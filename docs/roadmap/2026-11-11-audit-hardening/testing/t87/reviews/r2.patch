+<?php
+
+namespace App\Connectors\Mastodon;
+
+use App\Services\Media\UnsafeUrlException;
+use App\Services\Media\UrlGuard;
+use App\Support\SafeUrl;
+use Carbon\CarbonImmutable;
+use Closure;
+use Illuminate\Http\Client\ConnectionException;
+use Illuminate\Http\Client\PendingRequest;
+use Illuminate\Http\Client\RequestException;
+use Illuminate\Http\Client\Response;
+use Illuminate\Support\Facades\Http;
+use Psr\Http\Message\ResponseInterface;
+
+/**
+ * Cliente de la API REST de una instancia de Mastodon (T-87). La instancia la escribe el usuario, asi que toda peticion pasa por la guardia SSRF:
+ * la URL se valida (DNS incluido) justo antes de pedirla, la conexion se fija a la IP validada, no se siguen redirecciones y solo se admite https.
+ * No guarda estado: el token se pasa por llamada (cabecera `Authorization`) y nunca se registra.
+ */
+class MastodonClient
+{
+    /**
+     * Normaliza lo que escribe el usuario a `https://host`: sin esquema se asume https, un `http://` se rechaza y no se admiten ruta, parametros,
+     * usuario ni un puerto distinto de 443. El host tiene que ser publico.
+     *
+     * @throws MastodonException
+     */
+    public function normalizeInstance(string $input): string
+    {
+        $input = trim($input);
+        $url = preg_match('~^[a-z][a-z0-9+.-]*://~i', $input) === 1 ? $input : 'https://'.$input;
+        $parts = parse_url($url);
+
+        if ($parts === false || ! isset($parts['host'])) {
+            throw new MastodonException('Escribe la dirección de tu instancia de Mastodon, por ejemplo mastodon.social.');
+        }
+        if (strtolower((string) ($parts['scheme'] ?? '')) !== 'https') {
+            throw new MastodonException('La instancia de Mastodon tiene que usar https.');
+        }
+        $path = (string) ($parts['path'] ?? '');
+        if (($path !== '' && $path !== '/') || isset($parts['query']) || isset($parts['fragment']) || isset($parts['user']) || isset($parts['pass']) || (isset($parts['port']) && $parts['port'] !== 443)) {
+            throw new MastodonException('Escribe solo la dirección de la instancia (sin ruta, puerto ni parámetros), por ejemplo mastodon.social.');
+        }
+
+        try {
+            return 'https://'.app(UrlGuard::class)->validate('https://'.$parts['host'])->host;
+        } catch (UnsafeUrlException) {
+            throw new MastodonException('Esa instancia de Mastodon no es válida o no es pública.');
+        }
+    }
+
+    /**
+     * Datos de la instancia, sin autenticar (`GET /api/v2/instance`): de ahi salen los limites.
+     *
+     * @return array<string, mixed>
+     */
+    public function instance(string $base): array
+    {
+        return (array) $this->send($base, '/api/v2/instance', fn (PendingRequest $http, string $url) => $http->get($url))->json();
+    }
+
+    /**
+     * Cuenta del token (`GET /api/v1/accounts/verify_credentials`).
+     *
+     * @return array<string, mixed> id, username, acct, display_name, avatar, url...
+     */
+    public function verifyCredentials(string $base, #[\SensitiveParameter] string $token): array
+    {
+        return (array) $this->send($base, '/api/v1/accounts/verify_credentials', fn (PendingRequest $http, string $url) => $http->withToken($token)->get($url))->json();
+    }
+
+    /**
+     * Sube una imagen (`POST /api/v2/media`, multipart). 200 = lista; 202 = Mastodon sigue procesandola (hay que sondear `media()`).
+     *
+     * @return array{status: int, media: array<string, mixed>}
+     */
+    public function uploadMedia(string $base, #[\SensitiveParameter] string $token, string $bytes, string $mime, string $filename, ?string $description): array
+    {
+        $response = $this->send($base, '/api/v2/media', fn (PendingRequest $http, string $url) => $http->withToken($token)
+            ->attach('file', $bytes, $filename, ['Content-Type' => $mime])
+            ->post($url, $description !== null && $description !== '' ? ['description' => $description] : []));
+
+        return ['status' => $response->status(), 'media' => (array) $response->json()];
+    }
+
+    /**
+     * Estado de una imagen subida (`GET /api/v1/media/:id`): 200 = lista, 206 = procesandose.
+     *
+     * @return array{status: int, media: array<string, mixed>}
+     */
+    public function media(string $base, #[\SensitiveParameter] string $token, string $id): array
+    {
+        $response = $this->send($base, '/api/v1/media/'.rawurlencode($id), fn (PendingRequest $http, string $url) => $http->withToken($token)->get($url));
+
+        return ['status' => $response->status(), 'media' => (array) $response->json()];
+    }
+
+    /**
+     * Crea el estado (`POST /api/v1/statuses`). La instancia guarda la `Idempotency-Key` una hora: repetirla devuelve el estado ya creado.
+     *
+     * @param  array<string, mixed>  $body
+     * @return array<string, mixed> El Status (id, url, uri...)
+     */
+    public function createStatus(string $base, #[\SensitiveParameter] string $token, array $body, string $idempotencyKey): array
+    {
+        return (array) $this->send($base, '/api/v1/statuses', fn (PendingRequest $http, string $url) => $http->withToken($token)->withHeaders(['Idempotency-Key' => $idempotencyKey])->asJson()->post($url, $body))->json();
+    }
+
+    /**
+     * @param  Closure(PendingRequest, string): Response  $call  Recibe el cliente y la URL validada.
+     *
+     * @throws MastodonException
+     */
+    private function send(string $base, string $path, Closure $call): Response
+    {
+        $guard = app(UrlGuard::class);
+
+        try {
+            $validated = $guard->validate(rtrim($base, '/').$path);
+        } catch (UnsafeUrlException) {
+            throw self::unsafe('La instancia de Mastodon no es válida o no es pública.');
+        }
+        if ($validated->scheme !== 'https') {
+            throw self::unsafe('La instancia de Mastodon tiene que usar https.');
+        }
+
+        // Tope del cuerpo: se corta por la cabecera `Content-Length` y, sin ella (troceado), en cuanto lo descargado lo pasa. Opciones nativas de Guzzle: no
+        // cambian el manejador cURL, asi que la IP fijada sigue aplicandose (`stream => true` la rechazaria).
+        $cap = max(1024, (int) config('social.mastodon.max_response_bytes', 1_048_576));
+        $exceeded = false;
+        $http = Http::acceptJson()->timeout((int) config('social.http_timeout', 15))->withoutRedirecting()->withOptions($guard->requestOptions($validated) + [
+            'on_headers' => function (ResponseInterface $response) use ($cap, &$exceeded): void {
+                if ((int) $response->getHeaderLine('Content-Length') > $cap) {
+                    $exceeded = true;
+
+                    throw self::tooBig();
+                }
+            },
+            // Abortar desde el callback de cURL llega como un fallo de conexion: `$exceeded` distingue el corte por tamano.
+            'progress' => function ($downloadTotal, $downloaded) use ($cap, &$exceeded): void {
+                if ($downloaded > $cap) {
+                    $exceeded = true;
+
+                    throw self::tooBig();
+                }
+            },
+        ]);
+
+        try {
+            $response = $call($http, $validated->url);
+        } catch (ConnectionException) {
+            throw $exceeded ? self::tooBig() : new MastodonException('No se pudo conectar con la instancia de Mastodon.');
+        } catch (RequestException $e) {
+            // Respuesta cortada a mitad o error del cliente HTTP: se trata como el error HTTP que traia, nunca como un fallo sin controlar.
+            throw new MastodonException('La instancia de Mastodon respondió con un error.', $e->response->status());
+        }
+
+        if (strlen($response->body()) > $cap) {
+            throw self::tooBig();
+        }
+
+        if ($response->status() >= 300 && $response->status() < 400) {
+            throw new MastodonException('La instancia de Mastodon respondió con una redirección que no se admite.', $response->status());
+        }
+
+        if ($response->failed()) {
+            $error = $response->json('error');
+            $detail = is_string($error) ? mb_substr(trim((string) preg_replace('/[\x00-\x1f\x7f\s]+/u', ' ', $error)), 0, 200) : '';
+
+            throw new MastodonException('La instancia de Mastodon respondió con un error.', $response->status(), $response->status() === 429 ? self::retryAt($response) : null, $detail);
+        }
+
+        return $response;
+    }
+
+    private static function tooBig(): MastodonException
+    {
+        return new MastodonException('La respuesta de la instancia de Mastodon es demasiado grande.', 502);
+    }
+
+    /**
+     * URL que viene de una instancia ajena, saneada: https y sin caracteres raros (`SafeUrl`) y, si se pide, del host de la instancia. Si no, null.
+     */
+    public static function safeUrl(mixed $url, ?string $host = null): ?string
+    {
+        if (! is_string($url) || ! SafeUrl::isSafe($url) || strtolower((string) parse_url($url, PHP_URL_SCHEME)) !== 'https') {
+            return null;
+        }
+
+        return $host === null || strtolower((string) parse_url($url, PHP_URL_HOST)) === strtolower($host) ? $url : null;
+    }
+
+    /** Instancia no permitida: no es un fallo de red (reintentar no lo arregla), asi que lleva un 400 y su motivo. */
+    private static function unsafe(string $message): MastodonException
+    {
+        return new MastodonException($message, 400, null, $message);
+    }
+
+    /** Cuando se libera el limite: `Retry-After` (segundos) o `X-RateLimit-Reset` (fecha o marca de tiempo); nada si ninguna cabecera es legible. */
+    private static function retryAt(Response $response): ?CarbonImmutable
+    {
+        $after = trim($response->header('Retry-After'));
+        if (ctype_digit($after) && $after !== '') {
+            return CarbonImmutable::now()->addSeconds(min((int) $after, 86400));
+        }
+
+        $reset = trim($response->header('X-RateLimit-Reset'));
+        if ($reset === '') {
+            return null;
+        }
+
+        try {
+            $at = ctype_digit($reset) ? CarbonImmutable::createFromTimestamp((int) $reset) : CarbonImmutable::parse($reset);
+        } catch (\Throwable) {
+            return null;
+        }
+
+        return $at->isFuture() && $at->lte(CarbonImmutable::now()->addDay()) ? $at : null;
+    }
+}
diff --git a/app/Connectors/Mastodon/MastodonConnector.php b/app/Connectors/Mastodon/MastodonConnector.php
new file mode 100644
index 0000000..5027e0a
--- /dev/null
+++ b/app/Connectors/Mastodon/MastodonConnector.php
@@ -0,0 +1,114 @@
+<?php
+
+namespace App\Connectors\Mastodon;
+
+use App\Connectors\Contracts\CredentialConnector;
+use App\Connectors\Data\ConnectionCandidate;
+use App\Connectors\Data\RefreshResult;
+use App\Connectors\Exceptions\ConnectorException;
+use App\Connectors\Network;
+use App\Models\SocialAccount;
+
+/**
+ * Conector de Mastodon (T-87): se conecta con la URL de la instancia y un token personal de usuario (no OAuth). El token se guarda cifrado en
+ * `access_token` (lo recifra `app:reencrypt`); no caduca, asi que no hay nada que renovar. `external_id` = `host:id` (el id de Mastodon solo es unico
+ * dentro de su instancia), `name` y `username` = handle completo (`acct@host`) y en `meta` van la instancia, el perfil, el avatar y los limites.
+ */
+class MastodonConnector implements CredentialConnector
+{
+    public const SCOPES = ['write:statuses', 'write:media', 'read:accounts'];
+
+    public function __construct(private readonly MastodonClient $client) {}
+
+    public function provider(): string
+    {
+        return 'mastodon';
+    }
+
+    public function networks(): array
+    {
+        return [Network::Mastodon];
+    }
+
+    /** El token personal no caduca: nunca hay renovacion (`token_expires_at` queda en null). */
+    public function refreshMarginHours(): int
+    {
+        return 0;
+    }
+
+    public function credentialIntro(): string
+    {
+        return 'Conecta Mastodon con un token de acceso personal con los permisos write:statuses, write:media y read:accounts. Se guarda cifrado y puedes revocarlo desde Mastodon cuando quieras.';
+    }
+
+    public function credentialFields(): array
+    {
+        return [
+            ['name' => 'instance_url', 'label' => 'Instancia de Mastodon', 'type' => 'text', 'help' => 'La dirección de tu servidor, por ejemplo mastodon.social. Debe usar https.'],
+            ['name' => 'access_token', 'label' => 'Token de acceso', 'type' => 'password', 'help' => 'Créalo en Preferencias > Desarrollo > Nueva aplicación, con los permisos write:statuses, write:media y read:accounts, y copia «Tu token de acceso».'],
+        ];
+    }
+
+    public function connectWithCredentials(array $input): array
+    {
+        $instance = trim((string) ($input['instance_url'] ?? ''));
+        $token = trim((string) ($input['access_token'] ?? ''));
+
+        if ($instance === '' || $token === '') {
+            throw new ConnectorException('Escribe la instancia de Mastodon y el token de acceso.');
+        }
+
+        try {
+            $base = $this->client->normalizeInstance($instance);
+            $profile = $this->client->verifyCredentials($base, $token);
+        } catch (MastodonException $e) {
+            // Nunca se propaga el cuerpo de la instancia ni el token: los mensajes de los fallos de red y de la direccion ya son los de esta app.
+            throw new ConnectorException(match (true) {
+                in_array($e->status, [401, 403], true) => 'Mastodon rechazó el token. Comprueba que lo has creado en esa instancia y con los permisos write:statuses, write:media y read:accounts.',
+                $e->status > 0 => 'Mastodon no pudo validar la cuenta (error '.$e->status.').',
+                default => $e->getMessage(),
+            });
+        }
+
+        $id = (string) ($profile['id'] ?? '');
+        $acct = trim((string) ($profile['acct'] ?? ''));
+        if ($id === '' || $acct === '') {
+            throw new ConnectorException('Mastodon no devolvió los datos de la cuenta.');
+        }
+
+        $host = (string) parse_url($base, PHP_URL_HOST);
+        $handle = str_contains($acct, '@') ? $acct : $acct.'@'.$host;
+
+        return [new ConnectionCandidate(
+            network: Network::Mastodon,
+            externalId: $host.':'.$id,
+            name: $handle,
+            username: $handle,
+            accessToken: $token,
+            scopes: self::SCOPES,
+            meta: array_filter([
+                'instance' => $base,
+                'account_id' => $id,
+                'acct' => $acct,
+                'avatar' => MastodonClient::safeUrl($profile['avatar'] ?? null),
+                'profile_url' => MastodonClient::safeUrl($profile['url'] ?? null, $host),
+                'limits' => $this->limits($base),
+            ], fn ($v) => $v !== null),
+        )];
+    }
+
+    public function refresh(SocialAccount $account): RefreshResult
+    {
+        return new RefreshResult((string) $account->access_token);
+    }
+
+    /** Limites de la instancia; si no se pueden leer ahora se usan los por defecto y el publicador los lee al publicar. @return array<string, mixed> */
+    private function limits(string $base): array
+    {
+        try {
+            return MastodonLimits::fromInstance($this->client->instance($base));
+        } catch (MastodonException) {
+            return [];
+        }
+    }
+}
diff --git a/app/Connectors/Mastodon/MastodonErrors.php b/app/Connectors/Mastodon/MastodonErrors.php
new file mode 100644
index 0000000..33070c4
--- /dev/null
+++ b/app/Connectors/Mastodon/MastodonErrors.php
@@ -0,0 +1,37 @@
+<?php
+
+namespace App\Connectors\Mastodon;
+
+use App\Connectors\Exceptions\PermanentPublishException;
+use App\Connectors\Exceptions\PublishException;
+use App\Connectors\Exceptions\QuotaExceededException;
+use App\Connectors\Exceptions\ReconnectRequiredException;
+use App\Connectors\Exceptions\TransientPublishException;
+
+/**
+ * Traduce los errores de la API de Mastodon a las excepciones de la cola: 401/403 -> reconectar; 429 (o las cabeceras `X-RateLimit-*`) -> cuota con
+ * espera; red y 5xx -> transitorio; 422 y el resto -> permanente con un mensaje legible. Nunca incluye el token.
+ */
+final class MastodonErrors
+{
+    public static function translate(MastodonException $e): PublishException|ReconnectRequiredException
+    {
+        if (in_array($e->status, [401, 403], true)) {
+            return new ReconnectRequiredException('Mastodon rechazó el token de la cuenta (revocado o sin permisos): vuelve a conectarla con un token con los permisos write:statuses, write:media y read:accounts.');
+        }
+
+        if ($e->status === 429) {
+            return new QuotaExceededException('Mastodon ha limitado temporalmente las peticiones de la cuenta; se reintentará.', $e->retryAt ?? now()->addMinutes(5), 'limite_temporal');
+        }
+
+        if ($e->isTransient()) {
+            return new TransientPublishException('Mastodon no respondió correctamente; se reintentará.', 'mastodon_no_disponible');
+        }
+
+        $detail = $e->detail !== '' ? ': '.$e->detail : '.';
+
+        return $e->status === 422
+            ? new PermanentPublishException('Mastodon no admite el contenido de la publicación'.$detail, 'contenido_rechazado')
+            : new PermanentPublishException('Mastodon rechazó la publicación'.$detail, 'rechazada');
+    }
+}
diff --git a/app/Connectors/Mastodon/MastodonException.php b/app/Connectors/Mastodon/MastodonException.php
new file mode 100644
index 0000000..207f1b3
--- /dev/null
+++ b/app/Connectors/Mastodon/MastodonException.php
@@ -0,0 +1,24 @@
+<?php
+
+namespace App\Connectors\Mastodon;
+
+use App\Connectors\Exceptions\ConnectorException;
+use Carbon\CarbonInterface;
+
+/**
+ * Error de la API de una instancia de Mastodon o fallo de red. `status` es el HTTP (0 = sin respuesta); `retryAt` solo llega en un 429 (cabeceras
+ * `Retry-After` o `X-RateLimit-Reset`); `detail` es el `error` que escribe la instancia, ya limpio y acotado. El mensaje nunca incluye el token.
+ */
+class MastodonException extends ConnectorException
+{
+    public function __construct(string $message, public readonly int $status = 0, public readonly ?CarbonInterface $retryAt = null, public readonly string $detail = '')
+    {
+        parent::__construct($message);
+    }
+
+    /** ¿Fallo de red o del servidor (reintentable)? */
+    public function isTransient(): bool
+    {
+        return $this->status === 0 || $this->status === 408 || $this->status >= 500;
+    }
+}
diff --git a/app/Connectors/Mastodon/MastodonLimits.php b/app/Connectors/Mastodon/MastodonLimits.php
new file mode 100644
index 0000000..57b3133
--- /dev/null
+++ b/app/Connectors/Mastodon/MastodonLimits.php
@@ -0,0 +1,112 @@
+<?php
+
+namespace App\Connectors\Mastodon;
+
+use App\Models\SocialAccount;
+use App\Support\TextLength;
+use Carbon\CarbonImmutable;
+
+/**
+ * Limites de UNA instancia de Mastodon (T-87), guardados en `meta.limits` de la cuenta al conectar (`GET /api/v2/instance`) y refrescados al publicar
+ * cuando tienen mas de `social.mastodon.limits_ttl_hours`. Sin dato se usan los valores prudentes de `social.mastodon.default_*` (500 caracteres, 4 imagenes).
+ * El compositor y `MediaValidator` leen de aqui los limites de ESA cuenta.
+ *
+ * El texto se cuenta como lo cuenta Mastodon (`TextLength::MASTODON`: grafemas, cada URL como `characters_reserved_per_url` y una mencion remota como `@usuario`):
+ * `specFor` lo fija en la regla y `forComposer` manda la reserva al compositor, que usa el espejo `textLength.js`.
+ */
+final class MastodonLimits
+{
+    /**
+     * Normaliza la respuesta de `GET /api/v2/instance`: solo los valores presentes y validos (el resto se completa con los por defecto al leerlos).
+     *
+     * @param  array<string, mixed>  $instance
+     * @return array<string, mixed>
+     */
+    public static function fromInstance(array $instance): array
+    {
+        $statuses = (array) ($instance['configuration']['statuses'] ?? []);
+        $media = (array) ($instance['configuration']['media_attachments'] ?? []);
+        $mimes = array_values(array_filter((array) ($media['supported_mime_types'] ?? []), fn ($m) => is_string($m) && preg_match('~^[a-z]+/[a-z0-9.+-]+$~i', $m) === 1));
+
+        return array_filter([
+            'max_characters' => self::positive($statuses['max_characters'] ?? null),
+            'characters_reserved_per_url' => self::positive($statuses['characters_reserved_per_url'] ?? null),
+            'max_media_attachments' => self::positive($statuses['max_media_attachments'] ?? null),
+            'supported_mime_types' => $mimes !== [] ? $mimes : null,
+            'image_size_limit' => self::positive($media['image_size_limit'] ?? null),
+            'description_limit' => self::positive($media['description_limit'] ?? null),
+            'fetched_at' => CarbonImmutable::now()->toIso8601String(),
+        ], fn ($v) => $v !== null);
+    }
+
+    /**
+     * Limites efectivos de la cuenta: los guardados sobre los por defecto.
+     *
+     * @return array{max_characters: int, characters_reserved_per_url: int, max_media_attachments: int, image_mime_types: list<string>, image_size_limit: int, description_limit: ?int}
+     */
+    public static function forAccount(SocialAccount $account): array
+    {
+        $stored = (array) ($account->meta['limits'] ?? []);
+        $mimes = array_values(array_filter((array) ($stored['supported_mime_types'] ?? config('social.mastodon.default_mime_types')), fn ($m) => is_string($m) && str_starts_with($m, 'image/')));
+
+        return [
+            'max_characters' => self::positive($stored['max_characters'] ?? null) ?? (int) config('social.mastodon.default_max_characters', 500),
+            'characters_reserved_per_url' => self::positive($stored['characters_reserved_per_url'] ?? null) ?? 23,
+            'max_media_attachments' => self::positive($stored['max_media_attachments'] ?? null) ?? (int) config('social.mastodon.default_max_media', 4),
+            'image_mime_types' => $mimes !== [] ? $mimes : (array) config('social.mastodon.default_mime_types'),
+            'image_size_limit' => self::positive($stored['image_size_limit'] ?? null) ?? (int) config('social.mastodon.default_image_bytes'),
+            'description_limit' => self::positive($stored['description_limit'] ?? null),
+        ];
+    }
+
+    /** ¿Hay que volver a leerlos? Sin fecha o con mas de `limits_ttl_hours`. */
+    public static function isStale(SocialAccount $account): bool
+    {
+        $fetched = $account->meta['limits']['fetched_at'] ?? null;
+        if (! is_string($fetched)) {
+            return true;
+        }
+
+        try {
+            return CarbonImmutable::parse($fetched)->lte(CarbonImmutable::now()->subHours(max(1, (int) config('social.mastodon.limits_ttl_hours', 24))));
+        } catch (\Throwable) {
+            return true;
+        }
+    }
+
+    /**
+     * La regla de `media_specs.mastodon_post` con los limites de la cuenta: texto, imagenes, formatos y peso.
+     *
+     * @param  array<string, mixed>  $spec
+     * @return array<string, mixed>
+     */
+    public static function specFor(array $spec, SocialAccount $account): array
+    {
+        $limits = self::forAccount($account);
+        $spec['text']['max'] = $limits['max_characters'];
+        $spec['text']['count'] = TextLength::MASTODON;
+        $spec['text']['url_length'] = $limits['characters_reserved_per_url'];
+        $spec['media']['max'] = $limits['max_media_attachments'];
+        $spec['image']['mimes'] = $limits['image_mime_types'];
+        $spec['image']['max_bytes'] = $limits['image_size_limit'];
+
+        return $spec;
+    }
+
+    /**
+     * Lo que el compositor necesita saber de la cuenta (contadores y avisos); sin secretos.
+     *
+     * @return array{max_chars: int, max_media: int, url_length: int}
+     */
+    public static function forComposer(SocialAccount $account): array
+    {
+        $limits = self::forAccount($account);
+
+        return ['max_chars' => $limits['max_characters'], 'max_media' => $limits['max_media_attachments'], 'url_length' => $limits['characters_reserved_per_url']];
+    }
+
+    private static function positive(mixed $value): ?int
+    {
+        return is_int($value) && $value > 0 ? $value : null;
+    }
+}
