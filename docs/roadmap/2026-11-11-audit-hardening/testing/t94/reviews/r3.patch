@@ -0,0 +1,185 @@
+<?php
+
+use App\Models\Brand;
+use App\Models\User;
+use App\Services\Studio\StudioBatchExport;
+use App\Services\Studio\StudioDocument;
+use App\Services\Studio\StudioRenderer;
+use App\Services\Studio\StudioService;
+use Illuminate\Support\Facades\Process;
+use Illuminate\Support\Facades\Queue;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Support\Str;
+
+beforeEach(function () {
+    Queue::fake();
+    Storage::fake('local');
+    $this->user = User::factory()->create();
+    $this->brand = Brand::factory()->for($this->user)->create();
+    $this->actingAs($this->user);
+    $this->url = '/brands/'.$this->brand->id.'/studio/designs';
+});
+
+function animatedScene(array $animation, ?array $timing = ['start' => 1, 'duration' => 3]): array
+{
+    $doc = StudioDocument::blank(320, 180);
+    $doc['schema_version'] = 2;
+    $doc['timeline'] = ['fps' => 30, 'audio_tracks' => []];
+    $element = ['id' => 'title', 'type' => 'text', 'text' => 'Hola', 'x' => 10, 'y' => 10, 'width' => 200, 'height' => 40, 'animation' => $animation];
+    if ($timing !== null) {
+        $element['timing'] = $timing;
+    }
+    $doc['pages'][0]['elements'] = [$element];
+
+    return $doc;
+}
+
+test('an animation per object persists exactly and survives a later revision', function () {
+    $animation = ['in' => ['type' => 'slide_left', 'duration' => 0.5, 'delay' => 0.25, 'easing' => 'ease_out'], 'out' => ['type' => 'fade', 'duration' => 1]];
+    $doc = animatedScene($animation);
+    $created = $this->postJson($this->url, ['name' => 'Animado', 'document' => $doc])->assertCreated()->json('design');
+    expect($created['document'])->toBe($doc);
+    $this->patchJson('/studio/designs/'.$created['id'], ['name' => 'Animado', 'document' => $doc, 'revision' => 1])
+        ->assertOk()->assertJsonPath('design.document.pages.0.elements.0.animation', $animation);
+});
+
+test('cropped phases preserve their original duration and signed anchoring delay', function (array $animation) {
+    $doc = animatedScene($animation, ['start' => 1, 'duration' => 0.5]);
+    $this->postJson($this->url, ['name' => 'Recorte', 'document' => $doc])->assertCreated()
+        ->assertJsonPath('design.document.pages.0.elements.0.animation', $animation);
+})->with([
+    'entrance in progress' => [['in' => ['type' => 'slide_left', 'duration' => 2, 'delay' => -0.75, 'clipped' => true]]],
+    'exit already finished' => [['out' => ['type' => 'zoom', 'duration' => 1, 'delay' => 2, 'clipped' => true]]],
+]);
+
+test('every animation type and easing is accepted, also on an element without its own timing window', function (string $type) {
+    foreach (['linear', 'ease_in', 'ease_out', 'ease_in_out'] as $easing) {
+        $doc = animatedScene(['in' => ['type' => $type, 'duration' => 1, 'easing' => $easing]], null);
+        $this->postJson($this->url, ['name' => "$type $easing", 'document' => $doc])->assertCreated();
+    }
+})->with(['fade', 'slide_left', 'slide_right', 'slide_up', 'slide_down', 'zoom']);
+
+test('invalid animations are rejected', function (array $animation) {
+    $this->postJson($this->url, ['name' => 'Mala', 'document' => animatedScene($animation)])->assertUnprocessable();
+})->with([
+    'unknown type' => [['in' => ['type' => 'spin', 'duration' => 1]]],
+    'unknown easing' => [['in' => ['type' => 'fade', 'duration' => 1, 'easing' => 'bounce']]],
+    'unknown phase' => [['middle' => ['type' => 'fade', 'duration' => 1]]],
+    'unknown field' => [['in' => ['type' => 'fade', 'duration' => 1, 'script' => 'x']]],
+    'empty animation' => [[]],
+    'duration too short' => [['in' => ['type' => 'fade', 'duration' => 0.01]]],
+    'duration too long' => [['in' => ['type' => 'fade', 'duration' => 11]]],
+    'negative delay' => [['in' => ['type' => 'fade', 'duration' => 1, 'delay' => -1]]],
+    'string duration' => [['in' => ['type' => 'fade', 'duration' => '1']]],
+    'missing duration' => [['in' => ['type' => 'fade']]],
+    'phase is a list' => [['in' => [['type' => 'fade', 'duration' => 1]]]],
+    'in does not fit the object life' => [['in' => ['type' => 'fade', 'duration' => 2, 'delay' => 1.5]]],
+    'in and out overlap' => [['in' => ['type' => 'fade', 'duration' => 2], 'out' => ['type' => 'zoom', 'duration' => 1.5]]],
+    'cropped flag must be true' => [['in' => ['type' => 'fade', 'duration' => 1, 'clipped' => false]]],
+    'cropped delay below the limit' => [['in' => ['type' => 'fade', 'duration' => 1, 'delay' => -11, 'clipped' => true]]],
+    'cropped phases overlap' => [['in' => ['type' => 'fade', 'duration' => 2, 'delay' => -0.25, 'clipped' => true], 'out' => ['type' => 'zoom', 'duration' => 2, 'clipped' => true]]],
+]);
+
+test('an object that lives too little cannot carry the animation, but an exact fit is valid', function () {
+    $short = animatedScene(['in' => ['type' => 'fade', 'duration' => 1]], ['start' => 0, 'duration' => 0.5]);
+    $this->postJson($this->url, ['name' => 'Corto', 'document' => $short])->assertUnprocessable();
+    $exact = animatedScene(['in' => ['type' => 'fade', 'duration' => 1, 'delay' => 1], 'out' => ['type' => 'fade', 'duration' => 1]], ['start' => 0, 'duration' => 3]);
+    $this->postJson($this->url, ['name' => 'Justo', 'document' => $exact])->assertCreated();
+});
+
+test('animations also validate inside groups and v1 documents keep rejecting them', function () {
+    $doc = animatedScene(['in' => ['type' => 'fade', 'duration' => 1]]);
+    $child = $doc['pages'][0]['elements'][0];
+    $doc['pages'][0]['elements'] = [['id' => 'box', 'type' => 'group', 'x' => 0, 'y' => 0, 'width' => 300, 'height' => 100, 'elements' => [$child]]];
+    $this->postJson($this->url, ['name' => 'Grupo', 'document' => $doc])->assertCreated();
+    $doc['pages'][0]['elements'][0]['elements'][0]['animation']['in']['duration'] = 99;
+    $this->postJson($this->url, ['name' => 'Grupo malo', 'document' => $doc])->assertUnprocessable();
+    $v1 = animatedScene(['in' => ['type' => 'fade', 'duration' => 1]]);
+    unset($v1['timeline'], $v1['pages'][0]['elements'][0]['timing']);
+    $v1['schema_version'] = 1;
+    $this->postJson($this->url, ['name' => 'v1', 'document' => $v1])->assertUnprocessable();
+});
+
+test('a design without animations is stored exactly as before', function () {
+    $doc = animatedScene(['in' => ['type' => 'fade', 'duration' => 1]]);
+    unset($doc['pages'][0]['elements'][0]['animation']);
+    $created = $this->postJson($this->url, ['name' => 'Sin animar', 'document' => $doc])->assertCreated()->json('design');
+    expect($created['document'])->toBe($doc)->and(json_encode($created['document']))->not->toContain('animation');
+});
+
+test('server rendering of a frame at a chosen instant receives the animated document untouched', function () {
+    $doc = animatedScene(['in' => ['type' => 'zoom', 'duration' => 0.5], 'out' => ['type' => 'slide_right', 'duration' => 0.5]]);
+    $design = app(StudioService::class)->create($this->user, $this->brand, ['name' => 'Render', 'document' => $doc]);
+    $export = app(StudioRenderer::class)->export($this->user, $design, ['revision' => 1, 'format' => 'png', 'pages' => ['page_1'], 'frame_times' => [['page_id' => 'page_1', 'time' => 1.25]]]);
+    Process::fake(function ($process) use ($doc) {
+        $sent = json_decode($process->input, true);
+        expect($sent['document']['pages'][0]['elements'][0]['animation'])->toBe($doc['pages'][0]['elements'][0]['animation']);
+        $image = imagecreatetruecolor(320, 180);
+        imagepng($image, $process->command[2].DIRECTORY_SEPARATOR.'page-001.png');
+        imagedestroy($image);
+
+        return Process::result(output: '{"files":[{"name":"page-001.png","mime":"image/png"}]}');
+    });
+    app(StudioRenderer::class)->render($export->id);
+    expect($export->refresh()->status)->toBe('ready', $export->error ?? '');
+});
+
+/** Renderer falso que anota lo que recibe Chromium y devuelve una imagen del tamaño del documento. */
+function fakeAnimationRenderer(array &$inputs): void
+{
+    Process::fake(function ($process) use (&$inputs) {
+        $input = json_decode($process->input, true);
+        $inputs[] = $input;
+        $extension = $input['format'] === 'jpeg' ? 'jpg' : 'png';
+        $image = imagecreatetruecolor((int) round($input['document']['width'] * ($input['scale'] ?? 1)), (int) round($input['document']['height'] * ($input['scale'] ?? 1)));
+        $target = $process->command[2].DIRECTORY_SEPARATOR.'page-001.'.$extension;
+        $extension === 'jpg' ? imagejpeg($image, $target, 90) : imagepng($image, $target);
+
+        return Process::result(output: json_encode(['files' => [['name' => 'page-001.'.$extension, 'mime' => $extension === 'jpg' ? 'image/jpeg' : 'image/png']]]));
+    });
+}
+
+test('static outputs without an explicit instant reach the renderer with no frame time, so animations render settled', function () {
+    $doc = animatedScene(['in' => ['type' => 'fade', 'duration' => 1]]);
+    $design = app(StudioService::class)->create($this->user, $this->brand, ['name' => 'Reposo', 'document' => $doc]);
+    $inputs = [];
+    fakeAnimationRenderer($inputs);
+
+    // Miniatura del listado.
+    app(StudioRenderer::class)->previewPage($this->user, $this->brand, $doc, 'page_1', 200, 'studio-exports/'.$this->user->id.'/'.$design->id.'/'.Str::uuid());
+    // Imagen nativa y PPTX sin frame_times.
+    foreach (['png', 'pptx'] as $format) {
+        $export = app(StudioRenderer::class)->export($this->user, $design, ['revision' => 1, 'format' => $format, 'pages' => ['page_1']]);
+        app(StudioRenderer::class)->render($export->id);
+    }
+    // Exportación en lote.
+    $batch = app(StudioBatchExport::class)->start($this->user, $design, ['revision' => 1, 'pages' => ['page_1'], 'format' => 'png', 'mode' => 'cover', 'formats' => [['width' => 160, 'height' => 90]]]);
+    app(StudioRenderer::class)->render($batch['exports'][0]['id']);
+
+    expect($inputs)->toHaveCount(4);
+    foreach ($inputs as $input) {
+        expect($input['frame_times'] ?? [])->toBe([])
+            ->and(json_encode($input['document']))->toContain('"animation"');
+    }
+});
+
+test('an explicit instant is forwarded so that frame shows the animation in progress', function () {
+    $doc = animatedScene(['in' => ['type' => 'fade', 'duration' => 1]]);
+    $design = app(StudioService::class)->create($this->user, $this->brand, ['name' => 'Instante', 'document' => $doc]);
+    $inputs = [];
+    fakeAnimationRenderer($inputs);
+    $times = [['page_id' => 'page_1', 'time' => 1.5]];
+    $export = app(StudioRenderer::class)->export($this->user, $design, ['revision' => 1, 'format' => 'png', 'pages' => ['page_1'], 'frame_times' => $times]);
+    app(StudioRenderer::class)->render($export->id);
+
+    expect($inputs[0]['frame_times'])->toBe($times);
+});
+
+test('only the owner can store or edit a design with animations', function () {
+    $doc = animatedScene(['in' => ['type' => 'fade', 'duration' => 1]]);
+    $design = $this->postJson($this->url, ['name' => 'Mío', 'document' => $doc])->assertCreated()->json('design');
+    $intruder = User::factory()->create();
+    $this->actingAs($intruder);
+    $this->patchJson('/studio/designs/'.$design['id'], ['name' => 'Robado', 'document' => $doc, 'revision' => 1])->assertNotFound();
+    $this->postJson($this->url, ['name' => 'Ajena', 'document' => $doc])->assertNotFound();
+});
diff --git a/tests/e2e/studio-object-animation.spec.ts b/tests/e2e/studio-object-animation.spec.ts
new file mode 100644
index 0000000..29588eb
--- /dev/null
+++ b/tests/e2e/studio-object-animation.spec.ts
@@ -0,0 +1,78 @@
+import { expect, test } from '@playwright/test';
+import { cleanComposerBrands, e2eUser, expectNoOverflow, loginAs, seedComposerBrand, stamp } from './helpers';
+
+const near = (pixel: number[], expected: number[], tolerance = 12) => pixel.every((value, i) => Math.abs(value - expected[i]) <= tolerance);
+
+test('Studio object animation: animate an object, see it in two instants of the preview and export the frame that matches', { tag: '@responsive' }, async ({ page }, info) => {
+    const user = e2eUser(info.project.name), errors: string[] = [];
+    cleanComposerBrands(user.email);
+    const brand = seedComposerBrand(user.email, `studio-animation-${stamp()}-${info.project.name}`);
+    page.on('pageerror', error => errors.push(error.message));
+    page.on('console', message => { if (message.type() === 'error') errors.push(message.text()); });
+    try {
+        await loginAs(page, user); await page.goto(`/studio?brand_id=${brand.id}`);
+        const design = await page.evaluate(async brandId => {
+            const csrf = decodeURIComponent((document.cookie.match(/(?:^|; )XSRF-TOKEN=([^;]+)/) ?? [])[1] ?? '');
+            const response = await fetch(`/brands/${brandId}/studio/designs`, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-XSRF-TOKEN': csrf },
+                body: JSON.stringify({ name: 'Animado', document: { schema_version: 2, width: 100, height: 100, timeline: { fps: 30, audio_tracks: [] }, pages: [
+                    { id: 'one', name: 'Una', duration: 4, background: '#ffffff', elements: [{ id: 'red', type: 'rect', name: 'Cuadro rojo', x: 0, y: 0, width: 100, height: 100, fill: '#ff0000' }] },
+                ] } }) });
+            if (!response.ok) throw new Error(await response.text());
+            return (await response.json()).design;
+        }, brand.id);
+        await page.goto(`/studio/designs/${design.id}/edit`);
+        const timeline = page.getByRole('region', { name: 'Línea de tiempo', exact: true });
+        await expect(timeline).toBeVisible();
+        await page.screenshot({ path: info.outputPath('object-animation-initial.png'), fullPage: true });
+        await timeline.getByRole('button', { name: 'Seleccionar clip Cuadro rojo', exact: true }).click();
+        // Sin animación declarada, el objeto sigue como antes.
+        await expect(timeline.getByTestId('timeline-animation-in')).toHaveCount(0);
+        await timeline.getByLabel('Entrada', { exact: true }).selectOption('fade');
+        const duration = timeline.getByLabel('Duración de la entrada (s)', { exact: true });
+        await duration.fill('1'); await duration.press('Tab');
+        await timeline.getByLabel('Curva de la entrada', { exact: true }).selectOption({ label: 'Lineal' });
+        await expect(timeline.getByTestId('timeline-animation-in')).toHaveCount(1);
+        await page.getByRole('button', { name: 'Guardar ahora', exact: true }).click();
+        await expect(page.getByTestId('studio-save-status')).toHaveText('Guardado');
+        const stored = await page.evaluate(async id => (await (await fetch(`/studio/designs/${id}`, { headers: { Accept: 'application/json' } })).json()).design.document, design.id);
+        expect(stored.pages[0].elements[0].animation).toEqual({ in: { type: 'fade', duration: 1, easing: 'linear' } });
+
+        const clock = timeline.getByLabel('Tiempo de reproducción', { exact: true });
+        const preview = page.getByLabel('Previsualización de la línea de tiempo', { exact: true });
+        const pixel = () => preview.evaluate(canvas => [...(canvas as HTMLCanvasElement).getContext('2d')!.getImageData(50, 50, 1, 1).data]);
+        // El reloj parte de 0: el primer instante debe cambiar para que se genere la previsualización.
+        const instants = [[2, [255, 0, 0, 255]], [0.5, [255, 128, 128, 255]], [0, [255, 255, 255, 255]]] as const;
+        for (const [second, expected] of instants) {
+            await clock.fill(String(second)); await clock.press('Tab');
+            await expect.poll(async () => near(await pixel(), [...expected]), { message: `previsualización en ${second} s` }).toBe(true);
+        }
+        await page.screenshot({ path: info.outputPath('object-animation-preview.png'), fullPage: true });
+
+        // El fotograma exportado en el instante elegido coincide con la previsualización.
+        await clock.fill('0.5'); await clock.press('Tab');
+        await page.getByRole('button', { name: 'Exportar', exact: true }).click();
+        const dialog = page.getByRole('dialog', { name: 'Exportar diseño', exact: true });
+        const time = dialog.getByLabel('Fotograma de Una (s)', { exact: true });
+        await expect(time).toHaveValue('0.5');
+        for (const [second, expected] of [[0.5, [255, 128, 128, 255]], [2, [255, 0, 0, 255]]] as const) {
+            await time.fill(String(second));
+            const registration = page.waitForResponse(response => response.url().endsWith(`/studio/designs/${design.id}/exports`) && response.request().method() === 'POST');
+            await dialog.getByRole('button', { name: 'Guardar en biblioteca', exact: true }).click();
+            const response = await registration; expect(response.status()).toBe(201);
+            const result = (await response.json()).export;
+            const exported = await page.evaluate(async ({ brandId, mediaId }) => {
+                const data = await (await fetch(`/brands/${brandId}/studio/assets`, { headers: { Accept: 'application/json' } })).json();
+                const asset = data.assets.find((asset: { id: number }) => asset.id === mediaId);
+                const bitmap = await createImageBitmap(await (await fetch(asset.preview_url)).blob());
+                try { const canvas = document.createElement('canvas'); canvas.width = canvas.height = 100; const context = canvas.getContext('2d')!;
+                    context.drawImage(bitmap, 0, 0); return [...context.getImageData(50, 50, 1, 1).data]; }
+                finally { bitmap.close(); }
+            }, { brandId: brand.id, mediaId: result.media_ids[0] });
+            expect(near(exported, [...expected]), `fotograma exportado en ${second} s: ${exported}`).toBe(true);
+            await expect(dialog.getByRole('status')).toContainText('biblioteca');
+            await page.screenshot({ path: info.outputPath(`object-animation-exported-${second}s.png`), fullPage: true });
+        }
+        await dialog.getByRole('button', { name: 'Cerrar exportación', exact: true }).click();
+        await expectNoOverflow(page); expect(errors).toEqual([]);
+    } finally { cleanComposerBrands(user.email); }
+});
diff --git a/tests/frontend/studio-object-animation-flows.test.mjs b/tests/frontend/studio-object-animation-flows.test.mjs
new file mode 100644
index 0000000..7d63d3f
--- /dev/null
+++ b/tests/frontend/studio-object-animation-flows.test.mjs
@@ -0,0 +1,211 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { parse } from '@babel/parser';
+import { animationState, normalizeAnimation } from '../../resources/js/Studio/object-animation.js';
+import { applyElementAnimation } from '../../resources/js/Studio/animation-scene.js';
+import { blankDocument, newElement, validateDocument } from '../../resources/js/Studio/document.js';
+import { clipMediaState, compileTimeline, restrictElementWindow, sampleTimeline, splitTimelineElement } from '../../resources/js/Studio/timeline.js';
+
+const near = (actual, expected, message) => assert.ok(Math.abs(actual - expected) < 1e-9, `${message ?? ''} ${actual} != ${expected}`);
+const window = { start: 1, duration: 4 };
+
+function scene(animation, timing = window) {
+    const doc = blankDocument(320, 180);
+    doc.schema_version = 2;
+    doc.timeline = { fps: 30, audio_tracks: [] };
+    doc.pages[0].duration = 6;
+    doc.pages[0].elements = [newElement('text', { id: 'title', text: 'Hola', ...(timing ? { timing } : {}), ...(animation ? { animation } : {}) })];
+    return doc;
+}
+
+function fakeObject() {
+    return {
+        left: 10, top: 20, scaleX: 2, scaleY: 2, opacity: 0.8, dirty: false,
+        getRelativeCenterPoint() { return { x: this.left + 50, y: this.top + 25 }; },
+        set(values) { Object.assign(this, values); },
+        setPositionByOrigin(point) { this.left = point.x - 50; this.top = point.y - 25; },
+        setCoords() {},
+    };
+}
+
+test('settled state is the identity: designed look with entrances completed and exits not started', () => {
+    const animation = { in: { type: 'zoom', duration: 1 }, out: { type: 'slide_left', duration: 1 } };
+    for (const time of [1, 1.5, 4.5]) assert.deepEqual(animationState(animation, time, window, { settled: true }), { opacity: 1, offsetX: 0, offsetY: 0, scale: 1 });
+    assert.notDeepEqual(animationState(animation, 1, window), animationState(animation, 1, window, { settled: true }));
+});
+
+test('settled applications leave the object untouched even with an animation', () => {
+    const object = fakeObject(), before = JSON.stringify(object);
+    applyElementAnimation(object, { timing: window, animation: { in: { type: 'fade', duration: 1 } } }, 1, { width: 320, height: 180, pageDuration: 6, settled: true });
+    assert.equal(JSON.stringify(object), before);
+});
+
+test('a child inside a group animates over the window shared with the group and hands that window on', () => {
+    const size = { width: 320, height: 180, pageDuration: 6 };
+    const groupWindow = applyElementAnimation(fakeObject(), { timing: { start: 1, duration: 3 } }, 2, size);
+    assert.deepEqual(groupWindow, { start: 1, duration: 3 });
+    const child = { timing: { start: 0, duration: 6 }, animation: { in: { type: 'fade', duration: 1, easing: 'linear' } } };
+    const object = fakeObject();
+    assert.deepEqual(applyElementAnimation(object, child, 1.5, { ...size, parent: groupWindow }), { start: 1, duration: 3 });
+    near(object.opacity, 0.8 * 0.5, 'la entrada del hijo parte del inicio común, no del suyo');
+});
+
+test('ungrouping keeps a group entrance and a child exit when their envelopes fit', () => {
+    const child = scene({ out: { type: 'zoom', duration: 0.5 } }).pages[0].elements[0];
+    const parentAnimation = { in: { type: 'fade', duration: 1.5 }, out: { type: 'slide_left', duration: 1 } };
+    const result = restrictElementWindow(child, { start: 0, duration: 6 }, { pageDuration: 6, parentAnimation });
+    assert.deepEqual(result.animation, { in: { type: 'fade', duration: 1.5, delay: -1, clipped: true }, out: { type: 'zoom', duration: 0.5 } });
+});
+
+test('ungrouping reports a group phase that cannot be combined with the child phase', () => {
+    const animation = { in: { type: 'fade', duration: 1 } };
+    const child = scene(animation, { start: 0, duration: 4 }).pages[0].elements[0];
+    const parentAnimation = { in: { type: 'slide_left', duration: 0.5 } };
+    let losses = 0;
+    const result = restrictElementWindow(child, { start: 0, duration: 4 }, {
+        pageDuration: 6, parentAnimation, onAnimationLoss: () => losses++,
+    });
+    assert.equal(losses, 1);
+    assert.deepEqual(result.animation, animation);
+});
+
+test('ungrouping preserves a group zoom for a centered child and reports the approximation otherwise', () => {
+    const child = scene(null, { start: 0, duration: 4 }).pages[0].elements[0];
+    const parentAnimation = { in: { type: 'zoom', duration: 1 } };
+    const parentWindow = { start: 0, duration: 4 };
+    let losses = 0;
+    const options = { pageDuration: 6, parentAnimation, onAnimationLoss: () => losses++ };
+    const centered = restrictElementWindow(child, parentWindow, { ...options, centered: true });
+    assert.deepEqual(centered.animation, parentAnimation);
+    assert.equal(losses, 0);
+    const offCenter = restrictElementWindow(child, parentWindow, options);
+    assert.deepEqual(offCenter.animation, { in: { type: 'fade', duration: 1 } });
+    assert.equal(losses, 1);
+});
+
+test('cropped phases use the same validation as the server', () => {
+    const entrance = { type: 'slide_left', duration: 2, delay: -0.75, clipped: true };
+    const exit = { type: 'zoom', duration: 1, delay: 2, clipped: true };
+    assert.deepEqual(normalizeAnimation({ in: entrance }, 0.5), { in: entrance });
+    assert.deepEqual(normalizeAnimation({ out: exit }, 0.5), { out: exit });
+    for (const animation of [
+        { in: { ...entrance, clipped: false } },
+        { in: { ...entrance, delay: -11 } },
+        { in: entrance, out: exit },
+    ]) assert.throws(() => normalizeAnimation(animation, 0.5));
+});
+
+for (const [name, animation, cut] of [
+    ['completed exit', { out: { type: 'fade', duration: 1, delay: 2 } }, 3],
+    ['delayed entrance', { in: { type: 'fade', duration: 1, delay: 2 } }, 1],
+    ['eased slide in progress', { in: { type: 'slide_left', duration: 2, delay: 0.5, easing: 'ease_in' } }, 1],
+    ['eased zoom in progress', { out: { type: 'zoom', duration: 2, delay: 0.5, easing: 'ease_out' } }, 3],
+    ['entrance with less than 0.1 s before the cut', { in: { type: 'fade', duration: 1, delay: 0.95 } }, 1],
+]) {
+    test(`splitting preserves each frame of a ${name}`, () => {
+        const timing = { start: 0, duration: 4 };
+        const doc = scene(animation, timing);
+        const result = splitTimelineElement(doc, doc.pages[0].id, 'title', cut, { createId: () => 'second_half' });
+        for (const half of result.pages[0].elements) {
+            for (let frame = 0; frame <= 60; frame++) {
+                const time = half.timing.start + half.timing.duration * frame / 60;
+                const expected = animationState(animation, time, timing);
+                const actual = animationState(half.animation, time, half.timing);
+                for (const key of Object.keys(expected)) near(actual[key], expected[key], `${key} at ${time}`);
+            }
+        }
+    });
+}
+
+test('splitting a group keeps a timed child on its original curve', () => {
+    const animation = { in: { type: 'zoom', duration: 2 } };
+    const doc = scene(animation, { start: 0, duration: 4 });
+    doc.pages[0].elements = [newElement('group', { id: 'group', timing: { start: 1, duration: 3 }, elements: doc.pages[0].elements })];
+    let id = 0;
+    const result = splitTimelineElement(doc, doc.pages[0].id, 'group', 2, { createId: () => `split_${++id}` });
+    for (const [index, time] of [1.5, 2.5].entries()) {
+        const group = result.pages[0].elements[index];
+        const object = fakeObject();
+        applyElementAnimation(object, group.elements[0], time, { width: 320, height: 180, pageDuration: 6, parent: group.timing });
+        const expected = animationState(animation, time, { start: 1, duration: 3 });
+        near(object.opacity, 0.8 * expected.opacity);
+        near(object.scaleX, 2 * expected.scale);
+    }
+});
+
+test('ungrouping does not replay a completed group entrance on a late child', () => {
+    const child = scene(null, { start: 2, duration: 2 }).pages[0].elements[0];
+    const parentAnimation = { in: { type: 'fade', duration: 0.5 } };
+    const result = restrictElementWindow(child, { start: 0, duration: 4 }, { pageDuration: 6, parentAnimation });
+    assert.equal(animationState(result.animation, 2.1, result.timing).opacity, 1);
+});
+
+test('a short clip can be animated: the default duration is whatever fits, never below 0.1 s', async () => {
+    const { ref } = await import('vue');
+    const { useTimelineEditing } = await import('../../resources/js/Studio/composables/useTimelineEditing.js');
+    const doc = scene(null, { start: 1, duration: 0.3 });
+    const documentData = ref(doc), page = ref(doc.pages[0]);
+    const editing = useTimelineEditing({
+        documentData, page, pageId: ref(doc.pages[0].id), selection: ref([{ id: 'title' }]), localAssets: ref([]),
+        timeline: ref(0), timelineDuration: ref(6), timelinePageStart: ref(0), timelineOpen: ref(true), pauseTimeline() {}, error: ref(''),
+        run: fn => fn(), commit() {}, reloadCanvas: async () => {}, selectOnCanvas() {}, isCaptionBlocked: () => false,
+    });
+    await editing.patchClipAnimation({ phase: 'in', patch: { type: 'zoom' } });
+    assert.equal(documentData.value.pages[0].elements[0].animation.in.duration, 0.3);
+});
+
+const loadBody = async relative => (await readFile(new URL('../../' + relative, import.meta.url), 'utf8')).replace(/^import .*;\r?\n/gm, '')
+    .replaceAll('export async function', 'async function').replaceAll('export function', 'function').replaceAll('export const', 'const');
+const AsyncFunction = Object.getPrototypeOf(async function () {}).constructor;
+
+test('static frames render animations settled unless the page has an explicit instant', async () => {
+    const body = await loadBody('resources/js/Studio/exports.js');
+    const calls = [];
+    const rendered = { canvas: { backgroundColor: '', renderAll() {}, toSVG: () => '<svg/>', getObjects: () => [], getZoom: () => 1 }, fontFaces: () => [], async dispose() {} };
+    const factory = new AsyncFunction('validateDocument', 'frameTimes', 'renderStudioFrame', 'StudioDocumentError', body + ';return exportPage;');
+    const exportPage = await factory(x => x, () => new Map([['p', 0]]), async (...args) => { calls.push(args[5].settled); return rendered; }, Error);
+    const design = { width: 100, height: 100, pages: [] };
+    await exportPage(design, 'p', [], { format: 'svg' });
+    await exportPage(design, 'p', [], { format: 'svg', frame_times: [{ page_id: 'p', time: 0 }] });
+    await exportPage(design, 'p', [], { format: 'svg', frame_times: [{ page_id: 'other', time: 0 }] });
+    assert.deepEqual(calls, [true, false, true]);
+});
+
+test('renderStudioFrame applies animations at its instant, none when settled, and never forwards the flag to the page renderer', async () => {
+    const body = await loadBody('resources/js/Studio/frame-renderer.js');
+    const applied = [];
+    let received;
+    const rendered = { canvas: { getObjects: () => [{ id: 1 }], renderAll() {} }, async dispose() {} };
+    const run = new AsyncFunction('renderStudioPage', 'frameElements', 'compileTimeline', 'attachFrameCaptions', 'applyElementAnimation', body + ';return renderStudioFrame;');
+    const frame = await run(async (...args) => { received = args; return rendered; }, x => x, () => ({ pages: [{ id: 'p', start: 0 }] }), async s => s,
+        (_object, _layer, time, options) => { applied.push([time, options.settled]); });
+    const doc = { schema_version: 2, width: 100, height: 100, timeline: { fps: 30 }, pages: [{ id: 'p', duration: 4, elements: [{ id: 'a', type: 'rect', animation: { in: { type: 'fade', duration: 1 } } }] }] };
+    await frame(doc, 'p', 0.5, [], [], {});
+    await frame(doc, 'p', 0.5, [], [], { settled: true });
+    assert.deepEqual(applied, [[0.5, false], [0.5, true]]);
+    assert.equal(Object.hasOwn(received[4], 'settled'), false);
+});
+
+test('the offline project render (MP4/GIF) applies the animation of each object at every sampled instant', async () => {
+    const source = await readFile(new URL('../../resources/js/Studio/timeline-preview.js', import.meta.url), 'utf8');
+    const factory = parse(source, { sourceType: 'module' }).program.body.find(node => node.type === 'ExportNamedDeclaration' && node.declaration?.id?.name === 'createTimelinePreview').declaration;
+    const instantiate = Function('validateDocument', 'renderStudioPage', 'seekVideoFrame', 'videoFrameReady', 'clipMediaState', 'compileTimeline', 'sampleTimeline',
+        'createTimelineAudio', 'createCaptionLayer', 'assertChartDocumentBudget', 'applyElementAnimation', `return (${source.slice(factory.start, factory.end)});`);
+    const doc = scene({ in: { type: 'fade', duration: 1, easing: 'linear' } });
+    const object = fakeObject();
+    const seen = [];
+    const create = instantiate(validateDocument, async () => ({ canvas: { getObjects: () => [object], renderAll() {}, lowerCanvasEl: {} }, async dispose() {} }),
+        async () => {}, async () => {}, clipMediaState, compileTimeline, sampleTimeline,
+        () => ({ prepare: async () => ({ bufferingMs: 0 }), pause() {}, pauseMedia() {}, play: async () => {}, state: () => [], dispose: async () => {} }),
+        async () => null, async () => {},
+        (target, element, time, options) => { const result = applyElementAnimation(target, element, time, options); seen.push([time, target.opacity]); return result; });
+    const context = { clearRect() {}, save() {}, restore() {}, drawImage() {}, fillRect() {} };
+    const preview = await create({ getContext: () => context }, { document: doc, offline: true });
+    await preview.seek(1.5);
+    await preview.seek(3);
+    await preview.dispose();
+    assert.equal(seen.length, 2);
+    near(seen[0][0], 1.5); near(seen[0][1], 0.8 * 0.5, 'a mitad de la entrada');
+    near(seen[1][0], 3); near(seen[1][1], 0.8, 'tras la entrada');
+});
diff --git a/tests/frontend/studio-object-animation.test.mjs b/tests/frontend/studio-object-animation.test.mjs
