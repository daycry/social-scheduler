APP_NAME="Social Scheduler"
APP_ENV=production
APP_KEY=
# Si algun dia rotas APP_KEY, pon aqui la anterior (varias separadas por comas): los secretos del doble factor
# (TOTP) estan cifrados con APP_KEY y sin esto dejarian de descifrarse. Vacio mientras no rotes.
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://social-scheduler.daycry.ovh

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# MariaDB >= 10.6 / MySQL >= 8.0 (SKIP LOCKED para la cola database)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CAMBIAR_usuario_scheduler
DB_USERNAME=CAMBIAR_usuario_scheduler
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
# Rate limiter en fichero: el throttle de /health no depende de la BD
CACHE_LIMITER_STORE=file
QUEUE_CONNECTION=database
QUEUE_NAMES=publish,poll,metrics,reports,media,studio

# Correo (decision abierta: SMTP de Hestia o proveedor transaccional)
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@CAMBIAR-DOMINIO"
MAIL_FROM_NAME="${APP_NAME}"

# Media. Por defecto en el disco LOCAL del servidor (storage/app/private): las redes la descargan por URL firmada
# y temporal de la app (/storage/...). Nunca MEDIA_DISK=public (dejaria toda la media accesible sin caducidad).
# Con disco local no hay fotos de TikTok (PULL_FROM_URL): deja TIKTOK_VERIFIED_DOMAIN vacio.
# Para Cloudflare R2: MEDIA_DISK=r2 y rellenar R2_* (subida directa del navegador al bucket).
MEDIA_DISK=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://CAMBIAR-ACCOUNT-ID.r2.cloudflarestorage.com
R2_URL=https://media.CAMBIAR-DOMINIO
R2_REGION=auto
# Timeouts HTTP del disco R2 (segundos): evitan que un R2 degradado cuelgue workers y /health
R2_CONNECT_TIMEOUT=3
R2_TIMEOUT=5

# Healthcheck externo: token requerido en /health (cabecera X-Health-Token). Generar con: openssl rand -hex 32
HEALTHCHECK_TOKEN=
# Salud (A-09): umbrales de `app:health` y aviso por correo cuando un job agota sus reintentos (vacio = sin aviso; maximo un correo por intervalo).
HEALTH_QUEUE_MAX_AGE=600
HEALTH_QUEUE_MAX_AGE_NATIVE=1800
HEALTH_SNAPSHOTS_MAX_AGE_HOURS=36
HEALTH_NATIVE=true
HEALTH_NATIVE_CACHE_SECONDS=300
HEALTH_ALERT_EMAIL=
HEALTH_ALERT_THROTTLE_MINUTES=60

# OAuth por red (Fase 2)
META_APP_ID=
META_APP_SECRET=
# Permisos extra de Meta (activarlos antes en la app de Meta): comentarios de páginas y anuncios.
META_EXTRA_SCOPES=pages_read_user_content,ads_read
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Picker (media desde Drive, C-04b): clave Y app id (numero de proyecto) son obligatorios; si falta cualquiera, el boton «Google Drive» no aparece. Ver docs/guias/google-cloud-picker-drive.md
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Bluesky (app password cifrada, sin app de terceros). BLUESKY_ENABLED=false la retira. Guia: docs/guias/bluesky-app-password.md
BLUESKY_ENABLED=true
BLUESKY_IMAGE_MAX_BYTES=2000000
BLUESKY_VIDEO_MAX_BYTES=52428800
BLUESKY_UPLOAD_TIMEOUT=80
SOCIAL_REFRESH_MARGIN_BLUESKY_HOURS=1
# Threads: ID y secreto DE THREADS de la app de Meta (Configuracion > Basica; distintos de META_APP_ID). Sin THREADS_APP_ID la red no se ofrece.
# Redirect URI a registrar: https://social-scheduler.daycry.ovh/connections/threads/callback. Guia: docs/guias/threads-app-meta.md
THREADS_ENABLED=true
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_TOKEN_HEADER=false
SOCIAL_REFRESH_MARGIN_THREADS_HOURS=168
SOCIAL_REFRESH_MARGIN_LINKEDIN_HOURS=168
SOCIAL_REFRESH_MARGIN_PINTEREST_HOURS=72
# LinkedIn (T-18): app de LinkedIn Developers con «Share on LinkedIn» (w_member_social). Redirect URI: https://social-scheduler.daycry.ovh/connections/linkedin/callback.
# LINKEDIN_COMMUNITY_MANAGEMENT=true pide los scopes de paginas (solo con la Community Management API aprobada por LinkedIn).
# LINKEDIN_R_MEMBER_SOCIAL=true pide r_member_social (solo apps aprobadas). Sin LINKEDIN_CLIENT_ID la red no se ofrece.
LINKEDIN_ENABLED=true
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_COMMUNITY_MANAGEMENT=false
LINKEDIN_R_MEMBER_SOCIAL=false
# Pinterest (T-18): app de Pinterest Developers (API v5; acceso de prueba hasta que Pinterest la aprueba). Redirect URI: https://social-scheduler.daycry.ovh/connections/pinterest/callback.
PINTEREST_ENABLED=true
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Canva (T-16): Canva Developers. Redirect URL: https://social-scheduler.daycry.ovh/canva/callback; Return URL: https://social-scheduler.daycry.ovh/canva/return. Vacias = «no configurada».
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# IA del estudio (T-14): cada proveedor solo se ofrece si tiene clave. STUDIO_AI_*_KEY manda sobre OPENAI_API_KEY / GEMINI_API_KEY.
OPENAI_API_KEY=
GEMINI_API_KEY=
STUDIO_AI_OPENAI_KEY=
STUDIO_AI_GOOGLE_KEY=
STUDIO_AI_OPENAI_MODEL=gpt-image-2.5-sunburst
STUDIO_AI_GOOGLE_MODEL=gemini-nano-banana-2.1
STUDIO_AI_OPENAI_QUALITY=medium
STUDIO_AI_OPENAI_DAILY_LIMIT=20
STUDIO_AI_GOOGLE_DAILY_LIMIT=20
STUDIO_AI_BUDGET=100
STUDIO_AI_TIMEOUT=90
# Disco de las tipografias privadas del estudio.
STUDIO_FONT_DISK=local
# Retencion (A-08): dias que se conservan las tablas que poda `model:prune` (diario). 0 = no podar esa tabla.
RETENTION_AUDIT_LOGS_DAYS=365
RETENTION_PUBLISH_ATTEMPTS_DAYS=365
RETENTION_NOTIFICATIONS_DAYS=90
RETENTION_STUDIO_AI_JOBS_DAYS=90
RETENTION_STUDIO_IMAGE_JOBS_DAYS=30
RETENTION_CANVA_JOBS_DAYS=90
RETENTION_STUDIO_EXPORTS_DAYS=30
RETENTION_STUDIO_AV_STEPS_DAYS=14
# Revisiones del estudio: ultimas N por diseño, ultima de cada dia hasta X dias, e intervalo minimo (s) del autoguardado.
RETENTION_REVISIONS_KEEP_LAST=50
RETENTION_REVISIONS_DAILY_DAYS=90
STUDIO_REVISION_MIN_INTERVAL=300
# Giphy (buscador de GIFs): vacia = sin boton «GIF». Se muestra «Powered by GIPHY». Guia: docs/guias/giphy-api-key.md
GIPHY_API_KEY=
SOCIAL_GIPHY_HOURLY_LIMIT=90
# Binarios de video/imagen (ffprobe obligatorio; ffmpeg recomendado para recomprimir fotos de Bluesky). Deben estar en el PATH de PHP-FPM y de los workers.
FFPROBE_BINARY=ffprobe
FFMPEG_BINARY=ffmpeg

# Registro público cerrado: uso personal, las cuentas se crean por consola.
REGISTRATION_ENABLED=false

# --- Passkeys (WebAuthn) ---
# RP ID = dominio de produccion SIN subdominio de mas, sin esquema ni puerto; estable (si cambia se pierden todas las passkeys).
WEBAUTHN_RP_ID=social-scheduler.daycry.ovh
WEBAUTHN_ORIGINS=https://social-scheduler.daycry.ovh
# Recomendado y propio (php -r "echo bin2hex(random_bytes(32));"): si esta vacio cae en APP_KEY y la app avisa en el log y en `php artisan about`.
# Rotarlo (o rotar APP_KEY) NO invalida las passkeys ya registradas (el handle se guarda en su registro); solo cambia el de las nuevas.
PASSKEYS_USER_HANDLE_SECRET=

# --- Proxies de confianza ---
# Cloudflare delante: sus rangos (https://www.cloudflare.com/ips-v4 y ips-v6) separados por comas; nunca '*'. Sin nada delante: vacío.
TRUSTED_PROXIES=
